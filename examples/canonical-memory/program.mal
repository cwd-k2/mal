require "./host.c";

Sample :: (Int64, UInt8);
Storage :: (Address, USize);

// The returned address is deliberately unaligned and remains valid for the process lifetime.
extern sampleStorage :: Unit -> Storage;
// The host must use canonical-memory helpers because neither alignment nor C struct layout applies.
extern incrementSample :: (Address, USize) -> Unit;

main :: Unit -> Int32 := () -> [return] => {
    (address, capacity) := sampleStorage();
    when (capacity < 2usize) {
        return(1);
    };

    samples := make<Sample>(2usize);
    samples.new((7i64, 9u8));
    samples.new((40i64, 1u8));
    samples.into(address, 0usize, #samples);

    incrementSample(address, 1usize);
    observed := from<Sample>(address, 0usize, #samples);
    (firstNumber, firstByte) := observed.get(0usize);
    (secondNumber, secondByte) := observed.get(1usize);

    if (
        firstNumber == 7i64
        && firstByte == 9u8
        && secondNumber == 41i64
        && secondByte == 2u8
    )
    then return(0)
    else return(1);
};
