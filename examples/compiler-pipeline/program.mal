require "./compiler.mal";
require "./host.mal";

// Diagnostic failure does not replace the output operation that determines the process result.
_finishOutput :: WriteStatus -> Int32 := (written) ->
    written[
        () -> 0,
        (error) -> {
            writeStderr("cannot write output, errno " + error.u64.decimal() + "\n");
            1;
        }
    ];

main :: Buffer<Symbol> -> Int32 := (arguments) -> [return] => {
    when (#arguments != 1usize) {
        writeStderr("usage: mal-bfc SOURCE.bf\n");
        return(2);
    };

    path := arguments.get(0usize);
    sourceBuffer := readSource(path)[
        (source) -> source,
        (error) -> {
            writeStderr("cannot read source, errno " + error.u64.decimal() + "\n");
            return(1);
        }
    ];
    output := compile(*sourceBuffer)[
        (message) -> {
            writeStderr(message);
            return(1);
        },
        (output) -> output
    ];
    return(_finishOutput(writeStdout(output)));
};
