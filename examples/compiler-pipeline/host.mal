require "./host.c";

ReadResult :: [Buffer<UInt8>, UInt32];
WriteStatus :: [Unit, UInt32];

extern readSource :: Symbol -> ReadResult;
extern writeChunk :: (Int32, Symbol) -> WriteStatus;

writeDescriptor :: (Int32, Symbol) -> WriteStatus := (descriptor, value) ->
    writeChunk(descriptor, value);

writeStdout :: Symbol -> WriteStatus := (value) -> writeDescriptor(1i32, value);
writeStderr :: Symbol -> WriteStatus := (value) -> writeDescriptor(2i32, value);
