require "./effects.mal";
require "./contexts.mal";

main :: Unit -> Int32 := () -> [return] => {
    either := eitherScenario();
    when (either != 0i32) return(either);
    option := optionScenario();
    when (option != 0i32) return(option);
    state := stateScenario();
    when (state != 0i32) return(state);
    environment := envScenario();
    when (environment != 0i32) return(environment);
    automaton := storeScenario();
    when (automaton != 0i32) return(automaton);
    return(focusScenario());
};
