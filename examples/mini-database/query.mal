require "./host.mal";
require "./bytes.mal";
require "./input.mal";
require "./database.mal";

// Response helpers are the only query-layer operations that write user-visible protocol text.
_writeResponse :: Symbol -> Unit := (response) {
    writeSymbol(response);
};

_put :: (File, Buffer, Bytes, UInt64, UInt64, UInt64, UInt64) -> Unit :=
    (file, database, line, keyStart, keyLength, valueStart, valueLength) {
        result := putRecord(database, line, keyStart, keyLength, valueStart, valueLength);

        result[
        () {
            saveDatabase(file, database);
            _writeResponse("OK\n");
        },
        () { _writeResponse("ERROR key<=16 value<=40\n") },
        () { _writeResponse("ERROR database full\n") }
        ];
    };

_get :: (Buffer, Bytes, UInt64, UInt64) -> Unit :=
    (database, line, keyStart, keyLength) {
        result := lookupRecord(database, line, keyStart, keyLength);

        result[
        () { _writeResponse("NOT FOUND\n") },
        (value) {
            writeSymbol("VALUE ");
            writeBytes(value);
            writeSymbol("\n");
            ();
        }
        ];
    };

_delete :: (File, Buffer, Bytes, UInt64, UInt64) -> Unit :=
    (file, database, line, keyStart, keyLength) {
        if (deleteRecord(database, line, keyStart, keyLength))
        then {
            saveDatabase(file, database);
            _writeResponse("OK\n");
        }
        else { _writeResponse("NOT FOUND\n") };
    };

// Dispatch one complete line. Each recognized command returns before testing later commands.
_handleQuery :: (File, Buffer, Bytes) -> Unit := (file, database, lineBytes)[return] {
    (line, length) := lineBytes;

    when (length >= 4u64 && rangeEquals(line, length, 0u64, 4u64, "get ")) {
        keyLength := length - 4u64;
        extraSpace := findByte(line, length, 4u64, ' ');
        when (keyLength == 0u64 || extraSpace != length) {
            return(_writeResponse("ERROR usage: get KEY\n"));
        };
        return(_get(database, lineBytes, 4u64, keyLength));
    };

    when (length >= 4u64 && rangeEquals(line, length, 0u64, 4u64, "del ")) {
        keyLength := length - 4u64;
        extraSpace := findByte(line, length, 4u64, ' ');
        when (keyLength == 0u64 || extraSpace != length) {
            return(_writeResponse("ERROR usage: del KEY\n"));
        };
        return(_delete(file, database, lineBytes, 4u64, keyLength));
    };

    when (length >= 4u64 && rangeEquals(line, length, 0u64, 4u64, "put ")) {
        separator := findByte(line, length, 4u64, ' ');
        when (separator == length || separator == 4u64) {
            return(_writeResponse("ERROR usage: put KEY VALUE\n"));
        };
        return(_put(
            file,
            database,
            lineBytes,
            4u64,
            separator - 4u64,
            separator + 1u64,
            length - separator - 1u64
        ));
    };

    return(_writeResponse("ERROR commands: put/get/del/quit\n"));
};

runQueries :: (Reader, File, Buffer, Buffer) -> Unit :=
    (reader, file, database, query) {
        result := readLine(reader, query);
        result[
        (_) { () },
        (state)[return] {
            (next, lineBuffer) := state;
            lineBytes := initializedBytes(lineBuffer);
            (line, length) := lineBytes;

            when (length == 0u64 || rangeEquals(line, length, 0u64, length, "quit")) {
                return(());
            };

            _handleQuery(file, database, lineBytes);
            return(runQueries(next, file, database, query));
        }
        ];
    };
