require "./host.mal";
require "./bytes.mal";
require "./input.mal";
require "./database.mal";

_writeResponse :: Symbol -> Unit := (response) {
    writeSymbol(response);
};

_put :: (File, Buffer, Bytes, UInt64, UInt64, UInt64, UInt64) -> Unit :=
    (file, database, line, keyStart, keyLength, valueStart, valueLength) {
        result := putRecord(database, line, keyStart, keyLength, valueStart, valueLength);
        case (result)
        [0](_) {
            saveDatabase(file, database);
            _writeResponse("OK\n");
        }
        [1](_) { _writeResponse("ERROR key<=16 value<=40\n") }
        [2](_) { _writeResponse("ERROR database full\n") };
    };

_get :: (Buffer, Bytes, UInt64, UInt64) -> Unit :=
    (database, line, keyStart, keyLength) {
        result := lookupRecord(database, line, keyStart, keyLength);
        case (result)
        [0](_) { _writeResponse("NOT FOUND\n") }
        [1](value) {
            writeSymbol("VALUE ");
            writeBytes(value);
            writeSymbol("\n");
            ();
        };
    };

_delete :: (File, Buffer, Bytes, UInt64, UInt64) -> Unit :=
    (file, database, line, keyStart, keyLength) {
        if (deleteRecord(database, line, keyStart, keyLength))
        then {
            saveDatabase(file, database);
            _writeResponse("OK\n");
        }
        else { _writeResponse("NOT FOUND\n") };
    };

_handleQuery :: (File, Buffer, Bytes) -> Unit := (file, database, lineBytes) {
    (line, length) := lineBytes;
    if (length >= 4u64 && rangeEquals(line, length, 0u64, 4u64, "get "))
    then {
        keyLength := length - 4u64;
        extraSpace := findByte(line, length, 4u64, ' ');
        if (keyLength == 0u64 || extraSpace != length)
        then { _writeResponse("ERROR usage: get KEY\n") }
        else { _get(database, lineBytes, 4u64, keyLength) };
    }
    else {
        if (length >= 4u64 && rangeEquals(line, length, 0u64, 4u64, "del "))
        then {
            keyLength := length - 4u64;
            extraSpace := findByte(line, length, 4u64, ' ');
            if (keyLength == 0u64 || extraSpace != length)
            then { _writeResponse("ERROR usage: del KEY\n") }
            else { _delete(file, database, lineBytes, 4u64, keyLength) };
        }
        else {
            if (length >= 4u64 && rangeEquals(line, length, 0u64, 4u64, "put "))
            then {
                separator := findByte(line, length, 4u64, ' ');
                if (separator == length || separator == 4u64)
                then { _writeResponse("ERROR usage: put KEY VALUE\n") }
                else {
                    _put(
                        file,
                        database,
                        lineBytes,
                        4u64,
                        separator - 4u64,
                        separator + 1u64,
                        length - separator - 1u64
                    );
                };
            }
            else { _writeResponse("ERROR commands: put/get/del/quit\n") };
        };
    };
};

runQueries :: (Reader, File, Buffer, Buffer) -> Unit :=
    (reader, file, database, query) {
        result := readLine(reader, query);
        case (result)
        [0](_) { () }
        [1](state) {
            (next, lineBuffer) := state;
            lineBytes := initializedBytes(lineBuffer);
            (line, length) := lineBytes;
            if (length == 0u64 || rangeEquals(line, length, 0u64, length, "quit"))
            then { () }
            else {
                _handleQuery(file, database, lineBytes);
                runQueries(next, file, database, query);
            };
        };
    };
