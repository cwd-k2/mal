require "./host.mal";
require "./bytes.mal";
require "./input.mal";
require "./database.mal";

// Response helpers are the only query-layer operations that write user-visible protocol text.
_writeResponse :: Symbol -> Unit := (response) {
    writeSymbol(response);
};

_put :: (Buffer, File, Bytes, UInt64, UInt64, UInt64, UInt64) -> Unit :=
    (database, file, line, keyStart, keyLength, valueStart, valueLength) {
        result := database.putRecord(line, keyStart, keyLength, valueStart, valueLength);

        result[
        () {
            file.saveDatabase(database);
            _writeResponse("OK\n");
        },
        () { _writeResponse("ERROR key<=16 value<=40\n") },
        () { _writeResponse("ERROR database full\n") }
        ];
    };

_get :: (Buffer, Bytes, UInt64, UInt64) -> Unit :=
    (database, line, keyStart, keyLength) {
        result := database.lookupRecord(line, keyStart, keyLength);

        result[
        () { _writeResponse("NOT FOUND\n") },
        (value) {
            writeSymbol("VALUE ");
            writeBytes(value);
            writeSymbol("\n");
            ();
        }
        ];
    };

_delete :: (Buffer, File, Bytes, UInt64, UInt64) -> Unit :=
    (database, file, line, keyStart, keyLength) {
        if (database.deleteRecord(line, keyStart, keyLength))
        then {
            file.saveDatabase(database);
            _writeResponse("OK\n");
        }
        else { _writeResponse("NOT FOUND\n") };
    };

// Dispatch one complete line. Each recognized command returns before testing later commands.
_handleQuery :: (Buffer, File, Bytes) -> Unit := (database, file, lineBytes)[return] {
    (line, length) := lineBytes;

    when (length >= 4u64 && line.rangeEquals(length, 0u64, 4u64, "get ")) {
        keyLength := length - 4u64;
        extraSpace := line.findByte(length, 4u64, ' ');
        when (keyLength == 0u64 || extraSpace != length) {
            return(_writeResponse("ERROR usage: get KEY\n"));
        };
        return(database._get(lineBytes, 4u64, keyLength));
    };

    when (length >= 4u64 && line.rangeEquals(length, 0u64, 4u64, "del ")) {
        keyLength := length - 4u64;
        extraSpace := line.findByte(length, 4u64, ' ');
        when (keyLength == 0u64 || extraSpace != length) {
            return(_writeResponse("ERROR usage: del KEY\n"));
        };
        return(database._delete(file, lineBytes, 4u64, keyLength));
    };

    when (length >= 4u64 && line.rangeEquals(length, 0u64, 4u64, "put ")) {
        separator := line.findByte(length, 4u64, ' ');
        when (separator == length || separator == 4u64) {
            return(_writeResponse("ERROR usage: put KEY VALUE\n"));
        };
        return(database._put(
            file,
            lineBytes,
            4u64,
            separator - 4u64,
            separator + 1u64,
            length - separator - 1u64
        ));
    };

    return(_writeResponse("ERROR commands: put/get/del/quit\n"));
};

runQueries :: (Reader, File, Buffer, Buffer) -> Unit :=
    (reader, file, database, query) {
        result := reader.readLine(query);
        result[
        (_) { () },
        (state)[return] {
            (next, lineBuffer) := state;
            lineBytes := lineBuffer.initializedBytes();
            (line, length) := lineBytes;

            when (length == 0u64 || line.rangeEquals(length, 0u64, length, "quit")) {
                return(());
            };

            database._handleQuery(file, lineBytes);
            return(next.runQueries(file, database, query));
        }
        ];
    };
