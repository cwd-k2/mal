require "./host.mal";
require "./bytes.mal";
require "./input.mal";
require "./database.mal";

_put :: (ByteBuffer, File, Packed<UInt8>, USize, USize, USize, USize) -> Unit :=
    (database, file, line, keyStart, keyLength, valueStart, valueLength) -> {
        result := database.putRecord(line, keyStart, keyLength, valueStart, valueLength);

        result[
        () -> {
            file.saveDatabase(database);
            writeSymbol("OK\n");
        },
        () -> writeSymbol("ERROR key<=16 value<=40\n"),
        () -> writeSymbol("ERROR database full\n")
        ];
    };

_get :: (ByteBuffer, Packed<UInt8>, USize, USize) -> Unit :=
    (database, line, keyStart, keyLength) -> {
        result := database.lookupRecord(line, keyStart, keyLength);

        result[
        () -> writeSymbol("NOT FOUND\n"),
        (value) -> {
            writeSymbol("VALUE ");
            writeSymbol(*value);
            writeSymbol("\n");
        }
        ];
    };

_delete :: (ByteBuffer, File, Packed<UInt8>, USize, USize) -> Unit :=
    (database, file, line, keyStart, keyLength) -> {
        if (database.deleteRecord(line, keyStart, keyLength))
        then {
            file.saveDatabase(database);
            writeSymbol("OK\n");
        }
        else writeSymbol("NOT FOUND\n");
    };

// Dispatch one complete line. Each recognized command returns before testing later commands.
_handleQuery :: (ByteBuffer, File, Packed<UInt8>) -> Unit := (database, file, line) -> [return] => {
    length := #line;

    when (length >= 4usize && line.rangeEquals(0usize, 4usize, "get ")) {
        keyLength := length - 4usize;
        extraSpace := line.findByte(4usize, ' ');
        when (keyLength == 0usize || extraSpace != length) {
            return(writeSymbol("ERROR usage: get KEY\n"));
        };
        return(database._get(line, 4usize, keyLength));
    };

    when (length >= 4usize && line.rangeEquals(0usize, 4usize, "del ")) {
        keyLength := length - 4usize;
        extraSpace := line.findByte(4usize, ' ');
        when (keyLength == 0usize || extraSpace != length) {
            return(writeSymbol("ERROR usage: del KEY\n"));
        };
        return(database._delete(file, line, 4usize, keyLength));
    };

    when (length >= 4usize && line.rangeEquals(0usize, 4usize, "put ")) {
        separator := line.findByte(4usize, ' ');
        when (separator == length || separator == 4usize) {
            return(writeSymbol("ERROR usage: put KEY VALUE\n"));
        };
        return(database._put(
            file,
            line,
            4usize,
            separator - 4usize,
            separator + 1usize,
            length - separator - 1usize
        ));
    };

    return(writeSymbol("ERROR commands: put/get/del/quit\n"));
};

runQueries :: (Reader, File, ByteBuffer, ByteBuffer) -> Unit :=
    (reader, file, database, query) -> {
        result := reader.readLine(query);
        result[
        (_) -> (),
        (state) -> [return] => {
            (next, line) := state;
            length := #line;

            when (length == 0usize || line.rangeEquals(0usize, length, "quit")) {
                return(());
            };

            database._handleQuery(file, line);
            return(next.runQueries(file, database, query));
        }
        ];
    };
