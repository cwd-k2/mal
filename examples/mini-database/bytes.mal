require "./host.mal";

clearBytes :: Region<UInt8> -> Unit := (memory) -> [return] => {
    when (#memory == 0usize) {
        return(());
    };

    memory.put(0usize, 0u8);
    return((memory % 1usize).clearBytes());
};

_rangeEquals :: (Packed<UInt8>, Symbol, USize) -> Bool :=
    (source, expected, index) -> [return] => {
        when (index == #expected) {
            return(true);
        };
        when (source # index != expected # index) {
            return(false);
        };

        return(source._rangeEquals(expected, index + 1usize));
    };

rangeEquals :: (Packed<UInt8>, USize, USize, Symbol) -> Bool :=
    (source, start, length, expected) -> {
        length == #expected
            && start <= #source
            && length <= #source - start
            && (source % start)._rangeEquals(expected, 0usize);
    };

_findByte :: (Packed<UInt8>, USize, UInt8) -> USize := (source, index, byte) -> [return] => {
    when (index == #source) {
        return(index);
    };
    when (source # index == byte) {
        return(index);
    };

    return(source._findByte(index + 1usize, byte));
};

findByte :: (Packed<UInt8>, USize, UInt8) -> USize := (source, start, byte) -> {
    if (start >= #source)
    then #source
    else source._findByte(start, byte);
};

prefixEquals :: (Packed<UInt8>, Packed<UInt8>, USize) -> Bool :=
    (left, right, length) -> [return] => {
        when (length == 0usize) {
            return(true);
        };
        when (left # 0usize != right # 0usize) {
            return(false);
        };

        return((left % 1usize).prefixEquals(right % 1usize, length - 1usize));
    };

copyPrefix :: (Packed<UInt8>, Region<UInt8>, USize) -> Unit :=
    (source, destination, length) -> [return] => {
        when (length == 0usize) {
            return(());
        };

        destination.put(0usize, source # 0usize);
        return((source % 1usize).copyPrefix(destination % 1usize, length - 1usize));
    };
