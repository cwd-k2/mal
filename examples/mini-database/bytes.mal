require "./host.mal";

// Convert a byte buffer into the initialized descriptor used only at the host boundary.
initializedBytes :: ByteBuffer -> ReadableBytes := (buffer) -> {
    (memory, _, length) := buffer;
    (memory, length);
};

initializedRegion :: ByteBuffer -> Region<UInt8> := (buffer) -> {
    (memory, _, length) := buffer;
    memory@u8@length;
};

readByte :: Address -> UInt8 := (memory) -> {
    (value, _) := <-memory@u8;
    value;
};

writeByte :: (Address, UInt8) -> Unit := (memory, value) -> {
    memory@u8 <- value;
    ();
};

clearBytes :: (Address, USize) -> Unit := (memory, remaining) -> [return] => {
    when (remaining == 0usize) {
        return(());
    };

    memory@u8 <- 0u8;
    return((memory + 1bytes).clearBytes(remaining - 1usize));
};

_rangeEqualsAt :: (Packed<UInt8>, USize, Symbol, USize) -> Bool :=
    (source, start, expected, index) -> [return] => {
        when (index == #expected) {
            return(true);
        };
        when (source # (start + index) != expected # index) {
            return(false);
        };

        return(source._rangeEqualsAt(start, expected, index + 1usize));
    };

rangeEquals :: (Packed<UInt8>, USize, USize, Symbol) -> Bool :=
    (source, start, length, expected) -> {
        length == #expected
            && start <= #source
            && length <= #source - start
            && source._rangeEqualsAt(start, expected, 0usize);
    };

findByte :: (Packed<UInt8>, USize, UInt8) -> USize :=
    (source, index, byte) -> [return] => {
        when (index >= #source) {
            return(#source);
        };
        when (source # index == byte) {
            return(index);
        };

        return(source.findByte(index + 1usize, byte));
    };

memoryEqualsAt :: (Address, Packed<UInt8>, USize, USize, USize) -> Bool :=
    (memory, source, start, length, index) -> [return] => {
        when (index == length) {
            return(true);
        };
        (left, _) := <-(memory + index.bytes)@u8;
        when (left != source # (start + index)) {
            return(false);
        };

        return(memory.memoryEqualsAt(source, start, length, index + 1usize));
    };

copyRange :: (Packed<UInt8>, USize, Address, USize) -> Unit :=
    (source, start, destination, length) -> {
        selected := (source % start) / length;
        destination@u8@length <- selected;
        ();
    };
