require "./host.mal";

// Convert a writable buffer descriptor into the initialized read-only view.
initializedBytes :: Buffer -> Bytes := (buffer) -> {
    (memory, _, length) := buffer;
    (memory, length);
};

readByte :: Address -> UInt8 := (memory) -> {
    (value, _) := <-(memory @ u8);
    value;
};

writeByte :: (Address, UInt8) -> Unit := (memory, value) -> {
    _ := memory @ u8 <-value;
    ();
};

// These recursive byte operations advance one byte and reduce their remaining range.
clearBytes :: (Address, UInt64) -> Unit := (memory, remaining) -> [return] => {
    when (remaining == 0u64) {
        return(());
    };

    _ := memory @ u8 <-0u8;
    return((memory + 1bytes).clearBytes(remaining - 1u64));
};

_rangeEqualsAt :: (Address, UInt64, Symbol, UInt64) -> Bool :=
    (source, start, expected, index) -> [return] => {
        when (index == #expected) {
            return(true);
        };
        (actual, _) := <-((source + (start + index).bytes) @ u8);
        when (actual != expected # index) {
            return(false);
        };

        return(source._rangeEqualsAt(start, expected, index + 1u64));
    };

rangeEquals :: (Address, UInt64, UInt64, UInt64, Symbol) -> Bool :=
    (source, sourceLength, start, length, expected) -> {
        length == #expected
            && start + length <= sourceLength
            && source._rangeEqualsAt(start, expected, 0u64);
    };

findByte :: (Address, UInt64, UInt64, UInt8) -> UInt64 :=
    (source, length, index, byte) -> [return] => {
        when (index == length) {
            return(index);
        };
        (actual, _) := <-((source + index.bytes) @ u8);
        when (actual == byte) {
            return(index);
        };

        return(source.findByte(length, index + 1u64, byte));
    };

memoryEqualsAt :: (Address, Address, UInt64, UInt64, UInt64) -> Bool :=
    (memory, source, start, length, index) -> [return] => {
        when (index == length) {
            return(true);
        };
        (left, _) := <-((memory + index.bytes) @ u8);
        (right, _) := <-((source + (start + index).bytes) @ u8);
        when (left != right) {
            return(false);
        };

        return(memory.memoryEqualsAt(source, start, length, index + 1u64));
    };

copyRange :: (Address, UInt64, Address, UInt64) -> Unit :=
    (source, start, destination, remaining) -> [return] => {
        when (remaining == 0u64) {
            return(());
        };

        (byte, _) := <-((source + start.bytes) @ u8);
        _ := destination @ u8 <-byte;
        return(source.copyRange(start + 1u64, destination + 1bytes, remaining - 1u64));
    };
