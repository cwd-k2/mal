require "./host.mal";

clearBytes :: Region<UInt8> -> Unit := (memory) -> [return] => {
    when (#memory == 0usize) {
        return(());
    };

    (?memory)@u8 <- 0u8;
    return((memory % 1usize).clearBytes());
};

_rangeEquals :: (Region<UInt8>, Symbol, USize) -> Bool :=
    (source, expected, index) -> [return] => {
        when (index == #expected) {
            return(true);
        };
        (actual, _) := <-(?source)@u8;
        when (actual != expected # index) {
            return(false);
        };

        return((source % 1usize)._rangeEquals(expected, index + 1usize));
    };

rangeEquals :: (Region<UInt8>, USize, USize, Symbol) -> Bool :=
    (source, start, length, expected) -> {
        length == #expected
            && start <= #source
            && length <= #source - start
            && (source % start)._rangeEquals(expected, 0usize);
    };

_findByte :: (Region<UInt8>, USize, UInt8) -> USize := (source, index, byte) -> [return] => {
    when (#source == 0usize) {
        return(index);
    };
    (actual, _) := <-(?source)@u8;
    when (actual == byte) {
        return(index);
    };

    return((source % 1usize)._findByte(index + 1usize, byte));
};

findByte :: (Region<UInt8>, USize, UInt8) -> USize := (source, start, byte) -> {
    if (start >= #source)
    then#source
    else (source % start)._findByte(start, byte);
};

prefixEquals :: (Region<UInt8>, Region<UInt8>, USize) -> Bool :=
    (left, right, length) -> [return] => {
        when (length == 0usize) {
            return(true);
        };
        (leftByte, _) := <-(?left)@u8;
        (rightByte, _) := <-(?right)@u8;
        when (leftByte != rightByte) {
            return(false);
        };

        return((left % 1usize).prefixEquals(right % 1usize, length - 1usize));
    };

copyPrefix :: (Region<UInt8>, Region<UInt8>, USize) -> Unit :=
    (source, destination, length) -> [return] => {
        when (length == 0usize) {
            return(());
        };

        (byte, _) := <-(?source)@u8;
        (?destination)@u8 <- byte;
        return((source % 1usize).copyPrefix(destination % 1usize, length - 1usize));
    };
