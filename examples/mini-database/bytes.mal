// Compare one Symbol snapshot without constructing a slice of the source Buffer.
_rangeEquals :: (Buffer<UInt8>, USize, Buffer<UInt8>, USize) -> Bool :=
    (source, start, expected, index) -> [return] => {
        when (index == #expected) {
            return(true);
        };
        when (source.get(start + index) != expected.get(index)) {
            return(false);
        };
        return(source._rangeEquals(start, expected, index + 1usize));
    };

rangeEquals :: (Buffer<UInt8>, USize, USize, Symbol) -> Bool :=
    (source, start, length, expected) -> {
        bytes := *expected;
        length == #bytes
            && start <= #source
            && length <= #source - start
            && source._rangeEquals(start, bytes, 0usize);
    };

_findByte :: (Buffer<UInt8>, USize, UInt8) -> USize := (source, index, byte) -> [return] => {
    when (index == #source || source.get(index) == byte) {
        return(index);
    };
    return(source._findByte(index + 1usize, byte));
};

findByte :: (Buffer<UInt8>, USize, UInt8) -> USize := (source, start, byte) ->
    if (start >= #source)
        then #source
        else source._findByte(start, byte);

// Copying uses explicit coordinates so source and destination may be larger carriers.
copyRange :: (Buffer<UInt8>, USize, Buffer<UInt8>, USize, USize) -> Unit :=
    (source, sourceStart, destination, destinationStart, length) -> [return] => {
        when (length == 0usize) {
            return(());
        };
        destination.put(destinationStart, source.get(sourceStart));
        return(source.copyRange(
            sourceStart + 1usize,
            destination,
            destinationStart + 1usize,
            length - 1usize
        ));
    };

_fillSlice :: (Buffer<UInt8>, USize, USize, Buffer<UInt8>) -> Unit :=
    (source, start, remaining, result) -> [return] => {
        when (remaining == 0usize) {
            return(());
        };
        result.new(source.get(start));
        return(_fillSlice(source, start + 1usize, remaining - 1usize, result));
    };

copySlice :: (Buffer<UInt8>, USize, USize) -> Buffer<UInt8> := (source, start, length) -> {
    result := make<UInt8>(length);
    _fillSlice(source, start, length, result);
    result;
};
