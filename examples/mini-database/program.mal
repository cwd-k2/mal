require "./host.mal";
require "./application.mal";

main :: Arguments -> Int32 := \(argumentCount :: UInt64, arguments :: Ptr) {
    if (argumentCount == 1u64)
    then {
        path := loadSymbol(loadPtr(arguments), loadUInt64(arguments + @Ptr));
        executeDatabase(path);
    }
    else {
        extern writeSymbol("usage: mal-mini-database DATABASE\n");
        2;
    };
};
