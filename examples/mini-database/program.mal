Buffer :: (Ptr, UInt64, UInt64);
Bytes :: (Ptr, UInt64);

extern Allocator;
extern createAllocator :: Unit -> Allocator;
extern allocateBuffer :: (Allocator, UInt64) -> Buffer;
extern destroyAllocator :: Allocator -> Unit;
extern File;
extern openReadWriteCreate :: Symbol -> File;
extern standardInput :: Unit -> File;
extern readFile :: (File, Ptr, UInt64) -> UInt64;
extern writeFile :: (File, Ptr, UInt64) -> UInt64;
extern rewindFile :: File -> Unit;
extern flushFile :: File -> Unit;
extern closeFile :: File -> Unit;
extern writeSymbol :: Symbol -> Unit;
extern writeBytes :: Bytes -> Unit;
extern fail :: Symbol -> Unit;

Arguments :: (UInt64, Ptr);

databaseSize :: UInt64 := 4112u64;
databaseReadCapacity :: UInt64 := 4113u64;
headerSize :: UInt64 := 16u64;
recordSize :: UInt64 := 64u64;
recordCount :: UInt64 := 64u64;
keyCapacity :: UInt64 := 16u64;
valueCapacity :: UInt64 := 40u64;
queryStorageSize :: UInt64 := 257u64;

readFileToCapacity :: (File, Buffer) -> Buffer := \(file :: File, buffer :: Buffer) {
    (memory, capacity, length) := buffer;
    if (length == capacity)
        then { buffer }
        else {
            transferred := extern readFile(file, memory + length, capacity - length);
            if (transferred == 0u64)
                then { buffer }
                else { readFileToCapacity(file, (memory, capacity, length + transferred)) };
        };
};

initializedBytes :: Buffer -> Bytes := \(buffer :: Buffer) {
    (memory, _, length) := buffer;
    (memory, length);
};

writeBytesFully :: (File, Bytes, UInt64) -> Unit :=
    \(file :: File, bytes :: Bytes, written :: UInt64) {
        (memory, length) := bytes;
        if (written == length)
            then { () }
            else {
                transferred := extern writeFile(file, memory + written, length - written);
                if (transferred == 0u64)
                    then {
                        extern fail("file write made no progress");
                        ();
                    }
                    else { writeBytesFully(file, bytes, written + transferred) };
            };
    };

saveDatabase :: (File, Buffer) -> Unit := \(file :: File, database :: Buffer) {
    extern rewindFile(file);
    writeBytesFully(file, initializedBytes(database), 0u64);
    extern flushFile(file);
};

readLineAt :: (File, Buffer) -> Buffer := \(input :: File, buffer :: Buffer) {
    (line, capacity, length) := buffer;
    received := extern readFile(input, line + length, 1u64);
    if (received == 0u64)
        then { buffer }
        else {
            byte := loadUInt8(line + length);
            if (byte == '\n')
                then {
                    if (length > 0u64 && loadUInt8(line + length - 1u64) == '\r')
                        then { (line, capacity, length - 1u64) }
                        else { buffer };
                }
                else {
                    if (length + 1u64 == capacity)
                        then {
                            extern fail("query line exceeds its buffer");
                            buffer;
                        }
                        else { readLineAt(input, (line, capacity, length + 1u64)) };
                };
        };
};

readLine :: (File, Buffer) -> Buffer := \(input :: File, buffer :: Buffer) {
    (line, capacity, _) := buffer;
    readLineAt(input, (line, capacity, 0u64));
};

clearBytes :: (Ptr, UInt64) -> Unit := \(memory :: Ptr, remaining :: UInt64) {
    if (remaining == 0u64)
        then { () }
        else {
            storeUInt8(memory, 0u8);
            clearBytes(memory + 1u64, remaining - 1u64);
        };
};

initializeDatabase :: Buffer -> Buffer := \(buffer :: Buffer) {
    (memory, capacity, _) := buffer;
    clearBytes(memory, databaseSize);
    storeUInt8(memory, 'M');
    storeUInt8(memory + 1u64, 'A');
    storeUInt8(memory + 2u64, 'L');
    storeUInt8(memory + 3u64, 'D');
    storeUInt8(memory + 4u64, 1u8);
    storeUInt8(memory + 5u64, 64u8);
    (memory, capacity, databaseSize);
};

recordAt :: (Ptr, UInt64) -> Ptr := \(database :: Ptr, index :: UInt64) {
    database + headerSize + index * recordSize;
};

validateRecords :: (Ptr, UInt64) -> Bool := \(database :: Ptr, index :: UInt64) {
    if (index == recordCount)
        then { true }
        else {
            record := recordAt(database, index);
            active := loadUInt8(record);
            keyLength := UInt64(loadUInt8(record + 1u64));
            valueLength := UInt64(loadUInt8(record + 2u64));
            valid := (active == 0u8 || active == 1u8)
                && keyLength <= keyCapacity
                && valueLength <= valueCapacity
                && (active == 0u8 || keyLength > 0u64);
            valid && validateRecords(database, index + 1u64);
        };
};

validateDatabase :: Buffer -> Bool := \(buffer :: Buffer) {
    (database, _, length) := buffer;
    length == databaseSize
        && loadUInt8(database) == 'M'
        && loadUInt8(database + 1u64) == 'A'
        && loadUInt8(database + 2u64) == 'L'
        && loadUInt8(database + 3u64) == 'D'
        && loadUInt8(database + 4u64) == 1u8
        && loadUInt8(database + 5u64) == 64u8
        && validateRecords(database, 0u64);
};

rangeEqualsAt :: (Ptr, UInt64, Symbol, UInt64) -> Bool :=
    \(source :: Ptr, start :: UInt64, expected :: Symbol, index :: UInt64) {
        if (index == #expected)
            then { true }
            else {
                loadUInt8(source + start + index) == expected # index
                    && rangeEqualsAt(source, start, expected, index + 1u64);
            };
    };

rangeEquals :: (Ptr, UInt64, UInt64, UInt64, Symbol) -> Bool :=
    \(source :: Ptr, sourceLength :: UInt64, start :: UInt64, length :: UInt64, expected :: Symbol) {
        length == #expected
            && start + length <= sourceLength
            && rangeEqualsAt(source, start, expected, 0u64);
    };

findByte :: (Ptr, UInt64, UInt64, UInt8) -> UInt64 :=
    \(source :: Ptr, length :: UInt64, index :: UInt64, byte :: UInt8) {
        if (index == length)
            then { index }
            else {
                if (loadUInt8(source + index) == byte)
                    then { index }
                    else { findByte(source, length, index + 1u64, byte) };
            };
    };

memoryEqualsAt :: (Ptr, Ptr, UInt64, UInt64, UInt64) -> Bool :=
    \(memory :: Ptr, source :: Ptr, start :: UInt64, length :: UInt64, index :: UInt64) {
        if (index == length)
            then { true }
            else {
                loadUInt8(memory + index) == loadUInt8(source + start + index)
                    && memoryEqualsAt(memory, source, start, length, index + 1u64);
            };
    };

findRecord :: (Ptr, Ptr, UInt64, UInt64, UInt64) -> UInt64 :=
    \(database :: Ptr, key :: Ptr, start :: UInt64, length :: UInt64, index :: UInt64) {
        if (index == recordCount)
            then { recordCount }
            else {
                record := recordAt(database, index);
                matches := loadUInt8(record) == 1u8
                    && UInt64(loadUInt8(record + 1u64)) == length
                    && memoryEqualsAt(record + 8u64, key, start, length, 0u64);
                if (matches)
                    then { index }
                    else { findRecord(database, key, start, length, index + 1u64) };
            };
    };

findFreeRecord :: (Ptr, UInt64) -> UInt64 := \(database :: Ptr, index :: UInt64) {
    if (index == recordCount)
        then { recordCount }
        else {
            if (loadUInt8(recordAt(database, index)) == 0u8)
                then { index }
                else { findFreeRecord(database, index + 1u64) };
        };
};

copyRange :: (Ptr, UInt64, Ptr, UInt64) -> Unit :=
    \(source :: Ptr, start :: UInt64, destination :: Ptr, remaining :: UInt64) {
        if (remaining == 0u64)
            then { () }
            else {
                storeUInt8(destination, loadUInt8(source + start));
                copyRange(source, start + 1u64, destination + 1u64, remaining - 1u64);
            };
    };

writeResponse :: Symbol -> Unit := \(response :: Symbol) {
    extern writeSymbol(response);
};

putRecord :: (File, Buffer, Bytes, UInt64, UInt64, UInt64, UInt64) -> Unit :=
    \(file :: File, databaseBuffer :: Buffer, lineBytes :: Bytes, keyStart :: UInt64, keyLength :: UInt64, valueStart :: UInt64, valueLength :: UInt64) {
        (database, _, _) := databaseBuffer;
        (line, _) := lineBytes;
        if (keyLength == 0u64 || keyLength > keyCapacity || valueLength > valueCapacity)
            then { writeResponse("ERROR key<=16 value<=40\n") }
            else {
                existing := findRecord(database, line, keyStart, keyLength, 0u64);
                slot := if (existing == recordCount)
                    then { findFreeRecord(database, 0u64) }
                    else { existing };
                if (slot == recordCount)
                    then { writeResponse("ERROR database full\n") }
                    else {
                        record := recordAt(database, slot);
                        storeUInt8(record + 1u64, UInt8(keyLength));
                        storeUInt8(record + 2u64, UInt8(valueLength));
                        copyRange(line, keyStart, record + 8u64, keyLength);
                        copyRange(line, valueStart, record + 24u64, valueLength);
                        storeUInt8(record, 1u8);
                        saveDatabase(file, databaseBuffer);
                        writeResponse("OK\n");
                    };
            };
    };

getRecord :: (Buffer, Bytes, UInt64, UInt64) -> Unit :=
    \(databaseBuffer :: Buffer, lineBytes :: Bytes, keyStart :: UInt64, keyLength :: UInt64) {
        (database, _, _) := databaseBuffer;
        (line, _) := lineBytes;
        slot := findRecord(database, line, keyStart, keyLength, 0u64);
        if (slot == recordCount)
            then { writeResponse("NOT FOUND\n") }
            else {
                record := recordAt(database, slot);
                valueLength := UInt64(loadUInt8(record + 2u64));
                extern writeSymbol("VALUE ");
                extern writeBytes((record + 24u64, valueLength));
                extern writeSymbol("\n");
                ();
            };
    };

deleteRecord :: (File, Buffer, Bytes, UInt64, UInt64) -> Unit :=
    \(file :: File, databaseBuffer :: Buffer, lineBytes :: Bytes, keyStart :: UInt64, keyLength :: UInt64) {
        (database, _, _) := databaseBuffer;
        (line, _) := lineBytes;
        slot := findRecord(database, line, keyStart, keyLength, 0u64);
        if (slot == recordCount)
            then { writeResponse("NOT FOUND\n") }
            else {
                storeUInt8(recordAt(database, slot), 0u8);
                saveDatabase(file, databaseBuffer);
                writeResponse("OK\n");
            };
    };

handleQuery :: (File, Buffer, Bytes) -> Unit := \(file :: File, database :: Buffer, lineBytes :: Bytes) {
    (line, length) := lineBytes;
    if (length >= 4u64 && rangeEquals(line, length, 0u64, 4u64, "get "))
        then {
            keyLength := length - 4u64;
            extraSpace := findByte(line, length, 4u64, ' ');
            if (keyLength == 0u64 || extraSpace != length)
                then { writeResponse("ERROR usage: get KEY\n") }
                else { getRecord(database, lineBytes, 4u64, keyLength) };
        }
        else {
            if (length >= 4u64 && rangeEquals(line, length, 0u64, 4u64, "del "))
                then {
                    keyLength := length - 4u64;
                    extraSpace := findByte(line, length, 4u64, ' ');
                    if (keyLength == 0u64 || extraSpace != length)
                        then { writeResponse("ERROR usage: del KEY\n") }
                        else { deleteRecord(file, database, lineBytes, 4u64, keyLength) };
                }
                else {
                    if (length >= 4u64 && rangeEquals(line, length, 0u64, 4u64, "put "))
                        then {
                            separator := findByte(line, length, 4u64, ' ');
                            if (separator == length || separator == 4u64)
                                then { writeResponse("ERROR usage: put KEY VALUE\n") }
                                else {
                                    putRecord(
                                        file,
                                        database,
                                        lineBytes,
                                        4u64,
                                        separator - 4u64,
                                        separator + 1u64,
                                        length - separator - 1u64
                                    );
                                };
                        }
                        else { writeResponse("ERROR commands: put/get/del/quit\n") };
                };
        };
};

runQueries :: (File, File, Buffer, Buffer) -> Unit :=
    \(input :: File, file :: File, database :: Buffer, query :: Buffer) {
        lineBuffer := readLine(input, query);
        lineBytes := initializedBytes(lineBuffer);
        (line, length) := lineBytes;
        if (length == 0u64 || rangeEquals(line, length, 0u64, length, "quit"))
            then { () }
            else {
                handleQuery(file, database, lineBytes);
                runQueries(input, file, database, query);
            };
    };

executeDatabase :: Symbol -> Int32 := \(path :: Symbol) {
    allocator := extern createAllocator();
    file := extern openReadWriteCreate(path);
    input := extern standardInput();
    databaseStorage := extern allocateBuffer(allocator, databaseReadCapacity);
    query := extern allocateBuffer(allocator, queryStorageSize);
    loadedDatabase := readFileToCapacity(file, databaseStorage);
    (_, _, loaded) := loadedDatabase;
    database := if (loaded == 0u64)
        then { initializeDatabase(loadedDatabase) }
        else {
            if (!validateDatabase(loadedDatabase))
                then {
                    extern fail("invalid database file");
                    loadedDatabase;
                }
                else { loadedDatabase };
        };
    runQueries(input, file, database, query);
    extern closeFile(file);
    extern destroyAllocator(allocator);
    0;
};

main :: Arguments -> Int32 := \(argumentCount :: UInt64, arguments :: Ptr) {
    if (argumentCount == 1u64)
        then {
            path := loadSymbol(loadPtr(arguments), loadUInt64(arguments + @Ptr));
            executeDatabase(path)
        }
        else {
            extern writeSymbol("usage: mal-mini-database DATABASE\n");
            2;
        };
};
