require "./host.mal";
require "./bytes.mal";

// Reader fields: file, host transfer storage, capacity, current managed chunk, next byte.
Reader :: (File, Address, USize, Buffer<UInt8>, USize);
ByteRead :: [Reader, (Reader, UInt8)];
LineState :: (Reader, Buffer<UInt8>);
LineRead :: [Reader, LineState];

_readByte :: Reader -> ByteRead := (reader) -> [eof, read] => {
    (file, memory, capacity, bytes, position) := reader;
    when (position < #bytes) {
        read(((file, memory, capacity, bytes, position + 1usize), bytes.get(position)));
    };
    transferred := readFile(file, memory, 0usize, capacity);
    // Snapshot the initialized prefix before the host transfer area is reused.
    nextBytes := from<UInt8>(memory, 0usize, transferred);
    next := (file, memory, capacity, nextBytes, 0usize);
    when (transferred == 0usize) {
        eof(next);
    };
    read(((file, memory, capacity, nextBytes, 1usize), nextBytes.get(0usize)));
};

_readLineAt :: (Reader, Buffer<UInt8>) -> LineRead := (reader, line) -> {
    result := reader._readByte();
    result[
    (next) -> if (#line == 0usize)
        then [eof, ready] => eof(next)
        else [eof, ready] => ready((next, line)),
    (read) -> [return] => {
        (next, byte) := read;
        // A completed line excludes LF and an optional preceding CR.
        when (byte == '\n') {
            lineLength := #line;
            when (lineLength > 0usize && line.get(lineLength - 1usize) == '\r') {
                return([eof, ready] => ready((next, line.copySlice(0usize, lineLength - 1usize))));
            };
            return([eof, ready] => ready((next, line)));
        };
        when (#line == 256usize) {
            fail("query line exceeds its buffer");
            return([eof, ready] => ready((next, line)));
        };
        line.new(byte);
        return(next._readLineAt(line));
    }
    ];
};

readLine :: Reader -> LineRead := (reader) -> reader._readLineAt(make<UInt8>(257usize));
