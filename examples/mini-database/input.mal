require "./host.mal";
require "./bytes.mal";

// Reader fields: 0 source file, 1 reusable buffer, 2 next unread byte.
Reader :: (File, ByteBuffer, USize);
// ByteRead variant 0 carries the reader at EOF; variant 1 carries the next reader and byte.
ByteRead :: [Reader, (Reader, UInt8)];

// LineState fields: 0 next reader, 1 initialized line buffer.
LineState :: (Reader, ByteBuffer);
// LineRead variant 0 carries the reader at EOF; variant 1 carries one completed line.
LineRead :: [Reader, LineState];

_lineAtEof :: Reader -> LineRead := (reader) -> [eof, ready] => eof(reader);

_lineReady :: LineState -> LineRead := (state) -> [eof, ready] => ready(state);

// Return buffered data first; refill only when the cursor reaches initialized bytes.
_readByte :: Reader -> ByteRead := (reader) -> [eof, read] => {
    (file, buffer, position) := reader;
    (memory, length) := buffer;
    capacity := #memory;

    when (position < length) {
        byte := <-(?(memory % position))@u8;
        read(((file, buffer, position + 1usize), byte));
    };

    transferred := file.readFile((?memory, capacity));
    filled := (memory, transferred);
    next := (file, filled, 0usize);
    when (transferred == 0usize) {
        eof(next);
    };

    byte := <-(?memory)@u8;
    read(((file, filled, 1usize), byte));
};

_readLineAt :: (Reader, ByteBuffer) -> LineRead := (reader, buffer) -> {
    (line, length) := buffer;
    capacity := #line;
    result := reader._readByte();
    result[
    (next) -> [return] => {
        when (length == 0usize) {
            return(_lineAtEof(next));
        };
        return(_lineReady((next, buffer)));
    },
    (read) -> [return] => {
        (next, byte) := read;

        // A completed line excludes LF and an optional preceding CR.
        when (byte == '\n') {
            when (length > 0usize) {
                previous := <-(?(line % (length - 1usize)))@u8;
                when (previous == '\r') {
                    return(_lineReady((next, (line, length - 1usize))));
                };
            };
            return(_lineReady((next, buffer)));
        };

        when (length + 1usize == capacity) {
            fail("query line exceeds its buffer");
            return(_lineReady((next, buffer)));
        };

        (?(line % length))@u8 <- byte;
        return(next._readLineAt((line, length + 1usize)));
    }
    ];
};

readLine :: (Reader, ByteBuffer) -> LineRead := (reader, buffer) -> {
    (line, _) := buffer;
    reader._readLineAt((line, 0usize));
};
