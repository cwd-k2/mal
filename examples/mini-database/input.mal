require "./host.mal";

// Reader fields: 0 source file, 1 reusable buffer, 2 next unread byte.
Reader :: (File, Buffer, UInt64);
// ByteRead variant 0 carries the reader at EOF; variant 1 carries the next reader and byte.
ByteRead :: [Reader, (Reader, UInt8)];
// LineState fields: 0 next reader, 1 initialized line buffer.
LineState :: (Reader, Buffer);
// LineRead variant 0 carries the reader at EOF; variant 1 carries one completed line.
LineRead :: [Reader, LineState];

_readByte :: Reader -> ByteRead := (reader) {
    (file, buffer, position) := reader;
    (memory, capacity, length) := buffer;
    if (position < length)
    then {
        byte := UInt8.load(memory + position);
        1[ByteRead](((file, buffer, position + 1u64), byte));
    }
    else {
        transferred := readFile(file, (memory, capacity));
        filled := (memory, capacity, transferred);
        next := (file, filled, 0u64);
        if (transferred == 0u64)
        then { 0[ByteRead](next) }
        else {
            byte := UInt8.load(memory);
            1[ByteRead](((file, filled, 1u64), byte));
        };
    };
};

_readLineAt :: (Reader, Buffer) -> LineRead := (reader, buffer) {
    (line, capacity, length) := buffer;
    result := _readByte(reader);
    case (result)
    [0](next) {
        if (length == 0u64)
        then { 0[LineRead](next) }
        else { 1[LineRead]((next, buffer)) };
    }
    [1](read) {
        (next, byte) := read;
        if (byte == '\n')
        then {
            if (length > 0u64 && UInt8.load(line + length - 1u64) == '\r')
            then { 1[LineRead]((next, (line, capacity, length - 1u64))) }
            else { 1[LineRead]((next, buffer)) };
        }
        else {
            if (length + 1u64 == capacity)
            then {
                fail("query line exceeds its buffer");
                1[LineRead]((next, buffer));
            }
            else {
                UInt8.store(line + length, byte);
                _readLineAt(next, (line, capacity, length + 1u64));
            };
        };
    };
};

readLine :: (Reader, Buffer) -> LineRead := (reader, buffer) {
    (line, capacity, _) := buffer;
    _readLineAt(reader, (line, capacity, 0u64));
};
