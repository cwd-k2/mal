require "./host.c";

// AllocatedBytes is the host-mappable allocation result; ByteBuffer is the internal region and its
// initialized prefix length.
AllocatedBytes :: (Address, USize);
ByteBuffer :: (Region<UInt8>, USize);
// Host transfer descriptors keep direction explicit at the extern boundary.
ReadableBytes :: (Address, USize);
WritableBytes :: (Address, USize);
OutputBuffer :: (Address, USize);

extern Allocator;
extern File;

// Process-lifetime allocation authority.
extern createAllocator :: Unit -> Allocator;
extern allocateBuffer :: (Allocator, USize) -> AllocatedBytes;
extern destroyAllocator :: Allocator -> Unit;

// Borrowed file handles and positional byte transfer.
extern openReadWriteCreate :: ReadableBytes -> File;
extern standardInput :: Unit -> File;
extern readFile :: (File, WritableBytes) -> USize;
extern writeFile :: (File, ReadableBytes) -> USize;
extern rewindFile :: File -> Unit;
extern flushFile :: File -> Unit;
extern closeFile :: File -> Unit;

// Process output and unrecoverable host failure.
extern outputBuffer :: Unit -> OutputBuffer;
extern writeStdout :: ReadableBytes -> Unit;
extern writeStderr :: ReadableBytes -> Unit;
extern failNow :: Unit -> Unit;

_writePacked :: (ReadableBytes -> Unit, Region<UInt8>, Packed<UInt8>) -> Unit :=
    (write, buffer, remaining) -> [return] => {
        when (#remaining == 0usize) {
            return(());
        };

        remainingLength := #remaining;
        capacity := #buffer;
        transferred := if (remainingLength < capacity)
            then remainingLength
            else capacity;
        prefix := remaining / transferred;
        buffer / transferred <- prefix;
        write((?buffer, transferred));
        return(_writePacked(write, buffer, remaining % transferred));
    };

writeSymbol :: Symbol -> Unit := (value) -> {
    (memory, capacity) := outputBuffer();
    _writePacked(writeStdout, memory@u8@capacity, *value);
};

fail :: Symbol -> Unit := (value) -> {
    (memory, capacity) := outputBuffer();
    buffer := memory@u8@capacity;
    _writePacked(writeStderr, buffer, *value);
    _writePacked(writeStderr, buffer, *"\n");
    failNow();
};

// Arguments fields: 0 argument count, 1 first external descriptor address.
Arguments :: (USize, Address);
