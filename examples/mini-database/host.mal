require "./host.c";

// AllocatedBytes fields: 0 allocator-owned memory, 1 byte capacity.
AllocatedBytes :: (Address, USize);
// ByteBuffer fields: 0 allocator-owned memory, 1 capacity, 2 initialized prefix length.
ByteBuffer :: (Address, USize, USize);
// ReadableBytes grants the host read access to a byte range for one call.
ReadableBytes :: (Address, USize);
// WritableBytes grants the host write access to a byte range for one call.
WritableBytes :: (Address, USize);
// OutputBuffer fields: 0 process-lifetime writable memory, 1 nonzero byte capacity.
OutputBuffer :: (Address, USize);

extern Allocator;
extern File;

// Creates allocation authority that owns every buffer subsequently allocated through it.
extern createAllocator :: Unit -> Allocator;
// Allocates nonempty storage retained until its allocator is destroyed.
extern allocateBuffer :: (Allocator, USize) -> AllocatedBytes;
// Releases the allocator and every buffer allocated through it.
extern destroyAllocator :: Allocator -> Unit;

// Copies a Symbol into allocator-owned memory so that one host call can read it. The host reads the byte range, so no
// terminator is written; the memory stays valid until the allocator is destroyed.
readableBytes :: (Allocator, Symbol) -> ReadableBytes := (allocator, text) -> {
    bytes := *text;
    length := #bytes;
    (memory, _) := allocator.allocateBuffer(if (length == 0usize) then 1usize else length);
    bytes.into(memory, 0usize, length);
    (memory, length);
};

// Opens an existing database for update or creates it; failures terminate through the host boundary.
extern openReadWriteCreate :: ReadableBytes -> File;
// Returns the process-owned standard-input handle, which must not be closed by this program.
extern standardInput :: Unit -> File;
// Offset and length are byte coordinates within the host buffer.
extern readFile :: (File, Address, USize, USize) -> USize;
extern writeFile :: (File, Address, USize, USize) -> USize;
// Moves the file position to its first byte.
extern rewindFile :: File -> Unit;
// Publishes buffered writes to the host file system.
extern flushFile :: File -> Unit;
// Closes a database file handle after its final transfer.
extern closeFile :: File -> Unit;

// Returns reusable process-lifetime staging storage for standard output or error.
extern outputBuffer :: Unit -> OutputBuffer;
// Writes a prefix of the staging buffer to standard output.
extern writeStdout :: ReadableBytes -> Unit;
// Writes a prefix of the staging buffer to standard error.
extern writeStderr :: ReadableBytes -> Unit;
// Terminates after an error message has been emitted.
extern failNow :: Unit -> Unit;

// Each tail step lends one bounded chunk to the selected sink and carries only the remaining bytes.
_writeBuffer :: (ReadableBytes -> Unit, Address, USize, Buffer<UInt8>, USize) -> Unit :=
    (write, memory, capacity, bytes, offset) -> [return] => {
        when (offset == #bytes) {
            return();
        };

        remainingLength := #bytes - offset;
        transferred := if (remainingLength < capacity)
            then remainingLength
            else capacity;
        bytes.into(memory, offset, transferred);
        write(memory, transferred);
        return(_writeBuffer(write, memory, capacity, bytes, offset + transferred));
    };

writeSymbol :: Symbol -> Unit := (value) -> {
    (memory, capacity) := outputBuffer();
    _writeBuffer(writeStdout, memory, capacity, *value, 0usize);
};

fail :: Symbol -> Unit := (value) -> {
    (memory, capacity) := outputBuffer();
    _writeBuffer(writeStderr, memory, capacity, *value, 0usize);
    _writeBuffer(writeStderr, memory, capacity, *"\n", 0usize);
    failNow();
};
