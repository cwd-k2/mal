require "./host.mal";
require "./database.mal";
require "./query.mal";

_queryStorageSize :: USize := 257usize;
_inputStorageSize :: USize := 4096usize;

executeDatabase :: (Address, USize) -> Int32 := (path) -> {
    // Acquire process-lifetime resources before deriving any borrowed memory views.
    allocator := createAllocator();
    file := openReadWriteCreate(path);
    input := standardInput();

    (databaseMemory, databaseCapacity) := allocator.allocateBuffer(databaseReadCapacity);
    databaseStorage := (databaseMemory@u8@databaseCapacity, 0usize);
    (queryMemory, queryCapacity) := allocator.allocateBuffer(_queryStorageSize);
    query := (queryMemory@u8@queryCapacity, 0usize);
    (inputMemory, inputCapacity) := allocator.allocateBuffer(_inputStorageSize);
    inputBuffer := (inputMemory@u8@inputCapacity, 0usize);

    loadedDatabase := file.readDatabaseFile(databaseStorage);
    (_, loaded) := loadedDatabase;
    database := if (loaded == 0usize)
        then loadedDatabase.initializeDatabase()
        else {
            when (!loadedDatabase.validateDatabase()) {
                fail("invalid database file");
            };
            loadedDatabase;
        };

    (input, inputBuffer, 0usize).runQueries(file, database, query);

    // No buffer view may be used after destroying its allocator.
    file.closeFile();
    allocator.destroyAllocator();
    0;
};
