require "./host.mal";
require "./database.mal";
require "./query.mal";

_inputCapacity :: USize := 4096usize;

executeDatabase :: (Address, USize) -> Int32 := (path) -> {
    // The allocator owns only reusable host transfer areas; database values remain managed Buffers.
    allocator := createAllocator();
    file := openReadWriteCreate(path);
    input := standardInput();

    (databaseMemory, databaseCapacity) := allocator.allocateBuffer(databaseReadCapacity);
    loaded := readDatabaseFile(file, databaseMemory, databaseCapacity, 0usize);
    database := if (loaded == 0usize)
        then initializeDatabase(databaseMemory)
        else {
            // Admission copies first; validation decides whether those bytes form a database image.
            bytes := from<UInt8>(databaseMemory, 0usize, loaded);
            when (!bytes.validateDatabase()) {
                fail("invalid database file");
            };
            (databaseMemory, bytes);
        };

    (inputMemory, inputCapacity) := allocator.allocateBuffer(_inputCapacity);
    reader := (input, inputMemory, inputCapacity, make<UInt8>(0usize), 0usize);
    reader.runQueries(file, database);

    file.closeFile();
    // No Address-backed transfer operation occurs after the allocator is destroyed.
    allocator.destroyAllocator();
    0;
};
