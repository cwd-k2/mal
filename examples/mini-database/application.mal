require "./host.mal";
require "./database.mal";
require "./query.mal";

_queryStorageSize :: UInt64 := 257u64;
_inputStorageSize :: UInt64 := 4096u64;

executeDatabase :: Symbol -> Int32 := (path) {
    // Acquire process-lifetime resources before deriving any borrowed memory views.
    allocator := createAllocator();
    file := path.openReadWriteCreate();
    input := standardInput();

    databaseStorage := allocator.allocateBuffer(databaseReadCapacity);
    query := allocator.allocateBuffer(_queryStorageSize);
    inputBuffer := allocator.allocateBuffer(_inputStorageSize);

    loadedDatabase := file.readDatabaseFile(databaseStorage);
    (_, _, loaded) := loadedDatabase;
    database := if (loaded == 0u64)
        then { loadedDatabase.initializeDatabase() }
        else {
            when (!loadedDatabase.validateDatabase()) {
                fail("invalid database file");
            };
            loadedDatabase;
        };

    (input, inputBuffer, 0u64).runQueries(file, database, query);

    // No buffer view may be used after destroying its allocator.
    file.closeFile();
    allocator.destroyAllocator();
    0;
};
