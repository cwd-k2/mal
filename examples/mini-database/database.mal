require "./host.mal";
require "./bytes.mal";

databaseReadCapacity :: USize := 4113usize;
// A valid image is a 16-byte header followed by 64 fixed-size records.
_databaseSize :: USize := 4112usize;
_headerSize :: USize := 16usize;
_recordSize :: USize := 64usize;
_recordCount :: USize := 64usize;
_keyCapacity :: USize := 16usize;
_valueCapacity :: USize := 40usize;

// Database keeps host transfer storage beside the managed image copied from it.
Database :: (Address, Buffer<UInt8>);
// PutResult distinguishes success, invalid field lengths, and exhausted record slots.
PutResult :: [Unit, Unit, Unit];
// LookupResult distinguishes a missing key from an owned value-byte snapshot.
LookupResult :: [Unit, Buffer<UInt8>];

// Offset stays in the host call so mal never derives an Address.
readDatabaseFile :: (File, Address, USize, USize) -> USize :=
    (file, memory, capacity, length) -> [return] => {
        when (length == capacity) {
            return(length);
        };
        transferred := readFile(file, memory, length, capacity - length);
        when (transferred == 0usize) {
            return(length);
        };
        return(readDatabaseFile(file, memory, capacity, length + transferred));
    };

_writeBytesFully :: (File, Address, USize, USize) -> Unit :=
    (file, memory, length, written) -> [return] => {
        when (written == length) {
            return();
        };
        transferred := writeFile(file, memory, written, length - written);
        when (transferred == 0usize) {
            fail("file write made no progress");
            return();
        };
        return(_writeBytesFully(file, memory, length, written + transferred));
    };

saveDatabase :: (File, Database) -> Unit := (file, (memory, bytes)) -> {
    // The host observes bytes only after the complete managed image has been staged.
    bytes.into(memory, 0usize, #bytes);
    rewindFile(file);
    _writeBytesFully(file, memory, #bytes, 0usize);
    flushFile(file);
};

initializeDatabase :: Address -> Database := (memory) -> {
    bytes := make<UInt8>(_databaseSize);
    bytes.fill(0usize, _databaseSize, 0u8);
    bytes.put(0usize, 'M');
    bytes.put(1usize, 'A');
    bytes.put(2usize, 'L');
    bytes.put(3usize, 'D');
    bytes.put(4usize, 1u8);
    bytes.put(5usize, 64u8);
    (memory, bytes);
};

_validateRecords :: (Buffer<UInt8>, USize) -> Bool := (database, index) -> [return] => {
    when (index == _recordCount) {
        return(true);
    };
    offset := _headerSize + index * _recordSize;
    active := database.get(offset);
    keyLength := database.get(offset + 1usize).usize;
    valueLength := database.get(offset + 2usize).usize;
    valid := (active == 0u8 || active == 1u8)
        && keyLength <= _keyCapacity && valueLength <= _valueCapacity
        && (active == 0u8 || keyLength > 0usize);
    when (!valid) {
        return(false);
    };
    return(database._validateRecords(index + 1usize));
};

validateDatabase :: Buffer<UInt8> -> Bool := (database) ->
    #database == _databaseSize
        && database.get(0usize) == 'M' && database.get(1usize) == 'A'
        && database.get(2usize) == 'L' && database.get(3usize) == 'D'
        && database.get(4usize) == 1u8 && database.get(5usize) == 64u8
        && database._validateRecords(0usize);

_prefixEquals :: (Buffer<UInt8>, USize, Buffer<UInt8>, USize, USize) -> Bool :=
    (left, leftStart, right, rightStart, length) -> [return] => {
        when (length == 0usize) {
            return(true);
        };
        when (left.get(leftStart) != right.get(rightStart)) {
            return(false);
        };
        return(left._prefixEquals(leftStart + 1usize, right, rightStart + 1usize, length - 1usize));
    };

_findRecord :: (Buffer<UInt8>, Buffer<UInt8>, USize, USize, USize) -> USize :=
    (database, key, start, length, index) -> [return] => {
        when (index == _recordCount) {
            return(_recordCount);
        };
        offset := _headerSize + index * _recordSize;
        matches := database.get(offset) == 1u8
            && database.get(offset + 1usize).usize == length
            && database._prefixEquals(offset + 8usize, key, start, length);
        when (matches) {
            return(index);
        };
        return(database._findRecord(key, start, length, index + 1usize));
    };

_findFreeRecord :: (Buffer<UInt8>, USize) -> USize := (database, index) -> [return] => {
    when (index == _recordCount) {
        return(_recordCount);
    };
    when (database.get(_headerSize + index * _recordSize) == 0u8) {
        return(index);
    };
    return(database._findFreeRecord(index + 1usize));
};

putRecord :: (Database, Buffer<UInt8>, USize, USize, USize, USize) -> PutResult :=
    ((_, database), line, keyStart, keyLength, valueStart, valueLength) -> [stored, invalid, full] => {
        when (keyLength == 0usize || keyLength > _keyCapacity || valueLength > _valueCapacity) {
            invalid();
        };
        existing := database._findRecord(line, keyStart, keyLength, 0usize);
        slot := if (existing == _recordCount)
            then database._findFreeRecord(0usize)
            else existing;
        when (slot == _recordCount) {
            full();
        };
        offset := _headerSize + slot * _recordSize;
        database.put(offset + 1usize, keyLength.u8);
        database.put(offset + 2usize, valueLength.u8);
        line.copyRange(keyStart, database, offset + 8usize, keyLength);
        line.copyRange(valueStart, database, offset + 24usize, valueLength);
        // Publish the record only after its lengths and payload bytes are complete.
        database.put(offset, 1u8);
        stored();
    };

lookupRecord :: (Database, Buffer<UInt8>, USize, USize) -> LookupResult :=
    ((_, database), line, keyStart, keyLength) -> [absent, found] => {
        slot := database._findRecord(line, keyStart, keyLength, 0usize);
        when (slot == _recordCount) {
            absent();
        };
        offset := _headerSize + slot * _recordSize;
        valueLength := database.get(offset + 2usize).usize;
        found(database.copySlice(offset + 24usize, valueLength));
    };

deleteRecord :: (Database, Buffer<UInt8>, USize, USize) -> Bool :=
    ((_, database), line, keyStart, keyLength) -> {
        slot := database._findRecord(line, keyStart, keyLength, 0usize);
        if (slot == _recordCount)
        then false
        else {
            database.put(_headerSize + slot * _recordSize, 0u8);
            true;
        };
    };
