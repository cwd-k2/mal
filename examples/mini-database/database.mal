require "./host.mal";

_databaseSize :: UInt64 := 4112u64;
_databaseReadCapacity :: UInt64 := 4113u64;
_headerSize :: UInt64 := 16u64;
_recordSize :: UInt64 := 64u64;
_recordCount :: UInt64 := 64u64;
_keyCapacity :: UInt64 := 16u64;
_valueCapacity :: UInt64 := 40u64;
_queryStorageSize :: UInt64 := 257u64;
_inputStorageSize :: UInt64 := 4096u64;

_readFileToCapacity :: (File, Buffer) -> Buffer := \(file :: File, buffer :: Buffer) {
    (memory, capacity, length) := buffer;
    if (length == capacity)
    then { buffer }
    else {
        transferred := extern readFile(file, (memory + length, capacity - length));
        if (transferred == 0u64)
        then { buffer }
        else { _readFileToCapacity(file, (memory, capacity, length + transferred)) };
    };
};

_initializedBytes :: Buffer -> Bytes := \(buffer :: Buffer) {
    (memory, _, length) := buffer;
    (memory, length);
};

_writeBytesFully :: (File, Bytes, UInt64) -> Unit :=
    \(file :: File, bytes :: Bytes, written :: UInt64) {
        (memory, length) := bytes;
        if (written == length)
        then { () }
        else {
            transferred := extern writeFile(file, (memory + written, length - written));
            if (transferred == 0u64)
            then {
                extern fail("file write made no progress");
                ();
            }
            else { _writeBytesFully(file, bytes, written + transferred) };
        };
    };

_saveDatabase :: (File, Buffer) -> Unit := \(file :: File, database :: Buffer) {
    extern rewindFile(file);
    _writeBytesFully(file, _initializedBytes(database), 0u64);
    extern flushFile(file);
};

_readByte :: Reader -> ByteRead := \(reader :: Reader) {
    (file, buffer, position) := reader;
    (memory, capacity, length) := buffer;
    if (position < length)
    then {
        byte := loadUInt8(memory + position);
        ByteRead[1](((file, buffer, position + 1u64), byte));
    }
    else {
        transferred := extern readFile(file, (memory, capacity));
        filled := (memory, capacity, transferred);
        next := (file, filled, 0u64);
        if (transferred == 0u64)
        then { ByteRead[0](next) }
        else {
            byte := loadUInt8(memory);
            ByteRead[1](((file, filled, 1u64), byte));
        };
    };
};

_readLineAt :: (Reader, Buffer) -> LineRead := \(reader :: Reader, buffer :: Buffer) {
    (line, capacity, length) := buffer;
    result := _readByte(reader);
    case (result)
    [0](next) {
        if (length == 0u64)
        then { LineRead[0](next) }
        else { LineRead[1]((next, buffer)) };
    }
    [1](read) {
        (next, byte) := read;
        if (byte == '\n')
        then {
            if (length > 0u64 && loadUInt8(line + length - 1u64) == '\r')
            then { LineRead[1]((next, (line, capacity, length - 1u64))) }
            else { LineRead[1]((next, buffer)) };
        }
        else {
            if (length + 1u64 == capacity)
            then {
                extern fail("query line exceeds its buffer");
                LineRead[1]((next, buffer));
            }
            else {
                storeUInt8(line + length, byte);
                _readLineAt(next, (line, capacity, length + 1u64));
            };
        };
    };
};

_readLine :: (Reader, Buffer) -> LineRead := \(reader :: Reader, buffer :: Buffer) {
    (line, capacity, _) := buffer;
    _readLineAt(reader, (line, capacity, 0u64));
};

_clearBytes :: (Ptr, UInt64) -> Unit := \(memory :: Ptr, remaining :: UInt64) {
    if (remaining == 0u64)
    then { () }
    else {
        storeUInt8(memory, 0u8);
        _clearBytes(memory + 1u64, remaining - 1u64);
    };
};

_initializeDatabase :: Buffer -> Buffer := \(buffer :: Buffer) {
    (memory, capacity, _) := buffer;
    _clearBytes(memory, _databaseSize);
    storeUInt8(memory, 'M');
    storeUInt8(memory + 1u64, 'A');
    storeUInt8(memory + 2u64, 'L');
    storeUInt8(memory + 3u64, 'D');
    storeUInt8(memory + 4u64, 1u8);
    storeUInt8(memory + 5u64, 64u8);
    (memory, capacity, _databaseSize);
};

_recordAt :: (Ptr, UInt64) -> Ptr := \(database :: Ptr, index :: UInt64) {
    database + _headerSize + index * _recordSize;
};

_validateRecords :: (Ptr, UInt64) -> Bool := \(database :: Ptr, index :: UInt64) {
    if (index == _recordCount)
    then { true }
    else {
        record := _recordAt(database, index);
        active := loadUInt8(record);
        keyLength := UInt64(loadUInt8(record + 1u64));
        valueLength := UInt64(loadUInt8(record + 2u64));
        valid := (active == 0u8 || active == 1u8)
            && keyLength <= _keyCapacity
            && valueLength <= _valueCapacity
            && (active == 0u8 || keyLength > 0u64);
        valid && _validateRecords(database, index + 1u64);
    };
};

_validateDatabase :: Buffer -> Bool := \(buffer :: Buffer) {
    (database, _, length) := buffer;
    length == _databaseSize
        && loadUInt8(database) == 'M'
        && loadUInt8(database + 1u64) == 'A'
        && loadUInt8(database + 2u64) == 'L'
        && loadUInt8(database + 3u64) == 'D'
        && loadUInt8(database + 4u64) == 1u8
        && loadUInt8(database + 5u64) == 64u8
        && _validateRecords(database, 0u64);
};

_rangeEqualsAt :: (Ptr, UInt64, Symbol, UInt64) -> Bool :=
    \(source :: Ptr, start :: UInt64, expected :: Symbol, index :: UInt64) {
        if (index == #expected)
        then { true }
        else {
            loadUInt8(source + start + index) == expected # index
                && _rangeEqualsAt(source, start, expected, index + 1u64);
        };
    };

_rangeEquals :: (Ptr, UInt64, UInt64, UInt64, Symbol) -> Bool :=
    \(source :: Ptr, sourceLength :: UInt64, start :: UInt64, length :: UInt64, expected :: Symbol) {
        length == #expected
            && start + length <= sourceLength
            && _rangeEqualsAt(source, start, expected, 0u64);
    };

_findByte :: (Ptr, UInt64, UInt64, UInt8) -> UInt64 :=
    \(source :: Ptr, length :: UInt64, index :: UInt64, byte :: UInt8) {
        if (index == length)
        then { index }
        else {
            if (loadUInt8(source + index) == byte)
            then { index }
            else { _findByte(source, length, index + 1u64, byte) };
        };
    };

_memoryEqualsAt :: (Ptr, Ptr, UInt64, UInt64, UInt64) -> Bool :=
    \(memory :: Ptr, source :: Ptr, start :: UInt64, length :: UInt64, index :: UInt64) {
        if (index == length)
        then { true }
        else {
            loadUInt8(memory + index) == loadUInt8(source + start + index)
                && _memoryEqualsAt(memory, source, start, length, index + 1u64);
        };
    };

_findRecord :: (Ptr, Ptr, UInt64, UInt64, UInt64) -> UInt64 :=
    \(database :: Ptr, key :: Ptr, start :: UInt64, length :: UInt64, index :: UInt64) {
        if (index == _recordCount)
        then { _recordCount }
        else {
            record := _recordAt(database, index);
            matches := loadUInt8(record) == 1u8
                && UInt64(loadUInt8(record + 1u64)) == length
                && _memoryEqualsAt(record + 8u64, key, start, length, 0u64);
            if (matches)
            then { index }
            else { _findRecord(database, key, start, length, index + 1u64) };
        };
    };

_findFreeRecord :: (Ptr, UInt64) -> UInt64 := \(database :: Ptr, index :: UInt64) {
    if (index == _recordCount)
    then { _recordCount }
    else {
        if (loadUInt8(_recordAt(database, index)) == 0u8)
        then { index }
        else { _findFreeRecord(database, index + 1u64) };
    };
};

_copyRange :: (Ptr, UInt64, Ptr, UInt64) -> Unit :=
    \(source :: Ptr, start :: UInt64, destination :: Ptr, remaining :: UInt64) {
        if (remaining == 0u64)
        then { () }
        else {
            storeUInt8(destination, loadUInt8(source + start));
            _copyRange(source, start + 1u64, destination + 1u64, remaining - 1u64);
        };
    };

_writeResponse :: Symbol -> Unit := \(response :: Symbol) {
    extern writeSymbol(response);
};

_putRecord :: (File, Buffer, Bytes, UInt64, UInt64, UInt64, UInt64) -> Unit :=
    \(file :: File, databaseBuffer :: Buffer, lineBytes :: Bytes, keyStart :: UInt64, keyLength :: UInt64, valueStart :: UInt64, valueLength :: UInt64) {
        (database, _, _) := databaseBuffer;
        (line, _) := lineBytes;
        if (keyLength == 0u64 || keyLength > _keyCapacity || valueLength > _valueCapacity)
        then { _writeResponse("ERROR key<=16 value<=40\n") }
        else {
            existing := _findRecord(database, line, keyStart, keyLength, 0u64);
            slot := if (existing == _recordCount)
                then { _findFreeRecord(database, 0u64) }
                else { existing };
            if (slot == _recordCount)
            then { _writeResponse("ERROR database full\n") }
            else {
                record := _recordAt(database, slot);
                storeUInt8(record + 1u64, UInt8(keyLength));
                storeUInt8(record + 2u64, UInt8(valueLength));
                _copyRange(line, keyStart, record + 8u64, keyLength);
                _copyRange(line, valueStart, record + 24u64, valueLength);
                storeUInt8(record, 1u8);
                _saveDatabase(file, databaseBuffer);
                _writeResponse("OK\n");
            };
        };
    };

_getRecord :: (Buffer, Bytes, UInt64, UInt64) -> Unit :=
    \(databaseBuffer :: Buffer, lineBytes :: Bytes, keyStart :: UInt64, keyLength :: UInt64) {
        (database, _, _) := databaseBuffer;
        (line, _) := lineBytes;
        slot := _findRecord(database, line, keyStart, keyLength, 0u64);
        if (slot == _recordCount)
        then { _writeResponse("NOT FOUND\n") }
        else {
            record := _recordAt(database, slot);
            valueLength := UInt64(loadUInt8(record + 2u64));
            extern writeSymbol("VALUE ");
            extern writeBytes((record + 24u64, valueLength));
            extern writeSymbol("\n");
            ();
        };
    };

_deleteRecord :: (File, Buffer, Bytes, UInt64, UInt64) -> Unit :=
    \(file :: File, databaseBuffer :: Buffer, lineBytes :: Bytes, keyStart :: UInt64, keyLength :: UInt64) {
        (database, _, _) := databaseBuffer;
        (line, _) := lineBytes;
        slot := _findRecord(database, line, keyStart, keyLength, 0u64);
        if (slot == _recordCount)
        then { _writeResponse("NOT FOUND\n") }
        else {
            storeUInt8(_recordAt(database, slot), 0u8);
            _saveDatabase(file, databaseBuffer);
            _writeResponse("OK\n");
        };
    };

_handleQuery :: (File, Buffer, Bytes) -> Unit := \(file :: File, database :: Buffer, lineBytes :: Bytes) {
    (line, length) := lineBytes;
    if (length >= 4u64 && _rangeEquals(line, length, 0u64, 4u64, "get "))
    then {
        keyLength := length - 4u64;
        extraSpace := _findByte(line, length, 4u64, ' ');
        if (keyLength == 0u64 || extraSpace != length)
        then { _writeResponse("ERROR usage: get KEY\n") }
        else { _getRecord(database, lineBytes, 4u64, keyLength) };
    }
    else {
        if (length >= 4u64 && _rangeEquals(line, length, 0u64, 4u64, "del "))
        then {
            keyLength := length - 4u64;
            extraSpace := _findByte(line, length, 4u64, ' ');
            if (keyLength == 0u64 || extraSpace != length)
            then { _writeResponse("ERROR usage: del KEY\n") }
            else { _deleteRecord(file, database, lineBytes, 4u64, keyLength) };
        }
        else {
            if (length >= 4u64 && _rangeEquals(line, length, 0u64, 4u64, "put "))
            then {
                separator := _findByte(line, length, 4u64, ' ');
                if (separator == length || separator == 4u64)
                then { _writeResponse("ERROR usage: put KEY VALUE\n") }
                else {
                    _putRecord(
                        file,
                        database,
                        lineBytes,
                        4u64,
                        separator - 4u64,
                        separator + 1u64,
                        length - separator - 1u64
                    );
                };
            }
            else { _writeResponse("ERROR commands: put/get/del/quit\n") };
        };
    };
};

_runQueries :: (Reader, File, Buffer, Buffer) -> Unit :=
    \(reader :: Reader, file :: File, database :: Buffer, query :: Buffer) {
        result := _readLine(reader, query);
        case (result)
        [0](_) { () }
        [1](state) {
            (next, lineBuffer) := state;
            lineBytes := _initializedBytes(lineBuffer);
            (line, length) := lineBytes;
            if (length == 0u64 || _rangeEquals(line, length, 0u64, length, "quit"))
            then { () }
            else {
                _handleQuery(file, database, lineBytes);
                _runQueries(next, file, database, query);
            };
        };
    };

executeDatabase :: Symbol -> Int32 := \(path :: Symbol) {
    allocator := extern createAllocator();
    file := extern openReadWriteCreate(path);
    input := extern standardInput();
    databaseStorage := extern allocateBuffer(allocator, _databaseReadCapacity);
    query := extern allocateBuffer(allocator, _queryStorageSize);
    inputBuffer := extern allocateBuffer(allocator, _inputStorageSize);
    loadedDatabase := _readFileToCapacity(file, databaseStorage);
    (_, _, loaded) := loadedDatabase;
    database := if (loaded == 0u64)
        then { _initializeDatabase(loadedDatabase) }
        else {
            if (!_validateDatabase(loadedDatabase))
            then {
                extern fail("invalid database file");
                loadedDatabase;
            }
            else { loadedDatabase };
        };
    _runQueries((input, inputBuffer, 0u64), file, database, query);
    extern closeFile(file);
    extern destroyAllocator(allocator);
    0;
};
