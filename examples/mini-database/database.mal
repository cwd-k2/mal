require "./host.mal";
require "./bytes.mal";

databaseReadCapacity :: USize := 4113usize;

// One byte beyond the file size lets validation distinguish a complete file from an oversized one.
_databaseSize :: USize := 4112usize;
_headerSize :: USize := 16usize;
_recordSize :: USize := 64usize;
_recordCount :: USize := 64usize;
_keyCapacity :: USize := 16usize;
_valueCapacity :: USize := 40usize;

// File bytes are a 16-byte header followed by 64 records of 64 bytes.
// Record offsets are 0 active, 1 key length, 2 value length, 8 key, and 24 value.

// PutResult variants are 0 stored, 1 invalid input, and 2 full storage.
PutResult :: [Unit, Unit, Unit];
// LookupResult variant 0 means absent; variant 1 carries the value bytes.
LookupResult :: [Unit, Packed<UInt8>];

// Fill the buffer until it reaches capacity or the file reports EOF.
readDatabaseFile :: (File, ByteBuffer) -> ByteBuffer := (file, buffer) -> [return] => {
    (memory, capacity, length) := buffer;
    when (length == capacity) {
        return(buffer);
    };

    transferred := file.readFile((memory + length.bytes, capacity - length));
    when (transferred == 0usize) {
        return(buffer);
    };

    return(file.readDatabaseFile((memory, capacity, length + transferred)));
};

_writeBytesFully :: (File, ReadableBytes, USize) -> Unit :=
    (file, bytes, written) -> [return] => {
        (memory, length) := bytes;
        when (written == length) {
            return(());
        };

        transferred := file.writeFile((memory + written.bytes, length - written));
        when (transferred == 0usize) {
            fail("file write made no progress");
            return(());
        };

        return(file._writeBytesFully(bytes, written + transferred));
    };

saveDatabase :: (File, ByteBuffer) -> Unit := (file, database) -> {
    (memory, _, length) := database;
    file.rewindFile();
    file._writeBytesFully((memory, length), 0usize);
    file.flushFile();
};

initializeDatabase :: ByteBuffer -> ByteBuffer := (buffer) -> {
    (memory, capacity, _) := buffer;

    // Clear record storage before publishing the header magic and format version.
    memory.view<UInt8>(0usize, _databaseSize, (database) -> {
        database.clearBytes();
        database.put(0usize, 'M');
        database.put(1usize, 'A');
        database.put(2usize, 'L');
        database.put(3usize, 'D');
        database.put(4usize, 1u8);
        database.put(5usize, 64u8);
    });
    (memory, capacity, _databaseSize);
};

_recordAddress :: (Address, USize) -> Address := (database, index) ->
    database + (_headerSize + index * _recordSize).bytes;

// Fixed-layout record scans pass the borrowed database Region directly. A generic predicate closure
// could not capture that scoped authority, while these helpers also give callers domain result names.
_validateRecords :: (Region<UInt8>, USize) -> Bool := (database, index) -> [return] => {
    when (index == _recordCount) {
        return(true);
    };

    record := (database % (_headerSize + index * _recordSize)) / _recordSize;
    active := record.get(0usize);
    keyLength := record.get(1usize).usize;
    valueLength := record.get(2usize).usize;
    valid := (active == 0u8 || active == 1u8)
        && keyLength <= _keyCapacity
        && valueLength <= _valueCapacity
        && (active == 0u8 || keyLength > 0usize);
    when (!valid) {
        return(false);
    };

    return(database._validateRecords(index + 1usize));
};

validateDatabase :: ByteBuffer -> Bool := (buffer) -> [return] => {
    (memory, _, length) := buffer;
    when (length != _databaseSize) {
        return(false);
    };

    // Validation only observes the borrowed file buffer, so it does not create an owned copy.
    return(memory.view<UInt8>(0usize, length, (database) ->
        database.get(0usize) == 'M'
            && database.get(1usize) == 'A'
            && database.get(2usize) == 'L'
            && database.get(3usize) == 'D'
            && database.get(4usize) == 1u8
            && database.get(5usize) == 64u8
            && database._validateRecords(0usize)
    ));
};

_regionPrefixEquals :: (Region<UInt8>, Packed<UInt8>, USize) -> Bool :=
    (left, right, length) -> [return] => {
        when (length == 0usize) {
            return(true);
        };
        when (left.get(0usize) != right # 0usize) {
            return(false);
        };

        return((left % 1usize)._regionPrefixEquals(right % 1usize, length - 1usize));
    };

// The record count is the not-found coordinate, so search never invents a second sentinel space.
_findRecord :: (Region<UInt8>, Packed<UInt8>, USize, USize, USize) -> USize :=
    (database, key, start, length, index) -> [return] => {
        when (index == _recordCount) {
            return(_recordCount);
        };

        record := database % (_headerSize + index * _recordSize);
        matches := record.get(0usize) == 1u8
            && record.get(1usize).usize == length
            && (record % 8usize)._regionPrefixEquals(key % start, length);
        when (matches) {
            return(index);
        };

        return(database._findRecord(key, start, length, index + 1usize));
    };

// Free-slot search shares the same end coordinate but has a different row predicate from key lookup.
_findFreeRecord :: (Region<UInt8>, USize) -> USize := (database, index) -> [return] => {
    when (index == _recordCount) {
        return(_recordCount);
    };
    recordOffset := _headerSize + index * _recordSize;
    when (database.get(recordOffset) == 0u8) {
        return(index);
    };

    return(database._findFreeRecord(index + 1usize));
};

putRecord :: (ByteBuffer, Packed<UInt8>, USize, USize, USize, USize) -> PutResult :=
    (databaseBuffer, line, keyStart, keyLength, valueStart, valueLength) -> [stored, invalid, full] => {
        (memory, _, length) := databaseBuffer;
        when (keyLength == 0usize || keyLength > _keyCapacity || valueLength > _valueCapacity) {
            invalid();
        };

        slot := memory.view<UInt8>(0usize, length, (database) -> {
            existing := database._findRecord(line, keyStart, keyLength, 0usize);
            if (existing == _recordCount)
            then database._findFreeRecord(0usize)
            else existing;
        });
        when (slot == _recordCount) {
            full();
        };

        // recordAddress identifies the selected fixed-size slot; its active byte is published last.
        recordAddress := memory._recordAddress(slot);
        recordAddress.view<UInt8>(0usize, _recordSize, (record) -> {
            record.put(1usize, keyLength.u8);
            record.put(2usize, valueLength.u8);
            (line % keyStart).copyPrefix(record % 8usize, keyLength);
            (line % valueStart).copyPrefix(record % 24usize, valueLength);
            record.put(0usize, 1u8);
        });
        stored();
    };

lookupRecord :: (ByteBuffer, Packed<UInt8>, USize, USize) -> LookupResult :=
    (databaseBuffer, line, keyStart, keyLength) -> [absent, found] => {
        (memory, _, length) := databaseBuffer;
        (slot, valueLength) := memory.view<UInt8>(0usize, length, (database) -> {
            foundSlot := database._findRecord(line, keyStart, keyLength, 0usize);
            foundLength := if (foundSlot == _recordCount)
                then 0usize
                else {
                    record := database % (_headerSize + foundSlot * _recordSize);
                    record.get(2usize).usize;
                };
            (foundSlot, foundLength);
        });
        when (slot == _recordCount) {
            absent();
        };

        // Only the value crosses the borrow boundary, so only that range becomes owned.
        valueStart := _headerSize + slot * _recordSize + 24usize;
        found(memory.pack<UInt8>(valueStart, valueStart + valueLength));
    };

deleteRecord :: (ByteBuffer, Packed<UInt8>, USize, USize) -> Bool :=
    (databaseBuffer, line, keyStart, keyLength) -> [return] => {
        (memory, _, length) := databaseBuffer;
        slot := memory.view<UInt8>(0usize, length, (database) ->
            database._findRecord(line, keyStart, keyLength, 0usize)
        );
        when (slot == _recordCount) {
            return(false);
        };

        recordAddress := memory._recordAddress(slot);
        recordAddress.view<UInt8>(0usize, 1usize, (record) -> record.put(0usize, 0u8));
        return(true);
    };
