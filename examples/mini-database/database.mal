require "./host.mal";
require "./bytes.mal";

databaseReadCapacity :: USize := 4113usize;

// One byte beyond the file size lets validation distinguish a complete file from an oversized one.
_databaseSize :: USize := 4112usize;
_headerSize :: USize := 16usize;
_recordSize :: USize := 64usize;
_recordCount :: USize := 64usize;
_keyCapacity :: USize := 16usize;
_valueCapacity :: USize := 40usize;

// File bytes are a 16-byte header followed by 64 records of 64 bytes.
// Record offsets are 0 active, 1 key length, 2 value length, 8 key, and 24 value.

// PutResult variants are 0 stored, 1 invalid input, and 2 full storage.
PutResult :: [Unit, Unit, Unit];
// LookupResult variant 0 means absent; variant 1 carries value memory and length.
LookupResult :: [Unit, Region<UInt8>];

// Fill the buffer until it reaches capacity or the file reports EOF.
readDatabaseFile :: (File, ByteBuffer) -> ByteBuffer := (file, buffer) -> [return] => {
    (memory, capacity, length) := buffer;
    when (length == capacity) {
        return(buffer);
    };

    transferred := file.readFile((memory + length.bytes, capacity - length));
    when (transferred == 0usize) {
        return(buffer);
    };

    return(file.readDatabaseFile((memory, capacity, length + transferred)));
};

_writeBytesFully :: (File, ReadableBytes, USize) -> Unit :=
    (file, bytes, written) -> [return] => {
        (memory, length) := bytes;
        when (written == length) {
            return(());
        };

        transferred := file.writeFile((memory + written.bytes, length - written));
        when (transferred == 0usize) {
            fail("file write made no progress");
            return(());
        };

        return(file._writeBytesFully(bytes, written + transferred));
    };

saveDatabase :: (File, ByteBuffer) -> Unit := (file, database) -> {
    file.rewindFile();
    file._writeBytesFully(database.initializedBytes(), 0usize);
    file.flushFile();
};

initializeDatabase :: ByteBuffer -> ByteBuffer := (buffer) -> {
    (memory, capacity, _) := buffer;

    // Clear record storage before publishing the header magic and format version.
    memory.clearBytes(_databaseSize);
    memory.writeByte('M');
    (memory + 1bytes).writeByte('A');
    (memory + 2bytes).writeByte('L');
    (memory + 3bytes).writeByte('D');
    (memory + 4bytes).writeByte(1u8);
    (memory + 5bytes).writeByte(64u8);
    (memory, capacity, _databaseSize);
};

_recordAt :: (Address, USize) -> Address := (database, index) ->
    database + (_headerSize + index * _recordSize).bytes;

_validateRecords :: (Address, USize) -> Bool := (database, index) -> [return] => {
    when (index == _recordCount) {
        return(true);
    };

    record := database._recordAt(index);
    active := record.readByte();
    keyLength := (record + 1bytes).readByte().usize;
    valueLength := (record + 2bytes).readByte().usize;
    valid := (active == 0u8 || active == 1u8)
        && keyLength <= _keyCapacity
        && valueLength <= _valueCapacity
        && (active == 0u8 || keyLength > 0usize);
    when (!valid) {
        return(false);
    };

    return(database._validateRecords(index + 1usize));
};

validateDatabase :: ByteBuffer -> Bool := (buffer) -> {
    (database, _, length) := buffer;

    // Validate fixed header fields before walking any record metadata.
    length == _databaseSize
        && database.readByte() == 'M'
        && (database + 1bytes).readByte() == 'A'
        && (database + 2bytes).readByte() == 'L'
        && (database + 3bytes).readByte() == 'D'
        && (database + 4bytes).readByte() == 1u8
        && (database + 5bytes).readByte() == 64u8
        && database._validateRecords(0usize);
};

_findRecord :: (Address, Packed<UInt8>, USize, USize, USize) -> USize :=
    (database, key, start, length, index) -> [return] => {
        when (index == _recordCount) {
            return(_recordCount);
        };

        record := database._recordAt(index);
        matches := record.readByte() == 1u8
            && (record + 1bytes).readByte().usize == length
            && (record + 8bytes).memoryEqualsAt(key, start, length, 0usize);
        when (matches) {
            return(index);
        };

        return(database._findRecord(key, start, length, index + 1usize));
    };

_findFreeRecord :: (Address, USize) -> USize := (database, index) -> [return] => {
    when (index == _recordCount) {
        return(_recordCount);
    };
    when (database._recordAt(index).readByte() == 0u8) {
        return(index);
    };

    return(database._findFreeRecord(index + 1usize));
};

putRecord :: (ByteBuffer, Packed<UInt8>, USize, USize, USize, USize) -> PutResult :=
    (databaseBuffer, lineBytes, keyStart, keyLength, valueStart, valueLength) -> [stored, invalid, full] => {
        (database, _, _) := databaseBuffer;
        when (keyLength == 0usize || keyLength > _keyCapacity || valueLength > _valueCapacity) {
            invalid();
        };

        existing := database._findRecord(lineBytes, keyStart, keyLength, 0usize);
        slot := if (existing == _recordCount)
            then database._findFreeRecord(0usize)
            else existing;
        when (slot == _recordCount) {
            full();
        };

        // Write payload lengths and bytes before marking the slot active.
        record := database._recordAt(slot);
        (record + 1bytes).writeByte(keyLength.u8);
        (record + 2bytes).writeByte(valueLength.u8);
        lineBytes.copyRange(keyStart, record + 8bytes, keyLength);
        lineBytes.copyRange(valueStart, record + 24bytes, valueLength);
        record.writeByte(1u8);
        stored();
    };

lookupRecord :: (ByteBuffer, Packed<UInt8>, USize, USize) -> LookupResult :=
    (databaseBuffer, lineBytes, keyStart, keyLength) -> [absent, found] => {
        (database, _, _) := databaseBuffer;
        slot := database._findRecord(lineBytes, keyStart, keyLength, 0usize);
        when (slot == _recordCount) {
            absent();
        };

        record := database._recordAt(slot);
        valueLength := (record + 2bytes).readByte().usize;
        found((record + 24bytes)@u8@valueLength);
    };

deleteRecord :: (ByteBuffer, Packed<UInt8>, USize, USize) -> Bool :=
    (databaseBuffer, lineBytes, keyStart, keyLength) -> [return] => {
        (database, _, _) := databaseBuffer;
        slot := database._findRecord(lineBytes, keyStart, keyLength, 0usize);
        when (slot == _recordCount) {
            return(false);
        };

        database._recordAt(slot).writeByte(0u8);
        return(true);
    };
