require "./host.c";

extern allocate :: UInt64 -> Ptr;
extern release :: Ptr -> Unit;

// Node bytes are Int32 value, UInt8 tag, then two Ptr fields for tag 1.
// Tag 0 is a 5-byte leaf; tag 1 stores left and right at offsets 5 and 5 + Ptr.size.
leaf :: Int32 -> Ptr := \(value) {
    node := allocate(5u64);
    Int32.store(node, value);
    UInt8.store(node + 4u64, 0u8);
    node;
};

branch :: (Int32, Ptr, Ptr) -> Ptr := \(value, left, right) {
    node := allocate(5u64 + Ptr.size * 2u64);
    Int32.store(node, value);
    UInt8.store(node + 4u64, 1u8);
    Ptr.store(node + 5u64, left);
    Ptr.store(node + 5u64 + Ptr.size, right);
    node;
};

sumTree :: Ptr -> Int32 := \(node) {
    value := Int32.load(node);
    isBranch := UInt8.load(node + 4u64);
    if (isBranch == 0u8)
    then { value }
    else {
        left := Ptr.load(node + 5u64);
        right := Ptr.load(node + 5u64 + Ptr.size);
        value + sumTree(left) + sumTree(right);
    };
};

destroyTree :: Ptr -> Unit := \(node) {
    isBranch := UInt8.load(node + 4u64);
    if (isBranch == 0u8)
    then { release(node) }
    else {
        left := Ptr.load(node + 5u64);
        right := Ptr.load(node + 5u64 + Ptr.size);
        destroyTree(left);
        destroyTree(right);
        release(node);
    };
};

main :: Unit -> Int32 := \() {
    left := branch(2, leaf(3), leaf(4));
    tree := branch(1, left, leaf(5));
    total := sumTree(tree);
    destroyTree(tree);
    total - 15;
};
