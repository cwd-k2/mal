sumTo :: (Int64, Int64) -> Int64 := \(remaining :: Int64, total :: Int64) {
    return if (remaining == 0) then {
        total
    } else {
        sumTo(remaining - 1, total + remaining)
    };
};

main :: Unit -> Int32 := \() {
    result := sumTo(1_000_000Int64, 0);
    return if (result == 500_000_500_000Int64) then { 0 } else { 1 };
};
