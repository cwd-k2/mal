// CellRow fields: formula kind, literal value, left source, right source.
// Kinds are 0 literal, 1 sum, and 2 product.
CellRow :: (UInt8, Int64, USize, USize);
// CellRows is the row-major physical carrier; source coordinates give formula rows their dependency edges.
CellRows :: Buffer<CellRow>;
// SheetImage fields: row count, column count, and row-major cell carrier.
SheetImage :: (USize, USize, CellRows);

buildSheet :: Unit -> SheetImage := () -> {
    cells := make<CellRow>(6usize);
    // A1 = 10, B1 = 20, C1 = A1 + B1.
    cells.new((0u8, 10i64, 0usize, 0usize));
    cells.new((0u8, 20i64, 0usize, 0usize));
    cells.new((1u8, 0i64, 0usize, 1usize));
    // A2 = B1 + C1, B2 = 2, C2 = A2 * B2.
    cells.new((1u8, 0i64, 1usize, 2usize));
    cells.new((0u8, 2i64, 0usize, 0usize));
    cells.new((2u8, 0i64, 3usize, 4usize));
    (2usize, 3usize, cells);
};

// A formula row that references itself or a later row is a well-typed CellRow in a well-shaped
// CellRows; only validSheet distinguishes it from an admissible dependency graph.
buildCyclicSheet :: Unit -> SheetImage := () -> {
    cells := make<CellRow>(1usize);
    cells.new((1u8, 0i64, 0usize, 0usize));
    (1usize, 1usize, cells);
};

// Admission follows physical row order so an earlier coordinate is proof of an acyclic dependency.
_validCellRows :: (CellRows, USize) -> Bool := (cells, index) -> [return] => {
    when (index == #cells) {
        return(true);
    };
    (kind, _, left, right) := cells.get(index);
    when (kind > 2u8) {
        return(false);
    };
    formula := kind == 1u8 || kind == 2u8;
    when (formula && (left >= index || right >= index)) {
        return(false);
    };
    return(cells._validCellRows(index + 1usize));
};

validSheet :: SheetImage -> Bool := (sheet) -> {
    (rows, columns, cells) := sheet;
    rows * columns == #cells && cells._validCellRows(0usize);
};

_cellIndex :: (SheetImage, USize, USize) -> USize := (sheet, row, column) -> {
    (_, columns, _) := sheet;
    row * columns + column;
};

// Evaluation remains structural recursion: a formula combines two results after both dependency
// calls return, so it is not a cursor-only loop edge.
_evaluateAt :: (CellRows, USize) -> Int64 := (cells, index) -> [return] => {
    (kind, literal, left, right) := cells.get(index);
    when (kind == 0u8) {
        return(literal);
    };
    leftValue := cells._evaluateAt(left);
    rightValue := cells._evaluateAt(right);
    return(if (kind == 1u8)
        then leftValue + rightValue
        else leftValue * rightValue);
};

evaluateCell :: (SheetImage, USize, USize) -> Int64 := (sheet, row, column) -> {
    (_, _, cells) := sheet;
    cells._evaluateAt(sheet._cellIndex(row, column));
};

setLiteral :: (SheetImage, USize, USize, Int64) -> SheetImage :=
    (sheet, row, column, value) -> {
        (rows, columns, cells) := sheet;
        index := sheet._cellIndex(row, column);
        cells.put(index, (0u8, value, 0usize, 0usize));
        (rows, columns, cells);
    };

main :: Unit -> Int32 := () -> {
    sheet := buildSheet();
    valid := sheet.validSheet();
    initial := sheet.evaluateCell(0usize, 2usize) == 30i64
        && sheet.evaluateCell(1usize, 2usize) == 100i64;

    updated := sheet.setLiteral(0usize, 1usize, 5i64);
    // updated and sheet contain the same cell Buffer; the new name documents the next interpretation.
    recalculated := updated.validSheet()
        && updated.evaluateCell(0usize, 2usize) == 15i64
        && updated.evaluateCell(1usize, 2usize) == 40i64;

    invalidRejected := !buildCyclicSheet().validSheet();

    if (valid && initial && recalculated && invalidRejected)
    then 0
    else 1;
};
