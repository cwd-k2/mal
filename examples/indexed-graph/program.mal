require "./graph.mal";

main :: Unit -> Int32 := () -> [return] => {
    offsets := make<USize>(6usize);
    offsets.new(0usize);
    offsets.new(2usize);
    offsets.new(4usize);
    offsets.new(6usize);
    offsets.new(7usize);
    offsets.new(7usize);

    neighbors := make<USize>(7usize);
    neighbors.new(1usize);
    neighbors.new(2usize);
    neighbors.new(2usize);
    neighbors.new(3usize);
    neighbors.new(3usize);
    neighbors.new(4usize);
    neighbors.new(4usize);

    costs := make<UInt64>(7usize);
    costs.new(2u64);
    costs.new(5u64);
    costs.new(1u64);
    costs.new(2u64);
    costs.new(1u64);
    costs.new(5u64);
    costs.new(3u64);

    graph := weightedGraph(offsets, neighbors, costs)[() -> return(1), (graph) -> graph];

    // Mutation through the caller's old alias cannot change the admitted graph snapshot.
    neighbors.put(0usize, 99usize);
    invalidRejected := weightedGraph(offsets, neighbors, costs)[() -> true, (_) -> false];
    distance := graph.shortestDistance(0usize, 4usize)[() -> return(1), (value) -> value];

    if (invalidRejected && distance == 7u64)
    then return(0)
    else return(1);
};
