require "./host.c";

extern printInt32 :: Int32 -> Unit;

makeAdder :: Int32 -> (Int32 -> Int32) := \(x :: Int32) {
    \(y :: Int32) { x + y };
};

main :: Unit -> Int32 := \() {
    extern printInt32(1);
    addTen := makeAdder(10);
    extern printInt32(addTen(5));
    extern printInt32(2147483647 + 1);
    0;
};
