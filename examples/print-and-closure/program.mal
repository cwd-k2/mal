require "./host.c";

extern _printInt32 :: Int32 -> Unit;

// The result captures x as ordinary closure state; callers only observe its function type.
makeAdder :: Int32 -> (Int32 -> Int32) := (x) -> (y) -> x + y;

main :: Unit -> Int32 := () -> {
    _printInt32(1);
    addTen := makeAdder(10);
    _printInt32(addTen(5));
    _printInt32(2147483647 + 1); // Int32 arithmetic wraps before the host observes it.
    0;
};
