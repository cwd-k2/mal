require "./host.c";

extern Socket;

// Packet fields: 0 sequence number, 1 immutable payload bytes.
Packet :: (UInt64, Symbol);
// SocketPair fields: 0 sending endpoint, 1 receiving endpoint.
SocketPair :: (Socket, Socket);
// SocketStatus variant 0 means complete; variant 1 carries an errno-compatible error code.
SocketStatus :: [Unit, UInt32];
// ReceivedPacket fields: 0 sequence number, 1 payload length in the shared packet buffer.
ReceivedPacket :: (UInt64, USize);
// ReceiveResult variant 0 carries a complete packet descriptor; variant 1 carries an error code.
ReceiveResult :: [ReceivedPacket, UInt32];
// PacketBuffer fields: 0 process-owned transfer memory, 1 byte capacity.
PacketBuffer :: (Address, USize);

extern createSocketPair :: Unit -> SocketPair;
extern packetBuffer :: Unit -> PacketBuffer;
extern sendPacket :: (Socket, UInt64, Address, USize) -> SocketStatus;
extern receivePacket :: (Socket, Address, USize) -> ReceiveResult;
extern closeSocket :: Socket -> SocketStatus;
extern writeError :: UInt32 -> Unit;

_reportStatus :: SocketStatus -> Bool := (status) -> {
    status[
    () -> true,
    (error) -> {
        writeError(error);
        false;
    }
    ];
};

_isRejected :: SocketStatus -> Bool := (status) -> {
    status[() -> false, (_) -> true];
};

_socketFailure :: UInt32 -> SocketStatus := (error) -> [complete, failed] => failed(error);

_equalsSymbol :: (Buffer<UInt8>, Symbol, USize) -> Bool := (bytes, expected, index) -> [return] => {
    when (index == #expected) {
        return(true);
    };
    expectedBytes := *expected;
    when (bytes.get(index) != expectedBytes.get(index)) {
        return(false);
    };
    return(bytes._equalsSymbol(expected, index + 1usize));
};

_sendPacket :: (Socket, Packet) -> SocketStatus := (socket, packet) -> {
    (sequence, payload) := packet;
    bytes := *payload;
    (memory, capacity) := packetBuffer();
    if (#bytes > capacity)
    then _socketFailure(90u32)
    else {
        bytes.into(memory, 0usize, #bytes);
        socket.sendPacket(sequence, memory, #bytes);
    };
};

_receiveExpected :: Socket -> Bool := (socket) -> [return] => {
    (memory, capacity) := packetBuffer();
    packet := socket.receivePacket(memory, capacity)[
        (packet) -> packet,
        (error) -> {
            writeError(error);
            return(false);
        }
    ];
    (sequence, length) := packet;
    expected := "hello from mal";
    payload := from<UInt8>(memory, 0usize, length);
    return(
        sequence == 42u64
        && length == #expected
        && payload._equalsSymbol(expected, 0usize)
    );
};

main :: Unit -> Int32 := () -> {
    pair := createSocketPair();
    (sender, receiver) := pair;
    chunk := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
    oversized := chunk + chunk + chunk + chunk + "x";
    oversizedRejected :=
        sender
            ._sendPacket((0u64, oversized))
            ._isRejected();
    sent := sender._sendPacket((42u64, "hello from mal"));
    communicated := sent[
        () -> receiver._receiveExpected(),
        (error) -> {
            writeError(error);
            false;
        }
    ];
    senderClosed := sender.closeSocket()._reportStatus();
    receiverClosed := receiver.closeSocket()._reportStatus();
    if (oversizedRejected && communicated && senderClosed && receiverClosed)
    then 0
    else 1;
};
