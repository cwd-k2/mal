// NodeOffsets maps each node boundary to an edge-slot offset; adjacent offsets delimit its edges.
NodeOffsets :: Buffer<Int64>;
// NeighborNodes maps each edge slot to its destination-node coordinate.
NeighborNodes :: Buffer<Int64>;
// EdgeCosts stores the nonnegative weight joined to NeighborNodes by the shared edge slot.
EdgeCosts :: Buffer<Int64>;
// WeightedCsr carries a node count and three columns whose relation is established by validation.
WeightedCsr :: (Int64, NodeOffsets, NeighborNodes, EdgeCosts);

// Int64BufferView addresses a logical column by a buffer and its first physical slot.
Int64BufferView :: (Buffer<Int64>, USize);
// NodeDistances stores the current best distance at each node coordinate.
NodeDistances :: Int64BufferView;
// VisitedFlags stores whether each node coordinate has been finalized.
VisitedFlags :: Int64BufferView;
// DijkstraWorkspace joins independent distance and visited columns by node coordinate.
DijkstraWorkspace :: (NodeDistances, VisitedFlags);

infinity :: Int64 := 2_305_843_009_213_693_951;

// The sum separates another complete state from the independently typed result of an iteration.
_loop<A, B> :: (A, A -> [A, B]) -> B :=
    (state, step) -> step(state)[
        (nextState) -> _loop<A, B>(nextState, step),
        (result) -> result
    ];

// Validation needs both a row and its coordinate because CSR offsets relate adjacent rows.
_allIndexed<A> :: (Buffer<A>, (USize, A) -> Bool) -> Bool := (values, predicate) ->
    _loop<USize, Bool>(0usize, (index) -> [continue, break] => {
        when (index == #values) {
            break(true);
        };
        when (!predicate(index, values.get(index))) {
            break(false);
        };

        continue(index + 1usize);
    });

// Passing the destination explicitly keeps the mutation visible at every recursive step.
appendRepeated :: (Buffer<Int64>, USize, Int64) -> Unit := (buffer, remaining, value) -> {
    if (remaining == 0usize)
    then { () }
    else {
        buffer.new(value);
        buffer.appendRepeated(remaining - 1usize, value);
    };
};

at :: (Int64BufferView, Int64) -> Int64 := ((buffer, offset), index) ->
    buffer.get(offset + index.usize);

assign :: (Int64BufferView, Int64, Int64) -> Unit := ((buffer, offset), index, value) ->
    buffer.put(offset + index.usize, value);

validWeightedCsr :: WeightedCsr -> Bool := (graph) -> {
    (nodeCount, offsets, neighbors, costs) := graph;
    nodeCount > 0
        && #offsets == (nodeCount + 1).usize
        && offsets.get(0usize) == 0
        && #neighbors == #costs
        && offsets._allIndexed<Int64>((node, current) -> {
            last := node + 1usize == #offsets;
            if (last)
            then current == (#neighbors).i64
            else {
                next := offsets.get(node + 1usize);
                current >= 0 && current <= next && next <= (#neighbors).i64;
            };
        })
        && neighbors._allIndexed<Int64>((_, neighbor) -> neighbor >= 0 && neighbor < nodeCount)
        && costs._allIndexed<Int64>((_, cost) -> cost >= 0);
};

// The workspace is explicit state: both logical columns alias one managed Buffer.
selectClosest :: (DijkstraWorkspace, Int64, Int64, Int64, Int64) -> Int64 :=
    (workspace, node, nodeCount, closest, closestDistance) -> [return] => {
        when (node == nodeCount) {
            return(closest);
        };
        (distances, visited) := workspace;
        distance := distances.at(node);
        better := visited.at(node) == 0 && distance < closestDistance;
        return(workspace.selectClosest(
            node + 1,
            nodeCount,
            if (better) then { node } else { closest },
            if (better) then { distance } else { closestDistance }
        ));
    };

// Edge relaxation passes the writable workspace directly so the state transition stays visible.
relaxEdgeRange :: (WeightedCsr, DijkstraWorkspace, Int64, Int64, Int64) -> Unit :=
    (graph, workspace, sourceDistance, edge, end) -> [return] => {
        when (edge == end) {
            return(());
        };
        (_, _, neighbors, costs) := graph;
        (distances, _) := workspace;
        neighbor := neighbors.get(edge.usize);
        candidate := sourceDistance + costs.get(edge.usize);
        when (candidate < distances.at(neighbor)) {
            distances.assign(neighbor, candidate);
        };
        return(graph.relaxEdgeRange(workspace, sourceDistance, edge + 1, end));
    };

runDijkstraRounds :: (WeightedCsr, DijkstraWorkspace, Int64) -> Unit :=
    (graph, workspace, remaining) -> [return] => {
        when (remaining == 0) {
            return(());
        };
        (nodeCount, offsets, _, _) := graph;
        (distances, visited) := workspace;
        closest := workspace.selectClosest(0, nodeCount, -1, infinity);
        when (closest < 0) {
            return(());
        };
        visited.assign(closest, 1);
        graph.relaxEdgeRange(
            workspace,
            distances.at(closest),
            offsets.get(closest.usize),
            offsets.get((closest + 1).usize)
        );
        return(graph.runDijkstraRounds(workspace, remaining - 1));
    };

shortestDistance :: (WeightedCsr, Int64, Int64) -> Int64 := (graph, source, target) -> {
    (nodeCount, _, _, _) := graph;
    workspace := make<Int64>((nodeCount * 2).usize);
    workspace.appendRepeated(nodeCount.usize, infinity);
    workspace.appendRepeated(nodeCount.usize, 0);
    distances :: NodeDistances := (workspace, 0usize);
    visited :: VisitedFlags := (workspace, nodeCount.usize);
    distances.assign(source, 0);
    graph.runDijkstraRounds((distances, visited), nodeCount);
    workspace.get(target.usize);
};

buildGraph :: Unit -> WeightedCsr := () -> {
    offsets := make<Int64>(6usize);
    offsets.new(0);
    offsets.new(2);
    offsets.new(4);
    offsets.new(6);
    offsets.new(7);
    offsets.new(7);
    neighbors := make<Int64>(7usize);
    neighbors.new(1);
    neighbors.new(2);
    neighbors.new(2);
    neighbors.new(3);
    neighbors.new(3);
    neighbors.new(4);
    neighbors.new(4);
    costs := make<Int64>(7usize);
    costs.new(2);
    costs.new(5);
    costs.new(1);
    costs.new(2);
    costs.new(1);
    costs.new(5);
    costs.new(3);
    (5, offsets, neighbors, costs);
};

main :: Unit -> Int32 := () -> {
    graph := buildGraph();
    if (graph.validWeightedCsr() && graph.shortestDistance(0, 4) == 7)
    then 0
    else 1;
};
