require "./host.c";
require "./bytes.mal";

// Arguments fields: 0 argument count, 1 first external descriptor address.
Arguments :: (USize, Address);
extern InputAllocation;
// StdinBytes fields: 0 allocation authority, 1 readable memory, 2 initialized byte length.
StdinBytes :: (InputAllocation, Address, USize);
// OutputBuffer fields: 0 process-lifetime writable memory, 1 nonzero byte capacity.
OutputBuffer :: (Address, USize);

// Reads standard input into storage retained until releaseInput receives its allocation authority.
extern readStdin :: Unit -> StdinBytes;
// Releases the storage returned by readStdin after no derived view can be used again.
extern releaseInput :: InputAllocation -> Unit;
// Returns reusable process-lifetime staging storage for standard output.
extern outputBuffer :: Unit -> OutputBuffer;
// Writes an initialized prefix of the staging buffer to standard output.
extern writeBytes :: OutputBuffer -> Unit;
extern argumentLength :: Address -> USize;

// Each tail step publishes one bounded chunk before carrying the untouched suffix forward.
_writeBuffer :: (Address, USize, Buffer<UInt8>, USize) -> Unit :=
    (memory, capacity, bytes, offset) -> [return] => {
        when (offset == #bytes) {
            return(());
        };

        remainingLength := #bytes - offset;
        transferred := if (remainingLength < capacity)
            then remainingLength
            else capacity;
        bytes.into(memory, offset, transferred);
        writeBytes(memory, transferred);
        return(_writeBuffer(memory, capacity, bytes, offset + transferred));
    };

writeStdout :: Symbol -> Unit := (value) -> {
    (memory, capacity) := outputBuffer();
    _writeBuffer(memory, capacity, *value, 0usize);
};
