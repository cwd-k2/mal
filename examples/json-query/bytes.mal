// Bytes is a logical cursor that shares one managed Buffer identity.
Bytes :: (Buffer<UInt8>, USize);

byteCount :: Bytes -> USize := ((buffer, offset)) -> #buffer - offset;

byteAt :: (Bytes, USize) -> UInt8 := ((buffer, offset), index) ->
    buffer.get(offset + index);

dropBytes :: (Bytes, USize) -> Bytes := ((buffer, offset), count) ->
    (buffer, offset + count);

_startsWithAt :: (Bytes, Symbol, USize) -> Bool :=
    (source, expected, index) -> [return] => {
        when (index == #expected) {
            return(true);
        };
        when (source.byteCount() == 0usize) {
            return(false);
        };
        expectedBytes := *expected;
        when (source.byteAt(0usize) != expectedBytes.get(index)) {
            return(false);
        };
        return(source.dropBytes(1usize)._startsWithAt(expected, index + 1usize));
    };

startsWith :: (Bytes, Symbol) -> Bool := (source, expected) ->
    source._startsWithAt(expected, 0usize);

equalsSymbol :: (Bytes, Symbol) -> Bool := (source, expected) ->
    source.byteCount() == #expected && source.startsWith(expected);
