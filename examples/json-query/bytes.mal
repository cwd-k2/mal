// The shrinking source and expected-byte coordinate are the complete comparison state. This helper
// has one policy, so exposing a higher-order loop would add a callback without removing duplication.
_startsWithAt :: (Packed<UInt8>, Symbol, USize) -> Bool :=
    (source, expected, index) -> [return] => {
        when (index == #expected) {
            return(true);
        };
        when (#source == 0usize) {
            return(false);
        };

        byte := source # 0usize;
        when (byte != expected # index) {
            return(false);
        };
        return((source % 1usize)._startsWithAt(expected, index + 1usize));
    };

startsWith :: (Packed<UInt8>, Symbol) -> Bool := (source, expected) ->
    source._startsWithAt(expected, 0usize);

equalsSymbol :: (Packed<UInt8>, Symbol) -> Bool := (source, expected) ->
    #source == #expected && source.startsWith(expected);
