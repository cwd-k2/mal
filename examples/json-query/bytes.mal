// Cursor movement retains the same immutable Symbol identity.
opaque Bytes :: (Symbol, USize);

allBytes :: Symbol -> Bytes := (value) -> (value, 0usize);

byteCount :: Bytes -> USize := ((value, offset)) -> #value - offset;

byteAt :: (Bytes, USize) -> UInt8 := ((value, offset), index) -> value # (offset + index);

dropBytes :: (Bytes, USize) -> Bytes := ((value, offset), count) ->
    (value, offset + count);

_startsWithAt :: (Bytes, Symbol, USize) -> Bool :=
    (source, expected, index) -> [return] => {
        when (index == #expected) {
            return(true);
        };
        when (source.byteCount() == 0usize) {
            return(false);
        };
        when (source.byteAt(0usize) != expected # index) {
            return(false);
        };
        return(source.dropBytes(1usize)._startsWithAt(expected, index + 1usize));
    };

startsWith :: (Bytes, Symbol) -> Bool := (source, expected) ->
    source._startsWithAt(expected, 0usize);

equalsSymbol :: (Bytes, Symbol) -> Bool := (source, expected) ->
    source.byteCount() == #expected && source.startsWith(expected);
