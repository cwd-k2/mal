require "./bytes.mal";

// JsonStatistics fields: 0 JSON value count, 1 maximum value depth.
JsonStatistics :: (UInt64, UInt64);
// Variant 0 is an error message; variant 1 is the statistics for a complete document.
ParseResult :: [Symbol, JsonStatistics];
// ScanProgress carries the unread input and an empty success message or a non-empty error message.
ScanProgress :: (Bytes, Symbol);
// ParserFrame encodes the continuation selected when the parser returns to one stack coordinate.
ParserFrame :: UInt8;
// ParserFrames keeps reusable storage and a logical stack length.
ParserFrames :: (Buffer<ParserFrame>, USize);
// ParserState fields: 0 unread input, 1 return stack, 2 value depth, 3 statistics.
ParserState :: (Bytes, ParserFrames, UInt64, JsonStatistics);

// ParserState is an explicit machine configuration, so iteration can distinguish the next
// configuration from the final ParseResult without giving either one a sentinel representation.
_loop<A, B> :: (A, A -> [A, B]) -> B :=
    (state, step) -> step(state)[
        (nextState) -> _loop<A, B>(nextState, step),
        (result) -> result
    ];

_arrayFirst :: ParserFrame := 1u8;
_arrayValue :: ParserFrame := 2u8;
_arrayNext :: ParserFrame := 3u8;
_objectFirst :: ParserFrame := 4u8;
_objectKey :: ParserFrame := 5u8;
_objectColon :: ParserFrame := 6u8;
_objectValue :: ParserFrame := 7u8;
_objectNext :: ParserFrame := 8u8;
_rootValue :: ParserFrame := 9u8;
_rootDone :: ParserFrame := 10u8;

_parseFailure :: Symbol -> ParseResult := (message) -> [failure, success] => failure(message);

_parseSuccess :: JsonStatistics -> ParseResult := (stats) -> [failure, success] => success(stats);

_isWhitespace :: UInt8 -> Bool := (byte) ->
    byte == ' ' || byte == '\n' || byte == '\r' || byte == '\t';

_isDigit :: UInt8 -> Bool := (byte) -> byte >= '0' && byte <= '9';

_isNonzeroDigit :: UInt8 -> Bool := (byte) -> byte >= '1' && byte <= '9';

_isHexDigit :: UInt8 -> Bool := (byte) ->
    byte._isDigit()
        || (byte >= 'a' && byte <= 'f')
        || (byte >= 'A' && byte <= 'F');

_skipWhitespace :: Bytes -> Bytes := (source) ->
    _loop<Bytes, Bytes>(source, (remaining) -> [continue, break] => {
        when (remaining.byteCount() == 0usize) {
            break(remaining);
        };
        byte := remaining.byteAt(0usize);
        if (byte._isWhitespace())
        then continue(remaining.dropBytes(1usize))
        else break(remaining);
    });

_includeValue :: (JsonStatistics, UInt64) -> JsonStatistics := (stats, depth) -> {
    (count, maximumDepth) := stats;
    nextDepth := if (maximumDepth >= depth)
        then maximumDepth
        else depth;
    (count + 1u64, nextDepth);
};

// Returns the active continuation at the end of a nonempty return stack.
_readFrame :: ParserFrames -> ParserFrame := ((frames, count)) -> frames.get(count - 1usize);

_replaceFrame :: (ParserFrames, ParserFrame) -> ParserFrames := ((frames, count), frame) -> {
    frames.put(count - 1usize, frame);
    (frames, count);
};

_pushFrame :: (ParserFrames, ParserFrame) -> ParserFrames := ((frames, count), frame) -> {
    if (count == #frames)
    then {
        frames.new(frame);
        ();
    }
    else frames.put(count, frame);
    (frames, count + 1usize);
};

_popFrame :: ParserFrames -> ParserFrames := ((frames, count)) -> (frames, count - 1usize);

// Completing a value rewrites its parent frame to the state that accepts a delimiter next.
_completeValue :: ParserFrames -> ParserFrames := (frames) -> {
    frame := frames._readFrame();
    if (frame == _arrayFirst || frame == _arrayValue)
    then frames._replaceFrame(_arrayNext)
    else {
        if (frame == _objectValue)
        then frames._replaceFrame(_objectNext)
        else frames._replaceFrame(_rootDone);
    };
};

_consumeLiteral :: (Bytes, Symbol) -> ScanProgress := (source, expected) -> {
    if (source.startsWith(expected))
    then (source.dropBytes(#expected), "")
    else (source, "invalid JSON literal");
};

_hasHexDigits :: (Bytes, USize) -> Bool := (source, count) ->
    _loop<(Bytes, USize), Bool>(
        (source, count),
        (remaining, count) -> [continue, break] => {
            when (count == 0usize) {
                break(true);
            };
            when (remaining.byteCount() == 0usize) {
                break(false);
            };
            byte := remaining.byteAt(0usize);
            when (!byte._isHexDigit()) {
                break(false);
            };
            continue((remaining.dropBytes(1usize), count - 1usize));
        });

// The input starts after the opening quote. This validates escapes without decoding the string.
_scanString :: Bytes -> ScanProgress := (source) ->
    _loop<Bytes, ScanProgress>(source, (remaining) -> [continue, break] => {
        when (remaining.byteCount() == 0usize) {
            break((remaining, "unterminated JSON string"));
        };
        byte := remaining.byteAt(0usize);
        when (byte == '"') {
            break((remaining.dropBytes(1usize), ""));
        };
        when (byte < 0x20u8) {
            break((remaining, "control byte in JSON string"));
        };
        when (byte != '\\') {
            continue(remaining.dropBytes(1usize));
        };

        afterSlash := remaining.dropBytes(1usize);
        when (afterSlash.byteCount() == 0usize) {
            break((remaining, "unterminated JSON escape"));
        };
        escaped := afterSlash.byteAt(0usize);
        simple := escaped == '"'
            || escaped == '\\'
            || escaped == '/'
            || escaped == 'b'
            || escaped == 'f'
            || escaped == 'n'
            || escaped == 'r'
            || escaped == 't';
        when (simple) {
            continue(afterSlash.dropBytes(1usize));
        };
        afterU := afterSlash.dropBytes(1usize);
        when (escaped == 'u' && afterU._hasHexDigits(4usize)) {
            continue(afterU.dropBytes(4usize));
        };
        break((remaining, "invalid JSON escape"));
    });

_scanDigits :: Bytes -> Bytes := (source) ->
    _loop<Bytes, Bytes>(source, (remaining) -> [continue, break] => {
        when (remaining.byteCount() == 0usize) {
            break(remaining);
        };
        byte := remaining.byteAt(0usize);
        when (!byte._isDigit()) {
            break(remaining);
        };
        continue(remaining.dropBytes(1usize));
    });

// JSON numbers are scanned in integer, fraction, and exponent phases so each optional suffix can
// require at least one digit without converting the numeric value.
_scanNumber :: Bytes -> ScanProgress := (source) -> [return] => {
    firstByte := source.byteAt(0usize);
    unsigned := if (firstByte == '-')
        then source.dropBytes(1usize)
        else source;
    when (unsigned.byteCount() == 0usize) {
        return((source, "incomplete JSON number"));
    };

    first := unsigned.byteAt(0usize);
    integerEnd := if (first == '0')
        then unsigned.dropBytes(1usize)
        else {
            when (!first._isNonzeroDigit()) {
                return((source, "invalid JSON number"));
            };
            (unsigned.dropBytes(1usize))._scanDigits();
        };

    afterFraction := if (integerEnd.byteCount() != 0usize)
        then {
            next := integerEnd.byteAt(0usize);
            if (next == '.')
            then {
                fraction := integerEnd.dropBytes(1usize);
                when (fraction.byteCount() == 0usize) {
                    return((source, "invalid JSON fraction"));
                };
                digit := fraction.byteAt(0usize);
                when (!digit._isDigit()) {
                    return((source, "invalid JSON fraction"));
                };
                (fraction.dropBytes(1usize))._scanDigits();
            }
            else integerEnd;
        }
        else integerEnd;

    afterExponent := if (afterFraction.byteCount() != 0usize)
        then {
            next := afterFraction.byteAt(0usize);
            if (next == 'e' || next == 'E')
            then {
                exponent := afterFraction.dropBytes(1usize);
                when (exponent.byteCount() == 0usize) {
                    return((source, "incomplete JSON exponent"));
                };
                firstExponent := exponent.byteAt(0usize);
                digits := if (firstExponent == '+' || firstExponent == '-')
                    then exponent.dropBytes(1usize)
                    else exponent;
                when (digits.byteCount() == 0usize) {
                    return((source, "invalid JSON exponent"));
                };
                digit := digits.byteAt(0usize);
                when (!digit._isDigit()) {
                    return((source, "invalid JSON exponent"));
                };
                (digits.dropBytes(1usize))._scanDigits();
            }
            else afterFraction;
        }
        else afterFraction;
    return((afterExponent, ""));
};

// This single loop-driven dispatcher executes the state at the top of the buffer frame stack.
// Every transition either consumes input, changes the active state, pops a completed container, or
// returns a result, so malformed input cannot make an unchanged state loop forever.
_parse :: ParserState -> ParseResult := (initial) ->
    _loop<ParserState, ParseResult>(initial, (state) -> [continue, break] => {
        (untrimmed, frames, frameDepth, stats) := state;
        source := untrimmed._skipWhitespace();
        frame := frames._readFrame();

        when (frame == _rootDone) {
            if (source.byteCount() == 0usize)
            then break(_parseSuccess(stats))
            else break(_parseFailure("trailing bytes after JSON value"));
        };
        when (source.byteCount() == 0usize) {
            break(_parseFailure("expected JSON value or closing delimiter"));
        };

        byte := source.byteAt(0usize);
        // Delimiter states run before value recognition, preventing commas and closers from becoming
        // accidental values and distinguishing the first element from later elements.
        when (frame == _arrayNext) {
            when (byte == ']') {
                continue((source.dropBytes(1usize), frames._popFrame(), frameDepth - 1u64, stats));
            };
            when (byte == ',') {
                continue((source.dropBytes(1usize), frames._replaceFrame(_arrayValue), frameDepth, stats));
            };
            break(_parseFailure("expected comma or closing bracket"));
        };
        when (frame == _objectNext) {
            when (byte == '}') {
                continue((source.dropBytes(1usize), frames._popFrame(), frameDepth - 1u64, stats));
            };
            when (byte == ',') {
                continue((source.dropBytes(1usize), frames._replaceFrame(_objectKey), frameDepth, stats));
            };
            break(_parseFailure("expected comma or closing brace"));
        };
        when (frame == _objectColon) {
            when (byte != ':') {
                break(_parseFailure("expected colon after object key"));
            };
            continue((source.dropBytes(1usize), frames._replaceFrame(_objectValue), frameDepth, stats));
        };
        when (frame == _objectFirst || frame == _objectKey) {
            when (frame == _objectFirst && byte == '}') {
                continue((source.dropBytes(1usize), frames._popFrame(), frameDepth - 1u64, stats));
            };
            when (byte != '"') {
                break(_parseFailure("expected JSON object key"));
            };
            (afterKey, keyError) := (source.dropBytes(1usize))._scanString();
            when (#keyError != 0usize) {
                break(_parseFailure(keyError));
            };
            continue((afterKey, frames._replaceFrame(_objectColon), frameDepth, stats));
        };
        when (frame == _arrayFirst && byte == ']') {
            continue((source.dropBytes(1usize), frames._popFrame(), frameDepth - 1u64, stats));
        };

        nextFrames := frames._completeValue();
        // Object keys are syntax rather than JSON values, so only this value path updates statistics.
        nextStats := stats._includeValue(frameDepth);
        when (byte == '[' || byte == '{') {
            childFrame := if (byte == '[')
                then _arrayFirst
                else _objectFirst;
            continue((
                source.dropBytes(1usize),
                nextFrames._pushFrame(childFrame),
                frameDepth + 1u64,
                nextStats
            ));
        };
        when (byte == '"') {
            (afterString, stringError) := (source.dropBytes(1usize))._scanString();
            when (#stringError != 0usize) {
                break(_parseFailure(stringError));
            };
            continue((afterString, nextFrames, frameDepth, nextStats));
        };
        when (byte == 't' || byte == 'f' || byte == 'n') {
            literal := if (byte == 't')
                then "true"
                else {
                    if (byte == 'f')
                    then "false"
                    else "null";
                };
            (afterLiteral, literalError) := source._consumeLiteral(literal);
            when (#literalError != 0usize) {
                break(_parseFailure(literalError));
            };
            continue((afterLiteral, nextFrames, frameDepth, nextStats));
        };
        when (byte == '-' || byte._isDigit()) {
            (afterNumber, numberError) := source._scanNumber();
            when (#numberError != 0usize) {
                break(_parseFailure(numberError));
            };
            continue((afterNumber, nextFrames, frameDepth, nextStats));
        };
        break(_parseFailure("expected JSON value"));
    });

// Parses one complete owned byte sequence and rejects trailing non-whitespace input.
parseDocument :: Buffer<UInt8> -> ParseResult := (buffer) ->
    (
        (buffer, 0usize),
        (make<ParserFrame>(1usize), 0usize)._pushFrame(_rootValue),
        1u64,
        (0u64, 0u64)
    )._parse();
