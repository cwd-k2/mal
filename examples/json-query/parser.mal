require "./bytes.mal";

// Stats fields: 0 JSON value count, 1 maximum value depth.
Stats :: (UInt64, UInt64);
// Variant 0 is an error message; variant 1 is the statistics for a complete document.
ParseResult :: [Symbol, Stats];
// Scan carries the unread input and an empty success message or a non-empty error message.
Scan :: (Region<UInt8>, Symbol);
// ParserState fields: 0 unread input, 1 frame stack, 2 frame depth, 3 statistics.
ParserState :: (Region<UInt8>, Packed<UInt8>, UInt64, Stats);

// The last Packed element is the active frame. Parent frames act as explicit return addresses,
// replacing mutually recursive array, object, and value parser functions.
_arrayFirst :: UInt8 := 1u8;
_arrayValue :: UInt8 := 2u8;
_arrayNext :: UInt8 := 3u8;
_objectFirst :: UInt8 := 4u8;
_objectKey :: UInt8 := 5u8;
_objectColon :: UInt8 := 6u8;
_objectValue :: UInt8 := 7u8;
_objectNext :: UInt8 := 8u8;
_rootValue :: UInt8 := 9u8;
_rootDone :: UInt8 := 10u8;

_parseFailure :: Symbol -> ParseResult := (message) -> [failure, success] => failure(message);

_parseSuccess :: Stats -> ParseResult := (stats) -> [failure, success] => success(stats);

_isWhitespace :: UInt8 -> Bool := (byte) ->
    byte == ' ' || byte == '\n' || byte == '\r' || byte == '\t';

_isDigit :: UInt8 -> Bool := (byte) -> byte >= '0' && byte <= '9';

_isNonzeroDigit :: UInt8 -> Bool := (byte) -> byte >= '1' && byte <= '9';

_isHexDigit :: UInt8 -> Bool := (byte) ->
    byte._isDigit()
        || (byte >= 'a' && byte <= 'f')
        || (byte >= 'A' && byte <= 'F');

_skipWhitespace :: Region<UInt8> -> Region<UInt8> := (source) -> [return] => {
    when (#source == 0usize) {
        return(source);
    };
    byte := <-(source # 0usize);
    when (byte._isWhitespace()) {
        return((source % 1usize)._skipWhitespace());
    };
    return(source);
};

_includeValue :: (Stats, UInt64) -> Stats := (stats, depth) -> {
    (count, maximumDepth) := stats;
    nextDepth := if (maximumDepth >= depth)
        then maximumDepth
        else depth;
    (count + 1u64, nextDepth);
};

// Reading and replacing affect only the active frame; pushing and popping move the active end.
_readFrame :: Packed<UInt8> -> UInt8 := (frames) -> frames # (#frames - 1usize);

_replaceFrame :: (Packed<UInt8>, UInt8) -> Packed<UInt8> := (frames, frame) -> {
    index := #frames - 1usize;
    frames.edit<UInt8>((buffer) -> {
        buffer.put(index, frame);
        ();
    });
};

_pushFrame :: (Packed<UInt8>, UInt8) -> Packed<UInt8> := (frames, frame) ->
    frames.edit<UInt8>((buffer) -> {
        _ := buffer.new(frame);
        ();
    });

_popFrame :: Packed<UInt8> -> Packed<UInt8> := (frames) -> frames / (#frames - 1usize);

// Completing a value rewrites its parent frame to the state that accepts a delimiter next.
_completeValue :: Packed<UInt8> -> Packed<UInt8> := (frames) -> {
    frame := frames._readFrame();
    if (frame == _arrayFirst || frame == _arrayValue)
    then frames._replaceFrame(_arrayNext)
    else {
        if (frame == _objectValue)
        then frames._replaceFrame(_objectNext)
        else frames._replaceFrame(_rootDone);
    };
};

_consumeLiteral :: (Region<UInt8>, Symbol) -> Scan := (source, expected) -> {
    if (source.startsWith(expected))
    then (source % #expected, "")
    else (source, "invalid JSON literal");
};

_hasHexDigits :: (Region<UInt8>, USize) -> Bool := (source, remaining) -> [return] => {
    when (remaining == 0usize) {
        return(true);
    };
    when (#source == 0usize) {
        return(false);
    };
    byte := <-(source # 0usize);
    when (!byte._isHexDigit()) {
        return(false);
    };
    return((source % 1usize)._hasHexDigits(remaining - 1usize));
};

// The input starts after the opening quote. This validates escapes without decoding the string.
_scanString :: Region<UInt8> -> Scan := (source) -> [return] => {
    when (#source == 0usize) {
        return((source, "unterminated JSON string"));
    };
    byte := <-(source # 0usize);
    when (byte == '"') {
        return((source % 1usize, ""));
    };
    when (byte < 0x20u8) {
        return((source, "control byte in JSON string"));
    };
    when (byte != '\\') {
        return((source % 1usize)._scanString());
    };

    afterSlash := source % 1usize;
    when (#afterSlash == 0usize) {
        return((source, "unterminated JSON escape"));
    };
    escaped := <-(afterSlash # 0usize);
    simple := escaped == '"'
        || escaped == '\\'
        || escaped == '/'
        || escaped == 'b'
        || escaped == 'f'
        || escaped == 'n'
        || escaped == 'r'
        || escaped == 't';
    when (simple) {
        return((afterSlash % 1usize)._scanString());
    };
    afterU := afterSlash % 1usize;
    when (escaped == 'u' && afterU._hasHexDigits(4usize)) {
        return((afterU % 4usize)._scanString());
    };
    return((source, "invalid JSON escape"));
};

_scanDigits :: Region<UInt8> -> Region<UInt8> := (source) -> [return] => {
    when (#source == 0usize) {
        return(source);
    };
    byte := <-(source # 0usize);
    when (!byte._isDigit()) {
        return(source);
    };
    return((source % 1usize)._scanDigits());
};

// JSON numbers are scanned in integer, fraction, and exponent phases so each optional suffix can
// require at least one digit without converting the numeric value.
_scanNumber :: Region<UInt8> -> Scan := (source) -> [return] => {
    firstByte := <-(source # 0usize);
    unsigned := if (firstByte == '-')
        then source % 1usize
        else source;
    when (#unsigned == 0usize) {
        return((source, "incomplete JSON number"));
    };

    first := <-(unsigned # 0usize);
    integerEnd := if (first == '0')
        then unsigned % 1usize
        else {
            when (!first._isNonzeroDigit()) {
                return((source, "invalid JSON number"));
            };
            (unsigned % 1usize)._scanDigits();
        };

    afterFraction := if (#integerEnd != 0usize)
        then {
            next := <-(integerEnd # 0usize);
            if (next == '.')
            then {
                fraction := integerEnd % 1usize;
                when (#fraction == 0usize) {
                    return((source, "invalid JSON fraction"));
                };
                digit := <-(fraction # 0usize);
                when (!digit._isDigit()) {
                    return((source, "invalid JSON fraction"));
                };
                (fraction % 1usize)._scanDigits();
            }
            else integerEnd;
        }
        else integerEnd;

    afterExponent := if (#afterFraction != 0usize)
        then {
            next := <-(afterFraction # 0usize);
            if (next == 'e' || next == 'E')
            then {
                exponent := afterFraction % 1usize;
                when (#exponent == 0usize) {
                    return((source, "incomplete JSON exponent"));
                };
                firstExponent := <-(exponent # 0usize);
                digits := if (firstExponent == '+' || firstExponent == '-')
                    then exponent % 1usize
                    else exponent;
                when (#digits == 0usize) {
                    return((source, "invalid JSON exponent"));
                };
                digit := <-(digits # 0usize);
                when (!digit._isDigit()) {
                    return((source, "invalid JSON exponent"));
                };
                (digits % 1usize)._scanDigits();
            }
            else afterFraction;
        }
        else afterFraction;
    return((afterExponent, ""));
};

// This single tail-recursive dispatcher executes the state at the top of the packed frame stack.
// Every transition either consumes input, changes the active state, pops a completed container, or
// returns a result, so malformed input cannot make an unchanged state loop forever.
_parse :: ParserState -> ParseResult := (state) -> [return] => {
    (untrimmed, frames, frameDepth, stats) := state;
    source := untrimmed._skipWhitespace();
    frame := frames._readFrame();

    when (frame == _rootDone) {
        if (#source == 0usize)
        then return(_parseSuccess(stats))
        else return(_parseFailure("trailing bytes after JSON value"));
    };
    when (#source == 0usize) {
        return(_parseFailure("expected JSON value or closing delimiter"));
    };

    byte := <-(source # 0usize);
    // Delimiter states run before value recognition, preventing commas and closers from becoming
    // accidental values and distinguishing the first element from later elements.
    when (frame == _arrayNext) {
        when (byte == ']') {
            return(_parse((source % 1usize, frames._popFrame(), frameDepth - 1u64, stats)));
        };
        when (byte == ',') {
            return(_parse((source % 1usize, frames._replaceFrame(_arrayValue), frameDepth, stats)));
        };
        return(_parseFailure("expected comma or closing bracket"));
    };
    when (frame == _objectNext) {
        when (byte == '}') {
            return(_parse((source % 1usize, frames._popFrame(), frameDepth - 1u64, stats)));
        };
        when (byte == ',') {
            return(_parse((source % 1usize, frames._replaceFrame(_objectKey), frameDepth, stats)));
        };
        return(_parseFailure("expected comma or closing brace"));
    };
    when (frame == _objectColon) {
        when (byte != ':') {
            return(_parseFailure("expected colon after object key"));
        };
        return(_parse((source % 1usize, frames._replaceFrame(_objectValue), frameDepth, stats)));
    };
    when (frame == _objectFirst || frame == _objectKey) {
        when (frame == _objectFirst && byte == '}') {
            return(_parse((source % 1usize, frames._popFrame(), frameDepth - 1u64, stats)));
        };
        when (byte != '"') {
            return(_parseFailure("expected JSON object key"));
        };
        (afterKey, keyError) := (source % 1usize)._scanString();
        when (#keyError != 0usize) {
            return(_parseFailure(keyError));
        };
        return(_parse((afterKey, frames._replaceFrame(_objectColon), frameDepth, stats)));
    };
    when (frame == _arrayFirst && byte == ']') {
        return(_parse((source % 1usize, frames._popFrame(), frameDepth - 1u64, stats)));
    };

    nextFrames := frames._completeValue();
    // Object keys are syntax rather than JSON values, so only this value path updates statistics.
    nextStats := stats._includeValue(frameDepth);
    when (byte == '[' || byte == '{') {
        childFrame := if (byte == '[')
            then _arrayFirst
            else _objectFirst;
        return(_parse((source % 1usize, nextFrames._pushFrame(childFrame), frameDepth + 1u64, nextStats)));
    };
    when (byte == '"') {
        (afterString, stringError) := (source % 1usize)._scanString();
        when (#stringError != 0usize) {
            return(_parseFailure(stringError));
        };
        return(_parse((afterString, nextFrames, frameDepth, nextStats)));
    };
    when (byte == 't' || byte == 'f' || byte == 'n') {
        literal := if (byte == 't')
            then "true"
            else {
                if (byte == 'f')
                then "false"
                else "null";
            };
        (afterLiteral, literalError) := source._consumeLiteral(literal);
        when (#literalError != 0usize) {
            return(_parseFailure(literalError));
        };
        return(_parse((afterLiteral, nextFrames, frameDepth, nextStats)));
    };
    when (byte == '-' || byte._isDigit()) {
        (afterNumber, numberError) := source._scanNumber();
        when (#numberError != 0usize) {
            return(_parseFailure(numberError));
        };
        return(_parse((afterNumber, nextFrames, frameDepth, nextStats)));
    };
    return(_parseFailure("expected JSON value"));
};

// ParseResult retains no view into source, so the host owner may be released after this call.
parseDocument :: Region<UInt8> -> ParseResult := (source) ->
    (
        source,
        pack<UInt8>((buffer) -> {
        _ := buffer.new(_rootValue);
        ();
    }),
        1u64,
        (0u64, 0u64)
    )._parse();
