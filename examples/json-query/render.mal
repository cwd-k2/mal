require "./host.mal";
require "./parser.mal";

_decimalDigit :: UInt8 -> Symbol := (value) -> "0123456789" % value.usize / 1usize;

_renderDecimal :: UInt64 -> Symbol := (value) -> {
    digit := (value % 10u64).u8._decimalDigit();
    if (value < 10u64)
    then digit
    else (value / 10u64)._renderDecimal() + digit;
};

renderCount :: Unit -> (JsonStatistics -> Symbol) := () -> (stats) -> {
    "{\"ok\":true,\"count\":" + stats.valueCount()._renderDecimal() + "}";
};

renderDepth :: Unit -> (JsonStatistics -> Symbol) := () -> (stats) -> {
    "{\"ok\":true,\"depth\":" + stats.maximumDepth()._renderDecimal() + "}";
};

renderError :: Symbol -> Symbol := (message) -> "{\"ok\":false,\"error\":\"" + message + "\"}";
