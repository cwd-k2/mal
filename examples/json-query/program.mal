require "./host.mal";
require "./parser.mal";
require "./query.mal";
require "./render.mal";

_reportParseError :: Symbol -> Int32 := (message) -> {
    writeStdout(message.renderError() + "\n");
    1;
};

_runQuery :: Query -> Int32 := (query) -> {
    (input, address, length) := readStdin();
    source := from<UInt8>(address, 0usize, length);
    releaseInput(input);
    parsed := source.parseDocument();
    // Two continuations exhaust ParseResult. Only the selected arm is evaluated.
    parsed[
    _reportParseError,
    (stats) -> {
        // Eliminating Query returns a renderer as a value; stats[renderer] then applies it.
        renderer := query[renderCount, renderDepth];
        writeStdout(stats[renderer] + "\n");
        0;
    }
    ];
};

main :: Arguments -> Int32 := (argumentCount, arguments) -> {
    if (argumentCount != 1usize)
    then {
        writeStdout("{\"ok\":false,\"error\":\"usage: mal-json-query count|depth\"}\n");
        2;
    }
    else {
        argumentAddresses := from<Address>(arguments, 0usize, 1usize);
        argumentAddress := argumentAddresses.get(0usize);
        queryBytes := from<UInt8>(argumentAddress, 0usize, argumentLength(argumentAddress));
        query := (queryBytes, 0usize).parseQuery();
        query[
        (message) -> {
            writeStdout(message.renderError() + "\n");
            2;
        },
        _runQuery
        ];
    };
};
