require "./host.mal";
require "./bytes.mal";
require "./parser.mal";
require "./query.mal";
require "./render.mal";

_reportParseError :: Symbol -> Int32 := (message) -> {
    writeStdout(message.renderError() + "\n");
    1;
};

_runQuery :: Query -> Int32 := (query) -> {
    sourceBytes := readStdin();
    source := *sourceBytes;
    parsed := source.parseDocument();
    parsed[
        _reportParseError,
        (stats) -> {
            renderer := query[renderCount, renderDepth];
            writeStdout(stats[renderer] + "\n");
            0;
        }
    ];
};

main :: Buffer<Symbol> -> Int32 := (arguments) -> {
    if (#arguments != 1usize)
    then {
        writeStdout("{\"ok\":false,\"error\":\"usage: mal-json-query count|depth\"}\n");
        2;
    }
    else {
        query := arguments.get(0usize).allBytes().parseQuery();
        query[
            (message) -> {
                writeStdout(message.renderError() + "\n");
                2;
            },
            _runQuery
        ];
    };
};
