require "./bytes.mal";

Query :: [Unit, Unit];
QueryResult :: [Symbol, Query];

// The sum result binders name Query's result edges; applying count selects variant 0.
_countQuery :: Unit -> Query := () -> [count, depth] => count();
_depthQuery :: Unit -> Query := () -> [count, depth] => depth();

parseQuery :: Bytes -> QueryResult := (text) -> [failure, success] => {
    when (text.equalsSymbol("count")) {
        success(_countQuery());
    };
    when (text.equalsSymbol("depth")) {
        success(_depthQuery());
    };
    failure("query must be count or depth");
};
