// Query is an enum: variant 0 selects count and variant 1 selects depth.
Query :: [Unit, Unit];
// The first variant carries a diagnostic; the second carries a validated query.
QueryResult :: [Symbol, Query];

// A sum constructor is received as a continuation, so calling count() constructs variant 0.
_countQuery :: Unit -> Query := ()[count, depth] {
    count();
};

_depthQuery :: Unit -> Query := ()[count, depth] {
    depth();
};

parseQuery :: Symbol -> QueryResult := (text)[failure, success] {
    when (text == "count") {
        success(_countQuery());
    };
    when (text == "depth") {
        success(_depthQuery());
    };
    failure("query must be count or depth");
};
