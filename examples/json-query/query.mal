// Query is a sum: variant 0 selects count and variant 1 selects depth.
Query :: [Unit, Unit];
// The first variant carries a diagnostic; the second carries a validated query.
QueryResult :: [Symbol, Query];

// The sum return binders name Query's result edges; applying count selects variant 0.
_countQuery :: Unit -> Query := ()[count, depth] -> count();

_depthQuery :: Unit -> Query := ()[count, depth] -> depth();

parseQuery :: Symbol -> QueryResult := (text)[failure, success] -> {
    when (text == "count") {
        success(_countQuery());
    };
    when (text == "depth") {
        success(_depthQuery());
    };
    failure("query must be count or depth");
};
