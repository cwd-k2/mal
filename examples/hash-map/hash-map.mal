equal<K> :: (K, K) -> Bool;
hash<K> :: K -> UInt64;

HashEntry<K, V> :: [Unit, (K, V)];
HashMap<K, V> :: Buffer<HashEntry<K, V>>;
HashLookup<V> :: [Unit, V];

const<A, B> :: A -> B -> A := (value) -> (_) -> value;
identity<A> :: A -> A := (value) -> value;

_emptyEntry<K, V> :: Unit -> HashEntry<K, V> := () ->
    [empty, occupied] => empty();

_occupiedEntry<K, V> :: (K, V) -> HashEntry<K, V> := (key, value) ->
    [empty, occupied] => occupied(key, value);

hashMap<K, V> :: USize -> HashMap<K, V> := (capacity) -> {
    slots :: HashMap<K, V> := make(capacity);
    slots.fill(0usize, capacity, _emptyEntry());
    slots;
};

_hashMapGetFrom<K, V> :: (HashMap<K, V>, K, USize, USize) -> HashLookup<V> :=
    (slots, key, index, remaining) -> [missing, found] => {
        when (remaining == 0usize) missing();
        entry := slots.get(index)[missing, identity];
        (storedKey, storedValue) := entry;
        when (equal(storedKey, key)) found(storedValue);
        slots._hashMapGetFrom(
            key,
            (index + 1usize) % #slots,
            remaining - 1usize
        )[missing, found];
    };

hashMapGet<K, V> :: (HashMap<K, V>, K) -> HashLookup<V> :=
    (slots, key) -> [missing, found] => {
        when (#slots == 0usize) missing();
        slots._hashMapGetFrom(key, hash(key).usize % #slots, #slots)[missing, found];
    };

_hashMapPutFrom<K, V> :: (HashMap<K, V>, K, V, USize, USize) -> Bool :=
    (slots, key, value, index, remaining) -> [return] => {
        when (remaining == 0usize) return(false);
        entry := slots.get(index)[
            () -> {
                slots.put(index, _occupiedEntry(key, value));
                return(true);
            },
            identity
        ];
        (storedKey, _) := entry;
        when (equal(storedKey, key)) {
            slots.put(index, _occupiedEntry(key, value));
            return(true);
        };
        return(slots._hashMapPutFrom(
            key,
            value,
            (index + 1usize) % #slots,
            remaining - 1usize
        ));
    };

hashMapPut<K, V> :: (HashMap<K, V>, K, V) -> Bool :=
    (slots, key, value) -> [return] => {
        when (#slots == 0usize) return(false);
        return(slots._hashMapPutFrom(key, value, hash(key).usize % #slots, #slots));
    };
