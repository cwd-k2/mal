equal<K> :: (K, K) -> Bool;
hash<K> :: K -> UInt64;

HashEntry<K, V> :: [Unit, (K, V)];
HashMap<K, V> :: Buffer<HashEntry<K, V>>;
HashLookup<V> :: [Unit, V];

_loop<A, B> :: (A, A -> [A, B]) -> B :=
    (state, step) -> step(state)[
        (nextState) -> _loop(nextState, step),
        (result) -> result
    ];

_emptyEntry<K, V> :: Unit -> HashEntry<K, V> := () ->
    [empty, occupied] => empty();

_occupiedEntry<K, V> :: (K, V) -> HashEntry<K, V> := (key, value) ->
    [empty, occupied] => occupied(key, value);

_missing<V> :: Unit -> HashLookup<V> := () -> [missing, found] => missing();

_found<V> :: V -> HashLookup<V> := (value) -> [missing, found] => found(value);

hashMap<K, V> :: USize -> HashMap<K, V> := (capacity) -> {
    slots :: HashMap<K, V> := make(capacity);
    slots.fill(0usize, capacity, _emptyEntry());
    slots;
};

hashMapGet<K, V> :: (HashMap<K, V>, K) -> HashLookup<V> := (slots, key) ->
    if (#slots == 0usize)
        then _missing()
        else {
            start := hash(key).usize % #slots;
            _loop((start, #slots), (index, remaining) -> [continue, break] => {
                when (remaining == 0usize) {
                    break(_missing());
                };
                slots.get(index)[
                    () -> break(_missing()),
                    (entry) -> {
                        (storedKey, storedValue) := entry;
                        if (equal(storedKey, key))
                        then break(_found(storedValue))
                        else continue((index + 1usize) % #slots, remaining - 1usize);
                    }
                ];
            });
        };

hashMapPut<K, V> :: (HashMap<K, V>, K, V) -> Bool := (slots, key, value) ->
    if (#slots == 0usize)
        then false
        else {
            start := hash(key).usize % #slots;
            _loop((start, #slots), (index, remaining) -> [continue, break] => {
                when (remaining == 0usize) {
                    break(false);
                };
                slots.get(index)[
                    () -> {
                        slots.put(index, _occupiedEntry(key, value));
                        break(true);
                    },
                    (entry) -> {
                        (storedKey, _) := entry;
                        if (equal(storedKey, key))
                        then {
                            slots.put(index, _occupiedEntry(key, value));
                            break(true);
                        }
                        else continue((index + 1usize) % #slots, remaining - 1usize);
                    }
                ];
            });
        };
