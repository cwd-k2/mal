// PairRow is a physical pair of coordinates with no relation fixed by the product type itself.
PairRow :: (USize, USize);
// PairRows is a finite carrier that operations may interpret as edges, intervals, or another relation.
PairRows :: Buffer<PairRow>;

// Carrier traversal is independent of the relation assigned to each row. The step sum keeps
// early completion distinct from the next cursor instead of reserving a sentinel index.
_loop<A, B> :: (A, A -> [A, B]) -> B :=
    (state, step) -> step(state)[
        (nextState) -> _loop<A, B>(nextState, step),
        (result) -> result
    ];

// Existential traversal stops at the first matching row. Its empty result is false because
// there is no witness.
_anyBuffer<A> :: (Buffer<A>, A -> Bool) -> Bool := (values, predicate) ->
    _loop<USize, Bool>(0usize, (index) -> [continue, break] => {
        when (index == #values) {
            break(false);
        };
        when (predicate(values.get(index))) {
            break(true);
        };

        continue(index + 1usize);
    });

// Universal traversal stops at the first counterexample. Its empty result is true because no row
// violates the predicate.
_allBuffer<A> :: (Buffer<A>, A -> Bool) -> Bool := (values, predicate) ->
    _loop<USize, Bool>(0usize, (index) -> [continue, break] => {
        when (index == #values) {
            break(true);
        };
        when (!predicate(values.get(index))) {
            break(false);
        };

        continue(index + 1usize);
    });

// A fold has no early domain result, so the loop state pairs the shared cursor with the evolving
// accumulator and returns it only after every row has contributed.
_foldBuffer<A, B> :: (Buffer<A>, B, (B, A) -> B) -> B := (values, initial, combine) ->
    _loop<(USize, B), B>((0usize, initial), (index, result) -> [continue, break] => {
        when (index == #values) {
            break(result);
        };

        continue((index + 1usize, combine(result, values.get(index))));
    });

buildRows :: Unit -> PairRows := () -> {
    buffer := make<PairRow>(3usize);
    buffer.new((0usize, 3usize));
    buffer.new((3usize, 5usize));
    buffer.new((2usize, 4usize));
    buffer;
};

// The following operations give the same carrier three meanings. Their callbacks describe only
// one row; the named traversal combinators own cursor movement, termination, and empty input.
hasDirectedEdge :: (PairRows, USize, USize) -> Bool := (rows, source, target) ->
    rows._anyBuffer<PairRow>((row) -> {
        (rowSource, rowTarget) := row;
        rowSource == source && rowTarget == target;
    });

validIntervals :: PairRows -> Bool := (rows) ->
    rows._allBuffer<PairRow>((row) -> {
        (start, end) := row;
        start <= end;
    });

coverageAt :: (PairRows, USize) -> USize := (rows, coordinate) ->
    rows._foldBuffer<PairRow, USize>(0usize, (count, row) -> {
        (start, end) := row;
        included := start <= coordinate && coordinate < end;
        if (included)
        then count + 1usize
        else count;
    });

main :: Unit -> Int32 := () -> {
    rows := buildRows();
    directed := rows.hasDirectedEdge(3usize, 5usize)
        && !rows.hasDirectedEdge(5usize, 3usize);
    intervals := rows.validIntervals()
        && rows.coverageAt(2usize) == 2usize
        && rows.coverageAt(3usize) == 2usize
        && rows.coverageAt(5usize) == 0usize;
    if (directed && intervals)
    then 0
    else 1;
};
