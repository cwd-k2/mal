require "./host.c";

extern receive :: Unit -> Buffer<UInt8>;
extern send :: Symbol -> Unit;

main :: Unit -> Int32 := () -> {
    bytes := receive();

    // The Symbol is a snapshot; later mutation through an alias changes only the Buffer identity.
    snapshot := *bytes;
    alias := bytes;
    alias.put(0usize, 'M');
    alias.copy(#alias, *"!", 0usize, 1usize);

    valid := snapshot == "malあ\0\xff"
        && *bytes == "Malあ\0\xff!"
        && snapshot / 3usize == "mal"
        && snapshot % 3usize / 3usize == "あ";

    send(*bytes);
    if (valid)
    then 0
    else 1;
};
