sumTo :: (Int64, Int64) -> Int64 := (remaining, total)[return] {
    when (remaining == 0) {
        return(total);
    };
    return(sumTo(remaining - 1, total + remaining));
};

main :: Unit -> Int32 := () {
    result := sumTo(1_000_000i64, 0);
    if (result == 500_000_500_000i64)
    then { 0 }
    else { 1 };
};
