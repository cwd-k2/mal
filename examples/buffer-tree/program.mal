// NodeRow fields: value, kind (0 = leaf, 1 = branch), left coordinate, right coordinate.
NodeRow :: (Int32, UInt8, USize, USize);
// NodeRows is the physical row carrier; branch rows interpret two coordinates as child edges.
NodeRows :: Buffer<NodeRow>;

buildTreeRows :: Unit -> NodeRows := () -> {
    buffer := make<NodeRow>(0usize);
    // Root is a stable carrier coordinate even when later appends grow the buffer.
    root := buffer.new((1i32, 0u8, 0usize, 0usize));
    left := buffer.new((2i32, 0u8, 0usize, 0usize));
    leftLeft := buffer.new((3i32, 0u8, 0usize, 0usize));
    leftRight := buffer.new((4i32, 0u8, 0usize, 0usize));
    right := buffer.new((5i32, 0u8, 0usize, 0usize));
    buffer.put(left, (2i32, 1u8, leftLeft, leftRight));
    buffer.put(root, (1i32, 1u8, left, right));
    buffer;
};

// Both child totals are consumed after their calls return, making this structural rather than tail
// recursion over the row carrier.
sumTreeAt :: (NodeRows, USize) -> Int32 := (rows, coordinate) -> {
    (value, kind, left, right) := rows.get(coordinate);
    if (kind == 0u8)
    then value
    else value + rows.sumTreeAt(left) + rows.sumTreeAt(right);
};

incrementRoot :: NodeRows -> NodeRows := (rows) -> {
    // This transformation preserves coordinates and the child relation.
    (value, kind, left, right) := rows.get(0usize);
    rows.put(0usize, (value + 1i32, kind, left, right));
    rows;
};

main :: Unit -> Int32 := () -> {
    rows := buildTreeRows();
    // Assignment aliases the carrier, so incrementRoot is visible through both names.
    updated := rows.incrementRoot();
    if (rows.sumTreeAt(0usize) == 16i32 && updated.sumTreeAt(0usize) == 16i32)
    then 0
    else 1;
};
