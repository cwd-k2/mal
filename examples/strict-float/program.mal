require "./host.c";

extern inspect :: (Float32, Float32, Float64, Int64) -> Int32;

main :: Unit -> Int32 := () -> {
    // The host checks bits, keeping literal rounding separate from decimal rendering.
    halfway := 1.000000059604644775390625f32;
    minimumSubnormal := 1.40129846e-45f32;
    negativeZero := -0.0f64;
    converted := (-42.75f64).i64;
    inspect(halfway, minimumSubnormal, negativeZero, converted);
};
