require "./host.c";

ByteBuffer :: (Address, USize, USize);
WritableBytes :: (Address, USize);

extern Allocation;
extern File;

IoError :: UInt32;
OwnedBuffer :: (Allocation, ByteBuffer);
OpenResult :: [File, IoError];
ReadResult :: [USize, IoError];
CloseResult :: [Unit, IoError];
CopyResult :: [Unit, IoError];

extern allocateBuffer :: USize -> OwnedBuffer;
extern releaseBuffer :: Allocation -> Unit;
extern openReadOnly :: (Address, USize) -> OpenResult;
extern readFile :: (File, WritableBytes) -> ReadResult;
extern closeFile :: File -> CloseResult;
extern writeBytes :: (Address, USize) -> Unit;
extern writeError :: IoError -> Unit;

bufferSize :: USize := 4096usize;

// A tail step owns one read result: EOF completes, bytes make observable progress, and an error exits
// through CopyResult before copyPath performs the common close-and-release cleanup.
copyContents :: (File, ByteBuffer) -> CopyResult := (file, buffer) -> [complete, failed] => {
    (memory, capacity, _) := buffer;
    length := file.readFile((memory, capacity))[(length) -> length, failed];
    when (length == 0usize) {
        complete();
    };
    writeBytes(memory, length);
    file.copyContents((memory, capacity, length))[complete, failed];
};

// A copy error is preserved over a later close error.
finishCopy :: (CopyResult, CloseResult) -> CopyResult := (copied, closed) -> [complete, failed] => {
    copied[() -> closed[complete, failed], failed];
};

// The host reads the path as a byte range during the open call only, so the copy is released right after it.
openPath :: Symbol -> OpenResult := (path) -> {
    bytes := *path;
    length := #bytes;
    (allocation, (memory, _, _)) := allocateBuffer(if (length == 0usize) then 1usize else length);
    bytes.into(memory, 0usize, length);
    opened := openReadOnly((memory, length));
    allocation.releaseBuffer();
    opened;
};

copyPath :: Symbol -> CopyResult := (path) -> {
    owned := allocateBuffer(bufferSize);
    (allocation, buffer) := owned;
    opened := openPath(path);
    outcome := opened[
        (file) -> {
            copied := file.copyContents(buffer);
            closed := file.closeFile();
            copied.finishCopy(closed);
        },
        (error) -> [complete, failed] => failed(error)
    ];
    allocation.releaseBuffer();
    outcome;
};

main :: Buffer<Symbol> -> Int32 := (arguments) -> [return] => {
    when (#arguments != 1usize) {
        writeError(22u32);
        return(2);
    };

    result := copyPath(arguments.get(0usize));
    status :: Int32 := result[
        () -> 0,
        (error) -> {
            writeError(error);
            1;
        }
    ];
    return(status);
};
