require "./syscall.c";

OptionalAddress :: [Unit, Address];
MapRequest :: (OptionalAddress, ByteSize, Int32, Int32, Int32, UInt64);
ResizeRequest :: (Address, ByteSize, ByteSize, Int32);
AddressResult :: [Address, UInt32];
FileDescriptorResult :: [Int32, UInt32];
OffsetResult :: [UInt64, UInt32];
TransferResult :: [ByteSize, UInt32];
SyscallStatus :: [Unit, UInt32];

// These operations only adapt typed mal values to Linux syscall registers and errno results.
extern systemMmap :: MapRequest -> AddressResult;
extern systemMremap :: ResizeRequest -> AddressResult;
extern systemMunmap :: (Address, ByteSize) -> SyscallStatus;
extern systemOpenat :: (Int32, Address, Int32, UInt32) -> FileDescriptorResult;
extern systemLseek :: (Int32, Int64, Int32) -> OffsetResult;
extern systemClose :: Int32 -> SyscallStatus;
extern systemRead :: (Int32, Address, ByteSize) -> TransferResult;
extern systemWrite :: (Int32, Address, ByteSize) -> TransferResult;
