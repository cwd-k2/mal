require "./memory.mal";
require "./syscall.mal";

ReadResult :: [Buffer<UInt8>, UInt32];
// MappingBuffer fields: 0 current mapping, 1 extent, 2 initialized byte length.
MappingBuffer :: (Address, ByteSize, ByteSize);
MappingFailure :: (MappingBuffer, UInt32);
MappingResult :: [MappingBuffer, MappingFailure];

_atCurrentWorkingDirectory :: Int32 := -100i32;
_seekStart :: Int32 := 0i32;
_seekEnd :: Int32 := 2i32;
_invalidArgument :: UInt32 := 22u32;
_fileTooLarge :: UInt32 := 27u32;

_closeWithError :: (Int32, UInt32) -> ReadResult := (descriptor, error) -> [success, failure] => {
    systemClose(descriptor);
    failure(error);
};

// Each tail step either grows the owned mapping or advances its initialized prefix. Failure carries
// the current mapping so the common finishing path can still release it.
_readInto :: (Int32, MappingBuffer) -> MappingResult :=
    (descriptor, buffer) -> [success, failure] => {
        (memory, capacity, length) := buffer;
        when (length == capacity) {
            when (capacity == (-1u64).bytes) {
                failure((buffer, _fileTooLarge));
            };
            nextCapacity := if (capacity > 0x7fff_ffff_ffff_ffffu64.bytes)
                then (-1u64).bytes
                else capacity + capacity;
            nextMemory := resizeMapping(memory, capacity, nextCapacity)[
                (nextMemory) -> nextMemory,
                (error) -> failure((buffer, error))
            ];
            _readInto(descriptor, (nextMemory, nextCapacity, length))[success, failure];
        };
        count := systemRead(descriptor, memory, length, capacity - length)[
            (count) -> count,
            (error) -> failure((buffer, error))
        ];
        when (count == 0bytes) {
            success(buffer);
        };
        _readInto(descriptor, (memory, capacity, length + count))[success, failure];
    };

_finishRead :: (Int32, MappingResult) -> ReadResult :=
    (descriptor, result) -> [success, failure] => {
        closed := systemClose(descriptor);
        buffer := result[
            (buffer) -> buffer,
            (failureValue) -> {
                (buffer, error) := failureValue;
                (memory, capacity, _) := buffer;
                systemMunmap(memory, capacity);
                failure(error);
            }
        ];
        (memory, capacity, length) := buffer;
        closed[
            () -> (),
            (error) -> {
                systemMunmap(memory, capacity);
                failure(error);
            }
        ];
        source := from<UInt8>(memory, 0usize, length.usize);
        systemMunmap(memory, capacity)[() -> success(source), failure];
    };

_readSnapshot :: (Int32, UInt64) -> ReadResult :=
    (descriptor, sizeHint) -> [success, failure] => {
        when (sizeHint == 0xffff_ffff_ffff_ffffu64) {
            _closeWithError(descriptor, _fileTooLarge)[success, failure];
        };
        capacity := (sizeHint + 1u64).bytes;
        memory := mapAnonymousReadWrite(capacity)[
            (memory) -> memory,
            (error) -> _closeWithError(descriptor, error)[success, failure]
        ];
        result := _readInto(descriptor, (memory, capacity, 0bytes));
        _finishRead(descriptor, result)[success, failure];
    };

_rewindAndRead :: (Int32, UInt64) -> ReadResult :=
    (descriptor, sizeHint) -> [success, failure] => {
        systemLseek(descriptor, 0i64, _seekStart)[
            (_) -> (),
            (error) -> _closeWithError(descriptor, error)[success, failure]
        ];
        _readSnapshot(descriptor, sizeHint)[success, failure];
    };

_readDescriptor :: Int32 -> ReadResult := (descriptor) -> [success, failure] => {
    sizeHint := systemLseek(descriptor, 0i64, _seekEnd)[
        (sizeHint) -> sizeHint,
        (error) -> _closeWithError(descriptor, error)[success, failure]
    ];
    _rewindAndRead(descriptor, sizeHint)[success, failure];
};

_openPath :: (Address, ByteSize) -> ReadResult :=
    (path, pathMappingLength) -> [success, failure] => {
        opened := systemOpenat(_atCurrentWorkingDirectory, path, 0i32, 0u32);
        unmapped := systemMunmap(path, pathMappingLength);
        descriptor := opened[(descriptor) -> descriptor, failure];
        unmapped[
            () -> (),
            (error) -> _closeWithError(descriptor, error)[success, failure]
        ];
        _readDescriptor(descriptor)[success, failure];
    };

readSource :: Symbol -> ReadResult := (path) -> [success, failure] => {
    bytes := *path;
    length := #bytes;
    when (length == (-1u64).usize) {
        failure(_invalidArgument);
    };
    mappingLength := length.bytes + 1bytes;
    memory := mapAnonymousReadWrite(mappingLength)[(memory) -> memory, failure];
    bytes.into(memory, 0usize, length);
    storeZero(memory, length.bytes);
    _openPath(memory, mappingLength)[success, failure];
};
