require "./memory.mal";
require "./syscall.mal";

_standardOutput :: Int32 := 1i32;
_standardError :: Int32 := 2i32;
_inputOutputError :: UInt32 := 5u32;

_statusSuccess :: Unit -> Status := () -> [success, failure] => success();

_statusFailure :: UInt32 -> Status := (error) -> [success, failure] => failure(error);

_writeAll :: (Int32, Address, ByteSize) -> Status := (descriptor, memory, remaining) -> [return] => {
    when (remaining == 0bytes) {
        return(_statusSuccess());
    };
    transferred := systemWrite(descriptor, memory, remaining);
    return(transferred[
        (length) -> {
            if (length == 0bytes)
            then _statusFailure(_inputOutputError)
            else _writeAll(descriptor, memory + length, remaining - length);
        },
        (error) -> _statusFailure(error)
    ]);
};

_finishWrite :: (Address, ByteSize, Status) -> Status := (memory, length, written) -> {
    unmapped := systemMunmap(memory, length);
    written[
    () -> unmapped,
    (error) -> _statusFailure(error)
    ];
};

writeDescriptor :: (Int32, Symbol) -> Status := (descriptor, value) -> {
    packed := *value;
    length := #packed;
    extent := length * #u8;
    if (length == 0usize)
    then _statusSuccess()
    else {
        mapped := mapAnonymousReadWrite(extent);
        mapped[
        (memory) -> {
            memory@u8@length <- packed;
            written := _writeAll(descriptor, memory, extent);
            _finishWrite(memory, extent, written);
        },
        (error) -> _statusFailure(error)
        ];
    };
};

writeStdout :: Symbol -> Status := (value) -> writeDescriptor(_standardOutput, value);

writeStderr :: Symbol -> Status := (value) -> writeDescriptor(_standardError, value);
