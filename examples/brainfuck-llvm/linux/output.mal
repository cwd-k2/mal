require "./memory.mal";
require "./syscall.mal";

_standardOutput :: Int32 := 1i32;
_standardError :: Int32 := 2i32;
_inputOutputError :: UInt32 := 5u32;

_statusSuccess :: Unit -> SyscallStatus := () -> [success, failure] => success();

_statusFailure :: UInt32 -> SyscallStatus := (error) -> [success, failure] => failure(error);

// Partial writes advance both the address and remaining extent; zero progress becomes an error rather
// than recurring with an unchanged state.
_writeAll :: (Int32, Address, ByteSize, ByteSize) -> SyscallStatus :=
    (descriptor, memory, offset, remaining) -> [return] => {
        when (remaining == 0bytes) {
            return(_statusSuccess());
        };
        transferred := systemWrite(descriptor, memory, offset, remaining);
        return(transferred[
            (length) -> {
                if (length == 0bytes)
                then _statusFailure(_inputOutputError)
                else _writeAll(descriptor, memory, offset + length, remaining - length);
            },
            (error) -> _statusFailure(error)
        ]);
    };

_finishWrite :: (Address, ByteSize, SyscallStatus) -> SyscallStatus := (memory, length, written) -> {
    unmapped := systemMunmap(memory, length);
    written[
    () -> unmapped,
    (error) -> _statusFailure(error)
    ];
};

writeDescriptor :: (Int32, Symbol) -> SyscallStatus := (descriptor, value) -> {
    bytes := *value;
    length := #bytes;
    extent := length.bytes;
    if (length == 0usize)
    then _statusSuccess()
    else {
        mapped := mapAnonymousReadWrite(extent);
        mapped[
        (memory) -> {
            bytes.into(memory, 0usize, length);
            written := _writeAll(descriptor, memory, 0bytes, extent);
            _finishWrite(memory, extent, written);
        },
        (error) -> _statusFailure(error)
        ];
    };
};

writeStdout :: Symbol -> SyscallStatus := (value) -> writeDescriptor(_standardOutput, value);

writeStderr :: Symbol -> SyscallStatus := (value) -> writeDescriptor(_standardError, value);
