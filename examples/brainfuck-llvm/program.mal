require "./compiler.mal";
require "./linux/file.mal";
require "./linux/output.mal";
require "./linux/syscall.mal";

Arguments :: (USize, Address);

_finishOutput :: (Status, Status) -> Int32 := (written, released) -> {
    written[
    () -> {
        released[
        () -> 0,
        (error) -> {
            writeStderr("cannot release source, errno " + error.u64.decimal() + "\n");
            1;
        }
        ];
    },
    (error) -> {
        writeStderr("cannot write output, errno " + error.u64.decimal() + "\n");
        1;
    }
    ];
};

main :: Arguments -> Int32 := (argumentCount, arguments) -> [return] => {
    when (argumentCount != 1usize) {
        writeStderr("usage: brainfuck-llvm SOURCE.bf\n");
        return(2);
    };

    descriptors := <-(arguments @ (address, bytesize) @ argumentCount);
    (pathAddress, pathLength) := descriptors # 0usize;
    path := * (<-(pathAddress @ u8 @ (pathLength.usize)));
    read := readSource(path);
    return(read[
        (source) -> {
            (memory, length, _) := source;
            bytes := <-(memory @ u8 @ length);
            result := compile(bytes);
            status :: Int32 := result[
                (message) -> {
                    writeStderr(message);
                    releaseSource(source);
                    1;
                },
                (state) -> {
                    (_, _, output) := state;
                    written := writeStdout(output);
                    released := releaseSource(source);
                    _finishOutput(written, released);
                }
            ];
            status;
        },
        (error) -> {
            writeStderr("cannot read source, errno " + error.u64.decimal() + "\n");
            1;
        }
    ]);
};
