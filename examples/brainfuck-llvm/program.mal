require "./compiler.mal";
require "./linux/file.mal";
require "./linux/output.mal";
require "./linux/syscall.mal";

// Arguments fields: 0 user argument count, 1 first host-owned argument descriptor.
Arguments :: (USize, Address);

// Preserve a failed output status after the diagnostic attempt; diagnostics do not replace the
// operation that determines the process result.
_finishOutput :: SyscallStatus -> Int32 := (written) -> {
    written[
    () -> 0,
    (error) -> {
        writeStderr("cannot write output, errno " + error.u64.decimal() + "\n");
        1;
    }
    ];
};

main :: Arguments -> Int32 := (argumentCount, arguments) -> [return] => {
    when (argumentCount != 1usize) {
        writeStderr("usage: brainfuck-llvm SOURCE.bf\n");
        return(2);
    };

    // Admit the one required descriptor before interpreting its bytes as an immutable path.
    argumentAddresses := from<Address>(arguments, 0usize, 1usize);
    pathAddress := argumentAddresses.get(0usize);
    path := *from<UInt8>(pathAddress, 0usize, argumentLength(pathAddress));
    read := readSource(path);
    return(read[
        (source) -> {
            result := compile(source);
            status :: Int32 := result[
                (message) -> {
                    writeStderr(message);
                    1;
                },
                (output) -> {
                    written := writeStdout(output);
                    _finishOutput(written);
                }
            ];
            status;
        },
        (error) -> {
            writeStderr("cannot read source, errno " + error.u64.decimal() + "\n");
            1;
        }
    ]);
};
