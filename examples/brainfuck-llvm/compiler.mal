// CompileState fields: next source byte, next loop identity, generated function body.
CompileState :: (USize, UInt64, Symbol);
// CompileStepResult carries a diagnostic or the state immediately after one recursive source range.
CompileStepResult :: [Symbol, CompileState];
// Variant 0 is a diagnostic; variant 1 is a complete LLVM IR module.
CompileResult :: [Symbol, Symbol];

_stepFailure :: Symbol -> CompileStepResult := (message) -> [failure, success] => failure(message);

_stepSuccess :: CompileState -> CompileStepResult := (state) -> [failure, success] => success(state);

_compileFailure :: Symbol -> CompileResult := (message) -> [failure, success] => failure(message);

_compileSuccess :: Symbol -> CompileResult := (output) -> [failure, success] => success(output);

_digit :: UInt64 -> Symbol := (value) -> [return] => {
    when (value == 0u64) return("0");
    when (value == 1u64) return("1");
    when (value == 2u64) return("2");
    when (value == 3u64) return("3");
    when (value == 4u64) return("4");
    when (value == 5u64) return("5");
    when (value == 6u64) return("6");
    when (value == 7u64) return("7");
    when (value == 8u64) return("8");
    return("9");
};

decimal :: UInt64 -> Symbol := (value) -> {
    if (value < 10u64)
    then value._digit()
    else (value / 10u64).decimal() + (value % 10u64)._digit();
};

_simpleInstruction :: UInt8 -> Symbol := (byte) -> [return] => {
    when (byte == '>') return("  call void @bf_right()\n");
    when (byte == '<') return("  call void @bf_left()\n");
    when (byte == '+') return("  call void @bf_increment()\n");
    when (byte == '-') return("  call void @bf_decrement()\n");
    when (byte == '.') return("  call void @bf_output()\n");
    when (byte == ',') return("  call void @bf_input()\n");
    return("");
};

_loopHeader :: UInt64 -> Symbol := (identity) -> {
    name := identity.decimal();
    "  br label %loop" + name + ".test\n"
        + "loop" + name + ".test:\n"
        + "  %loop" + name + ".value = call i8 @bf_current()\n"
        + "  %loop" + name + ".condition = icmp ne i8 %loop" + name + ".value, 0\n"
        + "  br i1 %loop" + name + ".condition, label %loop" + name
        + ".body, label %loop" + name + ".end\n"
        + "loop" + name + ".body:\n";
};

_loopFooter :: UInt64 -> Symbol := (identity) -> {
    name := identity.decimal();
    "  br label %loop" + name + ".test\n"
        + "loop" + name + ".end:\n";
};

// The recursive call for an opening bracket consumes through its matching closing bracket.
// All other transitions are tail calls, so comments and long straight-line programs use bounded
// native stack.
_compileUntil :: (Buffer<UInt8>, USize, UInt64, Bool, Symbol) -> CompileStepResult :=
    (source, index, nextLoop, nested, output) -> [return] => {
        when (index == #source) {
            if (nested)
            then return(_stepFailure("unmatched '['\n"))
            else return(_stepSuccess((index, nextLoop, output)));
        };

        byte := source.get(index);
        when (byte == ']') {
            if (nested)
            then return(_stepSuccess((index + 1usize, nextLoop, output)))
            else return(_stepFailure("unmatched ']'\n"));
        };

        when (byte == '[') {
            identity := nextLoop;
            body := _compileUntil(
                source,
                index + 1usize,
                nextLoop + 1u64,
                true,
                output + identity._loopHeader()
            );
            return(body[
                (message) -> _stepFailure(message),
                (state) -> {
                    (afterBody, afterLoop, bodyOutput) := state;
                    _compileUntil(
                        source,
                        afterBody,
                        afterLoop,
                        nested,
                        bodyOutput + identity._loopFooter()
                    );
                }
            ]);
        };

        instruction := byte._simpleInstruction();
        return(_compileUntil(
            source,
            index + 1usize,
            nextLoop,
            nested,
            output + instruction
        ));
    };

_preamble :: Unit -> Symbol := () -> "declare i32 @getchar()\n"
    + "declare i32 @putchar(i32)\n"
    + "\n"
    + "@tape = internal global [30000 x i8] zeroinitializer\n"
    + "@cursor = internal global ptr @tape\n"
    + "\n"
    + "define internal void @bf_right() {\n"
    + "entry:\n"
    + "  %p = load ptr, ptr @cursor\n"
    + "  %next = getelementptr i8, ptr %p, i64 1\n"
    + "  store ptr %next, ptr @cursor\n"
    + "  ret void\n"
    + "}\n"
    + "\n"
    + "define internal void @bf_left() {\n"
    + "entry:\n"
    + "  %p = load ptr, ptr @cursor\n"
    + "  %next = getelementptr i8, ptr %p, i64 -1\n"
    + "  store ptr %next, ptr @cursor\n"
    + "  ret void\n"
    + "}\n"
    + "\n"
    + "define internal i8 @bf_current() {\n"
    + "entry:\n"
    + "  %p = load ptr, ptr @cursor\n"
    + "  %value = load i8, ptr %p\n"
    + "  ret i8 %value\n"
    + "}\n"
    + "\n"
    + "define internal void @bf_increment() {\n"
    + "entry:\n"
    + "  %p = load ptr, ptr @cursor\n"
    + "  %value = load i8, ptr %p\n"
    + "  %next = add i8 %value, 1\n"
    + "  store i8 %next, ptr %p\n"
    + "  ret void\n"
    + "}\n"
    + "\n"
    + "define internal void @bf_decrement() {\n"
    + "entry:\n"
    + "  %p = load ptr, ptr @cursor\n"
    + "  %value = load i8, ptr %p\n"
    + "  %next = sub i8 %value, 1\n"
    + "  store i8 %next, ptr %p\n"
    + "  ret void\n"
    + "}\n"
    + "\n"
    + "define internal void @bf_output() {\n"
    + "entry:\n"
    + "  %value = call i8 @bf_current()\n"
    + "  %argument = zext i8 %value to i32\n"
    + "  %ignored = call i32 @putchar(i32 %argument)\n"
    + "  ret void\n"
    + "}\n"
    + "\n"
    + "define internal void @bf_input() {\n"
    + "entry:\n"
    + "  %value = call i32 @getchar()\n"
    + "  %byte = trunc i32 %value to i8\n"
    + "  %p = load ptr, ptr @cursor\n"
    + "  store i8 %byte, ptr %p\n"
    + "  ret void\n"
    + "}\n"
    + "\n"
    + "define i32 @main() {\n"
    + "entry:\n";

compile :: Buffer<UInt8> -> CompileResult := (source) -> {
    compiled := _compileUntil(source, 0usize, 0u64, false, _preamble());
    compiled[
    (message) -> _compileFailure(message),
    (state) -> {
        (_, _, output) := state;
        _compileSuccess(output + "  ret i32 0\n}\n");
    }
    ];
};
