require "./host.c";

extern receive :: Unit -> Symbol;
extern send :: Symbol -> Unit;

main :: Unit -> Int32 := () -> {
    value := receive();
    valid := #value == 8usize && value # 3usize == 227u8 && value # 6usize == 0u8 && value # 7usize == 255u8 && value == "malあ\0\xff";
    send(value + "!");
    if (valid)
    then 0
    else 1;
};
