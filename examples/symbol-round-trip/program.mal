require "./host.c";

// The Address names reusable host scratch storage. receive initializes a prefix, while send reads
// a prefix; neither operation retains the address beyond its call.
extern transferBuffer :: Unit -> Address;
extern receive :: (Address, USize) -> USize;
extern send :: (Address, USize) -> Unit;

bufferCapacity :: USize := 16usize;

main :: Unit -> Int32 := () -> {
    address := transferBuffer();
    length := receive(address, bufferCapacity);

    // Admit the initialized host prefix before the transfer buffer is reused for output.
    bytes := from<UInt8>(address, 0usize, length);
    value := *bytes;
    prefix := value / 3usize;
    middle := value % 3usize / 3usize;
    tail := value % 6usize;
    valid := #value == 8usize
        && prefix == "mal"
        && middle == "あ"
        && tail == "\0\xff"
        && prefix + middle + tail == value;
    outgoing := *(prefix + middle + tail + "!");
    outgoing.into(address, 0usize, #outgoing);
    send(address, #outgoing);
    if (valid)
    then 0
    else 1;
};
