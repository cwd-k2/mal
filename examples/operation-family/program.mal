require "./operations.mal";

Pair<A> :: (A, A);

equal<Int32> :: (Int32, Int32) -> Bool := (left, right) -> left == right;
equal<Buffer<A>> :: (Buffer<A>, Buffer<A>) -> Bool := (left, right) -> #left == #right;
zero<Int32> :: Int32 := 0;
extent<Buffer, A> :: Buffer<A> -> USize := (values) -> #values;
extent<Pair, A> :: Pair<A> -> USize := (_) -> 2usize;

same<A> :: (A, A) -> Bool := (left, right) -> equal(left, right);
extentOf<F, A> :: F<A> -> USize := (value) -> extent<F, A>(value);

main :: Unit -> Int32 := () -> {
    left :: Buffer<Symbol> := make(0usize);
    right :: Buffer<Symbol> := make(0usize);
    left.new("generic");
    right.new("operation");
    pair :: Pair<Int32> := (20i32, 22i32);
    if (
        same(21i32 + 21i32, 42i32)
        && same(zero, 0i32)
        && same(left, right)
        && extentOf<Buffer>(left) == 1usize
        && extentOf<Pair>(pair) == 2usize
    )
    then 0
    else 1;
};
