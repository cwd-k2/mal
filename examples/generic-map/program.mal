require "./map.mal";

Pair<A> :: (A, A);

equal<Symbol> :: (Symbol, Symbol) -> Bool := (left, right) -> left == right;

equal<Pair<K>> :: (Pair<K>, Pair<K>) -> Bool := (left, right) -> {
    (leftFirst, leftSecond) := left;
    (rightFirst, rightSecond) := right;
    equal(leftFirst, rightFirst) && equal(leftSecond, rightSecond);
};

_hashSymbolFrom :: (Symbol, USize, UInt64) -> UInt64 := (value, index, state) ->
    [return] => {
        when (index == #value) return(state);
        return(_hashSymbolFrom(
            value,
            index + 1usize,
            state * 31u64 + (value # index).u64
        ));
    };

hash<Symbol> :: Symbol -> UInt64 := (value) -> _hashSymbolFrom(value, 0usize, 0u64);

hash<Pair<K>> :: Pair<K> -> UInt64 := (value) -> {
    (first, second) := value;
    hash(first) * 31u64 + hash(second);
};

main :: Unit -> Int32 := () -> [return] => {
    words :: HashMap<Symbol, Int32> := hashMap(4usize);
    first := words.hashMapPut("a", 10i32);
    collision := words.hashMapPut("e", 20i32);
    anotherCollision := words.hashMapPut("i", 30i32);
    overwrite := words.hashMapPut("e", 22i32);

    aFound := words.hashMapGet("a")[const(false), (value) -> value == 10i32];
    eUpdated := words.hashMapGet("e")[const(false), (value) -> value == 22i32];
    iFound := words.hashMapGet("i")[const(false), (value) -> value == 30i32];
    missing := words.hashMapGet("missing")[const(true), const(false)];

    full :: HashMap<Symbol, Int32> := hashMap(2usize);
    full.hashMapPut("a", 1i32);
    full.hashMapPut("e", 2i32);
    rejected := !full.hashMapPut("i", 3i32);

    empty :: HashMap<Symbol, Int32> := hashMap(0usize);
    emptyRejected := !empty.hashMapPut("a", 1i32);
    emptyMissing := empty.hashMapGet("a")[const(true), const(false)];

    pairs :: HashMap<Pair<Symbol>, Int32> := hashMap(4usize);
    pairInserted := pairs.hashMapPut(("mal", "language"), 42i32);
    pairFound := pairs.hashMapGet(("mal", "language"))[
        const(false),
        (value) -> value == 42i32
    ];

    when (!(
        first
        && collision
        && anotherCollision
        && overwrite
        && aFound
        && eUpdated
        && iFound
        && missing
        && rejected
        && emptyRejected
        && emptyMissing
        && pairInserted
        && pairFound
    )) return(1);
    return(0);
};
