require "./host.c";

extern memory :: Unit -> Address;

main :: Unit -> Int32 := () -> {
    base := memory();
    slot := (base + 1bytes)@i64;
    slot <- 41i64;
    byte := (?slot + #i64)@u8;
    byte <- 1u8;
    (number, _) := <-slot;
    (small, _) := <-byte;
    (number + small.i64 - 42i64).i32;
};
