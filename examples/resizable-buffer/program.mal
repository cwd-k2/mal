require "./host.c";

extern Allocation;

// Buffer fields: 0 allocation identity, 1 writable memory, 2 capacity, 3 initialized length.
Buffer :: (Allocation, Ptr, UInt64, UInt64);
// Slice fields: 0 allocation identity, 1 readable memory, 2 byte length.
Slice :: (Allocation, Ptr, UInt64);
// BufferResult variant 0 carries the current buffer; variant 1 carries an error code.
BufferResult :: [Buffer, UInt32];
// SliceResult variant 0 carries an in-bounds slice; variant 1 reports invalid bounds.
SliceResult :: [Slice, Unit];

extern allocateBuffer :: (UInt64, UInt64) -> BufferResult;
extern resizeBuffer :: (Buffer, UInt64) -> BufferResult;
extern releaseBuffer :: Allocation -> Unit;
extern isCurrentBuffer :: Buffer -> Bool;
extern isCurrentSlice :: Slice -> Bool;
extern writeSlice :: Slice -> Unit;
extern writeSliceDescriptor :: (Allocation, Ptr) -> Unit;
extern writeSymbol :: Symbol -> Unit;

_bufferSuccess :: Buffer -> BufferResult := (buffer) -> [success, failure] => success(buffer);

_bufferFailure :: UInt32 -> BufferResult := (error) -> [success, failure] => failure(error);

nextCapacity :: (UInt64, UInt64) -> UInt64 := (capacity, required) -> [return] => {
    when (capacity >= required) {
        return(capacity);
    };
    when (capacity > 0x7fff_ffff_ffff_ffffu64) {
        return(required);
    };
    return((capacity * 2u64).nextCapacity(required));
};

appendSymbol :: (Buffer, Symbol) -> BufferResult := (buffer, value) -> [return] => {
    (allocation, memory, capacity, length) := buffer;
    additional := #value;
    when (additional > 0xffff_ffff_ffff_ffffu64 - length) {
        return(_bufferFailure(1u32));
    };
    required := length + additional;
    available := if (required <= capacity)
        then _bufferSuccess(buffer)
        else {
            target := capacity.nextCapacity(required);
            buffer.resizeBuffer(target);
        };
    result :: BufferResult := available[
        (resized) -> [success, failure] => {
            (nextAllocation, nextMemory, nextCapacityValue, _) := resized;
            Symbol.write(nextMemory + length, value);
            success((nextAllocation, nextMemory, nextCapacityValue, required));
        },
        (error) -> [success, failure] => failure(error)
    ];
    return(result);
};

sliceBuffer :: (Buffer, UInt64, UInt64) -> SliceResult :=
    (buffer, start, length) -> [slice, invalid] => {
        (allocation, memory, _, initialized) := buffer;
        when (start <= initialized && length <= initialized - start) {
            slice((allocation, memory + start, length));
        };
        invalid();
    };

releaseBufferValue :: Buffer -> Unit := (buffer) -> {
    (allocation, _, _, _) := buffer;
    allocation.releaseBuffer();
};

writeThroughDescriptor :: Slice -> Bool := (slice) -> {
    (allocation, memory, length) := slice;
    // Shared descriptor bytes contain only Ptr memory followed by UInt64 length.
    descriptorSize := Ptr.size + UInt64.size;
    allocated := allocateBuffer(descriptorSize, descriptorSize);
    allocated[
    (descriptor) -> {
        (descriptorAllocation, descriptorMemory, _, _) := descriptor;
        Ptr.store(descriptorMemory, memory);
        UInt64.store(descriptorMemory + Ptr.size, length);
        writeSliceDescriptor(allocation, descriptorMemory);
        descriptorAllocation.releaseBuffer();
        true;
    },
    (_) -> false
    ];
};

finishLimitTest :: (Buffer, Bool) -> Int32 := (buffer, aliasesInvalid) -> {
    rejected := buffer.appendSymbol(
        "this append is intentionally larger than the allocation limit for the pressure test"
    );
    rejected[
    (unexpected) -> {
        unexpected.releaseBufferValue();
        5;
    },
    (_) -> {
        current := buffer.isCurrentBuffer();
        buffer.releaseBufferValue();
        if (aliasesInvalid && current)
        then {
            writeSymbol("resize rejected\n");
            0;
        }
        else 6;
    }
    ];
};

afterGrowth :: (Buffer, Slice) -> Int32 := (before, staleSlice) -> {
    grownResult := before.appendSymbol("-shared-buffer");
    grownResult[
    (grown) -> {
        aliasesInvalid := !before.isCurrentBuffer() && !staleSlice.isCurrentSlice();
        (_, _, _, length) := grown;
        sliceResult := grown.sliceBuffer(0u64, length);
        sliceResult[
        (currentSlice) -> {
            if (currentSlice.writeThroughDescriptor())
            then {
                writeSymbol("\n");
                grown.finishLimitTest(aliasesInvalid);
            }
            else {
                grown.releaseBufferValue();
                4;
            };
        },
        () -> {
            grown.releaseBufferValue();
            4;
        }
        ];
    },
    (_) -> {
        before.releaseBufferValue();
        3;
    }
    ];
};

withInitialValue :: Buffer -> Int32 := (initial) -> {
    appended := initial.appendSymbol("mal");
    appended[
    (buffer) -> {
        invalidSlice := buffer.sliceBuffer(2u64, 2u64);
        invalidSlice[
        (_) -> {
            buffer.releaseBufferValue();
            8;
        },
        () -> {
            sliceResult := buffer.sliceBuffer(1u64, 2u64);
            sliceResult[
            (slice) -> {
                writeSlice(slice);
                writeSymbol("\n");
                buffer.afterGrowth(slice);
            },
            () -> {
                buffer.releaseBufferValue();
                2;
            }
            ];
        }
        ];
    },
    (_) -> {
        initial.releaseBufferValue();
        1;
    }
    ];
};

main :: Unit -> Int32 := () -> {
    allocated := allocateBuffer(4u64, 64u64);
    allocated[
    (buffer) -> buffer.withInitialValue(),
    (_) -> 7
    ];
};
