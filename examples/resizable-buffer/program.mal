require "./host.c";

// Both externs operate on reusable host transfer storage; no Buffer identity crosses this boundary.
extern transferBuffer :: Unit -> Address;
extern writeBytes :: (Address, USize) -> Unit;

// The cursor is the complete recursive state. Appending may grow destination without invalidating
// either Buffer value because aliases refer to the same managed identity.
append :: (Buffer<UInt8>, Buffer<UInt8>, USize) -> Unit := (destination, source, index) -> [return] => {
    when (index == #source) {
        return(());
    };
    destination.new(source.get(index));
    return(destination.append(source, index + 1usize));
};

appendSymbol :: (Buffer<UInt8>, Symbol) -> Unit := (destination, value) ->
    destination.append(*value, 0usize);

// Copy only the requested logical range into host storage immediately before the external write.
writeRange :: (Buffer<UInt8>, USize, USize) -> Unit := (bytes, offset, length) -> {
    memory := transferBuffer();
    bytes.into(memory, offset, length);
    writeBytes(memory, length);
};

main :: Unit -> Int32 := () -> {
    bytes := make<UInt8>(2usize);
    bytes.appendSymbol("mal");

    // Assignment copies the managed identity. Growth and mutation remain visible through both names.
    alias := bytes;
    alias.appendSymbol("-shared-buffer\n");

    bytes.writeRange(1usize, 2usize);
    newline := *"\n";
    newline.writeRange(0usize, #newline);
    bytes.writeRange(0usize, #bytes);
    0;
};
