require "./host.c";

extern Allocation;
// ResizeResult variant 0 reports failure; variant 1 carries the handle and logical element count.
ResizeResult :: [Unit, (Allocation, USize)];
extern allocate :: USize -> Allocation;
extern resize :: (Allocation, USize) -> ResizeResult;
extern handleBits :: Allocation -> UInt64;

validateResize :: (Allocation, USize) -> Int32 := (sized) -> {
    (allocation, length) := sized;
    if (allocation.handleBits() == 42u64 && length == 2usize)
    then 0
    else 1;
};

main :: Unit -> Int32 := () -> {
    allocation := allocate(40usize);
    resized := allocation.resize(2usize);
    resized[() -> 1, (result) -> result.validateResize()];
};
