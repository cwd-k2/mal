require "./host.c";

extern Mem;
// Response variant 0 reports failure; variant 1 carries the handle and logical length.
Response :: [Unit, (Mem, UInt64)];
extern allocate :: UInt64 -> Mem;
extern resize :: (Mem, UInt64) -> Response;
extern handleBits :: Mem -> UInt64;

validate :: (Mem, UInt64) -> Int32 := (mem, length) {
    if (handleBits(mem) == 42u64 && length == 2u64)
    then { 0 }
    else { 1 };
};

main :: Unit -> Int32 := () {
    mem := allocate(40u64);
    response := resize(mem, 2u64);
    response[
    () { 1 },
    (result) { validate(result) }
    ];
};
