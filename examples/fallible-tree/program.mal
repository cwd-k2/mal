require "./host.c";

extern Allocator;

// NodeResult variant 0 carries allocated node memory; variant 1 reports allocation failure.
NodeResult :: [Address, Unit];

extern createAllocator :: USize -> Allocator;
extern allocateNode :: (Allocator, ByteSize) -> NodeResult;
extern releaseNode :: (Allocator, Address) -> Unit;
extern destroyAllocator :: Allocator -> Unit;

createLeaf :: (Allocator, Int32) -> NodeResult := (allocator, value) -> {
    allocated := allocator.allocateNode(#i32 + #u8);
    allocated[
    (node) -> [created, failed] => {
        _ := node @ i32 <-value;
        _ := (node + #i32) @ u8 <-0u8;
        created(node);
    },
    () -> [created, failed] => failed()
    ];
};

sumTree :: Address -> Int32 := (node) -> [return] => {
    (value, _) := <-(node @ i32);
    (isBranch, _) := <-((node + #i32) @ u8);
    when (isBranch == 0u8) {
        return(value);
    };

    children := (node + #i32 + #u8) @ address;
    (left, next) := <-children;
    (right, _) := <-next;
    return(value + left.sumTree() + right.sumTree());
};

destroyTree :: (Address, Allocator) -> Unit := (node, allocator) -> [return] => {
    (isBranch, _) := <-((node + #i32) @ u8);
    when (isBranch == 0u8) {
        return(allocator.releaseNode(node));
    };

    children := (node + #i32 + #u8) @ address;
    (left, next) := <-children;
    (right, _) := <-next;
    left.destroyTree(allocator);
    right.destroyTree(allocator);
    return(allocator.releaseNode(node));
};

createOwnedBranch :: (Allocator, Int32, Address, Address) -> NodeResult :=
    (allocator, value, left, right) -> {
        allocated := allocator.allocateNode(#i32 + #u8 + 2usize * #address);
        allocated[
        (node) -> [created, failed] => {
            _ := node @ i32 <-value;
            _ := (node + #i32) @ u8 <-1u8;
            children := (node + #i32 + #u8) @ address;
            next := children <-left;
            _ := next <-right;
            created(node);
        },
        () -> [created, failed] => {
            left.destroyTree(allocator);
            right.destroyTree(allocator);
            failed();
        }
        ];
    };

buildLeft :: Allocator -> NodeResult := (allocator) -> {
    first := allocator.createLeaf(3);
    first[
    (left) -> {
        second := allocator.createLeaf(4);
        second[
        (right) -> allocator.createOwnedBranch(2, left, right),
        () -> [created, failed] => {
            left.destroyTree(allocator);
            failed();
        }
        ];
    },
    () -> [created, failed] => failed()
    ];
};

buildTree :: Allocator -> NodeResult := (allocator) -> {
    leftResult := allocator.buildLeft();
    leftResult[
    (left) -> {
        rightResult := allocator.createLeaf(5);
        rightResult[
        (right) -> allocator.createOwnedBranch(1, left, right),
        () -> [created, failed] => {
            left.destroyTree(allocator);
            failed();
        }
        ];
    },
    () -> [created, failed] => failed()
    ];
};

successfulBuild :: Unit -> Bool := () -> {
    allocator := createAllocator(5usize);
    result := allocator.buildTree();
    valid := result[
        (tree) -> {
            total := tree.sumTree();
            tree.destroyTree(allocator);
            total == 15;
        },
        () -> false
    ];
    allocator.destroyAllocator();
    valid;
};

failedBuildCleansPartialTree :: Unit -> Bool := () -> {
    allocator := createAllocator(3usize);
    result := allocator.buildTree();
    failed := result[
        (tree) -> {
            tree.destroyTree(allocator);
            false;
        },
        () -> true
    ];
    allocator.destroyAllocator();
    failed;
};

main :: Unit -> Int32 := () -> {
    if (successfulBuild() && failedBuildCleansPartialTree())
    then 0
    else 1;
};
