require "./host.c";

extern Allocator;

// NodeAddress is an external-storage coordinate whose record layout is established by constructors.
NodeAddress :: Address;
// NodeBuildResult carries a constructed root coordinate or a recoverable allocation failure.
NodeBuildResult :: [NodeAddress, Unit];
NodeRecord :: (Int32, UInt8, Address, Address);

extern createAllocator :: USize -> Allocator;
extern allocateNode :: Allocator -> NodeBuildResult;
extern releaseNode :: (Allocator, NodeAddress) -> Unit;
extern destroyAllocator :: Allocator -> Unit;

writeNode :: (NodeAddress, NodeRecord) -> Unit := (node, record) -> {
    value := make<NodeRecord>(1usize);
    value.new(record);
    value.into(node, 0usize, 1usize);
};

readNode :: NodeAddress -> NodeRecord := (node) ->
    from<NodeRecord>(node, 0usize, 1usize).get(0usize);

createLeaf :: (Allocator, Int32) -> NodeBuildResult := (allocator, value) -> [created, failed] => {
    node := allocator.allocateNode()[
        (allocated) -> allocated,
        () -> failed()
    ];
    node.writeNode((value, 0u8, node, node));
    created(node);
};

sumSubtree :: NodeAddress -> Int32 := (node) -> [return] => {
    (value, isBranch, left, right) := node.readNode();
    when (isBranch == 0u8) {
        return(value);
    };

    return(value + left.sumSubtree() + right.sumSubtree());
};

// Post-order recursion releases both children before their parent; that cleanup order is the domain
// operation and cannot be replaced by a cursor-only loop without an explicit work stack.
releaseSubtree :: (NodeAddress, Allocator) -> Unit := (node, allocator) -> [return] => {
    (_, isBranch, left, right) := node.readNode();
    when (isBranch == 0u8) {
        return(allocator.releaseNode(node));
    };

    left.releaseSubtree(allocator);
    right.releaseSubtree(allocator);
    return(allocator.releaseNode(node));
};

createOwnedBranch :: (Allocator, Int32, NodeAddress, NodeAddress) -> NodeBuildResult :=
    (allocator, value, left, right) -> [created, failed] => {
        node := allocator.allocateNode()[
            (allocated) -> allocated,
            () -> {
                left.releaseSubtree(allocator);
                right.releaseSubtree(allocator);
                failed();
            }
        ];
        node.writeNode((value, 1u8, left, right));
        created(node);
    };

buildLeftSubtree :: Allocator -> NodeBuildResult := (allocator) -> [created, failed] => {
    left := allocator.createLeaf(3)[
        (node) -> node,
        () -> failed()
    ];
    right := allocator.createLeaf(4)[
        (node) -> node,
        () -> {
            left.releaseSubtree(allocator);
            failed();
        }
    ];
    allocator.createOwnedBranch(2, left, right)[
    created,
    failed
    ];
};

buildTree :: Allocator -> NodeBuildResult := (allocator) -> [created, failed] => {
    left := allocator.buildLeftSubtree()[
        (node) -> node,
        () -> failed()
    ];
    right := allocator.createLeaf(5)[
        (node) -> node,
        () -> {
            left.releaseSubtree(allocator);
            failed();
        }
    ];
    allocator.createOwnedBranch(1, left, right)[
    created,
    failed
    ];
};

successfulBuild :: Unit -> Bool := () -> {
    allocator := createAllocator(5usize);
    result := allocator.buildTree();
    valid := result[
        (root) -> {
            total := root.sumSubtree();
            root.releaseSubtree(allocator);
            total == 15;
        },
        () -> false
    ];
    allocator.destroyAllocator();
    valid;
};

failedBuildCleansPartialTree :: Unit -> Bool := () -> {
    allocator := createAllocator(3usize);
    result := allocator.buildTree();
    failed := result[
        (root) -> {
            root.releaseSubtree(allocator);
            false;
        },
        () -> true
    ];
    allocator.destroyAllocator();
    failed;
};

main :: Unit -> Int32 := () -> {
    if (successfulBuild() && failedBuildCleansPartialTree())
    then 0
    else 1;
};
