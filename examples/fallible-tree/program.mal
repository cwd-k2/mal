require "./host.c";

extern Allocator;

// NodeResult variant 0 carries allocated node memory; variant 1 reports allocation failure.
NodeResult :: [Ptr, Unit];

extern createAllocator :: UInt64 -> Allocator;
extern allocateNode :: (Allocator, UInt64) -> NodeResult;
extern releaseNode :: (Allocator, Ptr) -> Unit;
extern destroyAllocator :: Allocator -> Unit;

// Node bytes are Int32 value, UInt8 tag, then two Ptr fields for tag 1.
// Tag 0 is a 5-byte leaf; tag 1 stores left and right at offsets 5 and 5 + Ptr.size.
createLeaf :: (Allocator, Int32) -> NodeResult := (allocator, value) -> {
    allocated := allocator.allocateNode(5u64);
    allocated[
    (node) -> [created, failed] => {
        Int32.store(node, value);
        UInt8.store(node + 4u64, 0u8);
        created(node);
    },
    () -> [created, failed] => failed()
    ];
};

sumTree :: Ptr -> Int32 := (node) -> [return] => {
    value := Int32.load(node);
    isBranch := UInt8.load(node + 4u64);
    when (isBranch == 0u8) {
        return(value);
    };

    left := Ptr.load(node + 5u64);
    right := Ptr.load(node + 5u64 + Ptr.size);
    return(value + left.sumTree() + right.sumTree());
};

destroyTree :: (Ptr, Allocator) -> Unit := (node, allocator) -> [return] => {
    isBranch := UInt8.load(node + 4u64);
    when (isBranch == 0u8) {
        return(allocator.releaseNode(node));
    };

    left := Ptr.load(node + 5u64);
    right := Ptr.load(node + 5u64 + Ptr.size);
    left.destroyTree(allocator);
    right.destroyTree(allocator);
    return(allocator.releaseNode(node));
};

createOwnedBranch :: (Allocator, Int32, Ptr, Ptr) -> NodeResult :=
    (allocator, value, left, right) -> {
        allocated := allocator.allocateNode(5u64 + Ptr.size * 2u64);
        allocated[
        (node) -> [created, failed] => {
            Int32.store(node, value);
            UInt8.store(node + 4u64, 1u8);
            Ptr.store(node + 5u64, left);
            Ptr.store(node + 5u64 + Ptr.size, right);
            created(node);
        },
        () -> [created, failed] => {
            left.destroyTree(allocator);
            right.destroyTree(allocator);
            failed();
        }
        ];
    };

buildLeft :: Allocator -> NodeResult := (allocator) -> {
    first := allocator.createLeaf(3);
    first[
    (left) -> {
        second := allocator.createLeaf(4);
        second[
        (right) -> allocator.createOwnedBranch(2, left, right),
        () -> [created, failed] => {
            left.destroyTree(allocator);
            failed();
        }
        ];
    },
    () -> [created, failed] => failed()
    ];
};

buildTree :: Allocator -> NodeResult := (allocator) -> {
    leftResult := allocator.buildLeft();
    leftResult[
    (left) -> {
        rightResult := allocator.createLeaf(5);
        rightResult[
        (right) -> allocator.createOwnedBranch(1, left, right),
        () -> [created, failed] => {
            left.destroyTree(allocator);
            failed();
        }
        ];
    },
    () -> [created, failed] => failed()
    ];
};

successfulBuild :: Unit -> Bool := () -> {
    allocator := createAllocator(5u64);
    result := allocator.buildTree();
    valid := result[
        (tree) -> {
            total := tree.sumTree();
            tree.destroyTree(allocator);
            total == 15;
        },
        () -> false
    ];
    allocator.destroyAllocator();
    valid;
};

failedBuildCleansPartialTree :: Unit -> Bool := () -> {
    allocator := createAllocator(3u64);
    result := allocator.buildTree();
    failed := result[
        (tree) -> {
            tree.destroyTree(allocator);
            false;
        },
        () -> true
    ];
    allocator.destroyAllocator();
    failed;
};

main :: Unit -> Int32 := () -> {
    if (successfulBuild() && failedBuildCleansPartialTree())
    then 0
    else 1;
};
