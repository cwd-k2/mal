require "./host.c";

extern Allocator;

// NodeAddress is only an external-storage coordinate. NodeBuildResult reports recoverable allocation
// failure; successful constructors establish the record layout and child relation described below.
NodeAddress :: Address;
NodeBuildResult :: [NodeAddress, Unit];

extern createAllocator :: USize -> Allocator;
extern allocateNode :: (Allocator, ByteSize) -> NodeBuildResult;
extern releaseNode :: (Allocator, NodeAddress) -> Unit;
extern destroyAllocator :: Allocator -> Unit;

createLeaf :: (Allocator, Int32) -> NodeBuildResult := (allocator, value) -> {
    allocated := allocator.allocateNode(#i32 + #u8);
    allocated[
    (node) -> [created, failed] => {
        node.view<Int32>(0usize, 1usize, (region) -> region.put(0usize, value));
        (node + #i32).view<UInt8>(0usize, 1usize, (region) -> region.put(0usize, 0u8));
        created(node);
    },
    () -> [created, failed] => failed()
    ];
};

sumSubtree :: NodeAddress -> Int32 := (node) -> [return] => {
    value := node.view<Int32>(0usize, 1usize, (region) -> region.get(0usize));
    isBranch := (node + #i32).view<UInt8>(0usize, 1usize, (region) -> region.get(0usize));
    when (isBranch == 0u8) {
        return(value);
    };

    // Ordinary Address values can leave the view; no owned sequence is needed for two fields.
    (left, right) := (node + #i32 + #u8).view<Address>(0usize, 2usize, (children) ->
        (children.get(0usize), children.get(1usize))
    );
    return(value + left.sumSubtree() + right.sumSubtree());
};

releaseSubtree :: (NodeAddress, Allocator) -> Unit := (node, allocator) -> [return] => {
    isBranch := (node + #i32).view<UInt8>(0usize, 1usize, (region) -> region.get(0usize));
    when (isBranch == 0u8) {
        return(allocator.releaseNode(node));
    };

    (left, right) := (node + #i32 + #u8).view<Address>(0usize, 2usize, (children) ->
        (children.get(0usize), children.get(1usize))
    );
    left.releaseSubtree(allocator);
    right.releaseSubtree(allocator);
    return(allocator.releaseNode(node));
};

createOwnedBranch :: (Allocator, Int32, NodeAddress, NodeAddress) -> NodeBuildResult :=
    (allocator, value, left, right) -> {
        allocated := allocator.allocateNode(#i32 + #u8 + 2usize * #address);
        allocated[
        (node) -> [created, failed] => {
            node.view<Int32>(0usize, 1usize, (region) -> region.put(0usize, value));
            (node + #i32).view<UInt8>(0usize, 1usize, (region) -> region.put(0usize, 1u8));
            (node + #i32 + #u8).view<Address>(0usize, 2usize, (children) -> {
                children.put(0usize, left);
                children.put(1usize, right);
            });
            created(node);
        },
        () -> [created, failed] => {
            left.releaseSubtree(allocator);
            right.releaseSubtree(allocator);
            failed();
        }
        ];
    };

buildLeftSubtree :: Allocator -> NodeBuildResult := (allocator) -> {
    first := allocator.createLeaf(3);
    first[
    (left) -> {
        second := allocator.createLeaf(4);
        second[
        (right) -> allocator.createOwnedBranch(2, left, right),
        () -> [created, failed] => {
            left.releaseSubtree(allocator);
            failed();
        }
        ];
    },
    () -> [created, failed] => failed()
    ];
};

buildTree :: Allocator -> NodeBuildResult := (allocator) -> {
    leftResult := allocator.buildLeftSubtree();
    leftResult[
    (left) -> {
        rightResult := allocator.createLeaf(5);
        rightResult[
        (right) -> allocator.createOwnedBranch(1, left, right),
        () -> [created, failed] => {
            left.releaseSubtree(allocator);
            failed();
        }
        ];
    },
    () -> [created, failed] => failed()
    ];
};

successfulBuild :: Unit -> Bool := () -> {
    allocator := createAllocator(5usize);
    result := allocator.buildTree();
    valid := result[
        (root) -> {
            total := root.sumSubtree();
            root.releaseSubtree(allocator);
            total == 15;
        },
        () -> false
    ];
    allocator.destroyAllocator();
    valid;
};

failedBuildCleansPartialTree :: Unit -> Bool := () -> {
    allocator := createAllocator(3usize);
    result := allocator.buildTree();
    failed := result[
        (root) -> {
            root.releaseSubtree(allocator);
            false;
        },
        () -> true
    ];
    allocator.destroyAllocator();
    failed;
};

main :: Unit -> Int32 := () -> {
    if (successfulBuild() && failedBuildCleansPartialTree())
    then 0
    else 1;
};
