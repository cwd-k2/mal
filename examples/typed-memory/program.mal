require "./host.c";

extern unalignedStorage :: Unit -> Address;
extern incrementSample :: Address -> Unit;

Sample :: (Int64, UInt8);

main :: Unit -> Int32 := () -> {
    base := unalignedStorage();
    alignedSample := base.view<Sample>(0usize, 1usize, (region) -> {
        region.put(0usize, (1i64, 2u8));
        region.get(0usize);
    });
    (alignedNumber, alignedSmall) := alignedSample;
    firstAddress := base + 1bytes;
    secondAddress := firstAddress + #(i64, u8);
    firstAddress.view<Sample>(0usize, 1usize, (region) -> region.put(0usize, (7i64, 9u8)));
    secondAddress.view<Sample>(0usize, 1usize, (region) -> region.put(0usize, (40i64, 1u8)));
    firstValue := firstAddress.view<Sample>(0usize, 1usize, (region) -> region.get(0usize));
    secondValue := secondAddress.view<Sample>(0usize, 1usize, (region) -> region.get(0usize));
    firstAddress.view<Sample>(0usize, 1usize, (region) -> region.put(0usize, secondValue));
    secondAddress.view<Sample>(0usize, 1usize, (region) -> region.put(0usize, firstValue));
    incrementSample(firstAddress);
    incremented := firstAddress.view<Sample>(0usize, 1usize, (region) -> region.get(0usize));
    moved := secondAddress.view<Sample>(0usize, 1usize, (region) -> region.get(0usize));
    (number, small) := incremented;
    (movedNumber, movedSmall) := moved;
    if (alignedNumber == 1i64
        && alignedSmall == 2u8
        && number == 41i64
        && small == 2u8
        && movedNumber == 7i64
        && movedSmall == 9u8)
    then 0
    else 1;
};
