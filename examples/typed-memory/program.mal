require "./host.c";

extern unalignedStorage :: Unit -> Address;

CursorStep<A> :: (A, Cursor<A>);

readCursor<A> :: Cursor<A> -> CursorStep<A> := (cursor) -> <-cursor;

writeCursor<A> :: (Cursor<A>, A) -> Cursor<A> := (cursor, value) -> cursor <- value;

main :: Unit -> Int32 := () -> {
    base := unalignedStorage();
    slot := (base + 1bytes)@i64;
    writeCursor<Int64>(slot, 41i64);
    byte := (?slot + #i64)@u8;
    writeCursor<UInt8>(byte, 1u8);
    (number, _) := readCursor<Int64>(slot);
    (small, _) := readCursor<UInt8>(byte);
    (number + small.i64 - 42i64).i32;
};
