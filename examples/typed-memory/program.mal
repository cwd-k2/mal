require "./host.c";

extern unalignedStorage :: Unit -> Address;
extern incrementSample :: Address -> Unit;

Sample :: (Int64, UInt8);

swap<A> :: (Cursor<A>, Cursor<A>) -> Unit := (left, right) -> {
    (leftValue, _) := <-left;
    (rightValue, _) := <-right;
    left <- rightValue;
    right <- leftValue;
    ();
};

main :: Unit -> Int32 := () -> {
    base := unalignedStorage();
    first := (base + 1bytes)@(i64, u8);
    second := first <- (7i64, 9u8);
    second <- (40i64, 1u8);
    swap<Sample>(first, second);
    incrementSample(?first);
    (incremented, next) := <-first;
    (moved, _) := <-next;
    (number, small) := incremented;
    (movedNumber, movedSmall) := moved;
    if (number == 41i64 && small == 2u8 && movedNumber == 7i64 && movedSmall == 9u8)
    then 0
    else 1;
};
