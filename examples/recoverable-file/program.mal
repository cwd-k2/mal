require "./host.c";

// ByteBuffer fields: 0 writable memory, 1 capacity, 2 initialized byte length.
ByteBuffer :: (Address, USize, USize);
// WritableBytes fields: 0 writable memory, 1 available byte count.
WritableBytes :: (Address, USize);

extern Allocation;
extern File;

// IoError preserves the host error code across recoverable result variants.
IoError :: UInt32;
// OwnedBuffer fields: 0 allocation authority, 1 mal-visible byte buffer descriptor.
OwnedBuffer :: (Allocation, ByteBuffer);
// OpenResult variant 0 carries a file; variant 1 carries the host error code.
OpenResult :: [File, IoError];
// ReadResult variant 0 carries the transferred length; variant 1 carries the host error code.
ReadResult :: [USize, IoError];
// CloseResult variant 0 carries success; variant 1 carries the host error code.
CloseResult :: [Unit, IoError];
// CopyResult variant 0 carries completion; variant 1 carries the preserved operation error.
CopyResult :: [Unit, IoError];

extern allocateBuffer :: USize -> OwnedBuffer;
extern releaseBuffer :: Allocation -> Unit;
extern openReadOnly :: (Address, USize) -> OpenResult;
extern readFile :: (File, WritableBytes) -> ReadResult;
extern closeFile :: File -> CloseResult;
extern writeBytes :: (Address, USize) -> Unit;
extern writeError :: IoError -> Unit;

// Arguments fields: 0 argument count, 1 first external descriptor address.
Arguments :: (USize, Address);

bufferSize :: USize := 4096usize;

_completed :: Unit -> CopyResult := () -> [complete, failed] => complete();

// A tail step owns one read result: EOF completes, bytes make observable progress, and an error exits
// through CopyResult before copyPath performs the common close-and-release cleanup.
copyContents :: (File, ByteBuffer) -> CopyResult := (file, buffer) -> {
    (memory, capacity, _) := buffer;
    result := file.readFile((memory, capacity));
    result[
    (length) -> [return] => {
        when (length == 0usize) {
            return(_completed());
        };
        writeBytes(memory, length);
        return(file.copyContents((memory, capacity, length)));
    },
    (error) -> [complete, failed] => failed(error)
    ];
};

finishCopy :: (CopyResult, CloseResult) -> CopyResult := (copied, closed) -> {
    copied[
    () -> {
        closed[
        () -> [complete, failed] => complete(),
        (error) -> [complete, failed] => failed(error)
        ];
    },
    (error) -> [complete, failed] => failed(error)
    ];
};

copyPath :: (Address, USize) -> CopyResult := (path) -> {
    owned := allocateBuffer(bufferSize);
    (allocation, buffer) := owned;
    opened := openReadOnly(path);
    outcome := opened[
        (file) -> {
            copied := file.copyContents(buffer);
            closed := file.closeFile();
            copied.finishCopy(closed);
        },
        (error) -> [complete, failed] => failed(error)
    ];
    allocation.releaseBuffer();
    outcome;
};

main :: Arguments -> Int32 := (argumentCount, arguments) -> [return] => {
    when (argumentCount != 1usize) {
        writeError(22u32);
        return(2);
    };

    // Admit the descriptor value; the referenced path remains process-owned through main.
    descriptors := arguments.pack<(Address, ByteSize)>(0usize, argumentCount);
    (pathAddress, pathLength) := descriptors # 0usize;
    result := copyPath(pathAddress, pathLength.usize);
    status :: Int32 := result[
        () -> 0,
        (error) -> {
            writeError(error);
            1;
        }
    ];
    return(status);
};
