require "./host.c";

// Buffer fields: 0 writable memory, 1 capacity, 2 initialized byte length.
Buffer :: (Ptr, UInt64, UInt64);
// Region fields: 0 writable memory, 1 byte length.
Region :: (Ptr, UInt64);
// Bytes fields: 0 readable memory, 1 byte length.
Bytes :: (Ptr, UInt64);

extern Allocation;
extern File;

IoError :: UInt32;
// OwnedBuffer fields: 0 allocation authority, 1 mal-visible buffer descriptor.
OwnedBuffer :: (Allocation, Buffer);
// OpenResult variant 0 carries a file; variant 1 carries the host error code.
OpenResult :: [File, IoError];
// ReadResult variant 0 carries the transferred length; variant 1 carries the host error code.
ReadResult :: [UInt64, IoError];
// CloseResult variant 0 carries success; variant 1 carries the host error code.
CloseResult :: [Unit, IoError];
// Status variant 0 carries completion; variant 1 carries the preserved operation error.
Status :: [Unit, IoError];

extern allocateBuffer :: UInt64 -> OwnedBuffer;
extern releaseBuffer :: Allocation -> Unit;
extern openReadOnly :: Symbol -> OpenResult;
extern readFile :: (File, Region) -> ReadResult;
extern closeFile :: File -> CloseResult;
extern writeBytes :: Bytes -> Unit;
extern writeSymbol :: Symbol -> Unit;
extern writeError :: IoError -> Unit;

// Arguments fields: 0 argument count, 1 first external descriptor address.
Arguments :: (UInt64, Ptr);

bufferSize :: UInt64 := 4096u64;

_completed :: Unit -> Status := ()[complete, failed] {
    complete();
};

copyContents :: (File, Buffer) -> Status := (file, buffer) {
    (memory, capacity, _) := buffer;
    result := file.readFile((memory, capacity));
    result[
    (length)[return] {
        when (length == 0u64) {
            return(_completed());
        };
        writeBytes((memory, length));
        return(file.copyContents((memory, capacity, length)));
    },
    (error)[complete, failed] { failed(error) }
    ];
};

finishCopy :: (Status, CloseResult) -> Status := (copied, closed) {
    copied[
    () {
        closed[
        ()[complete, failed] { complete() },
        (error)[complete, failed] { failed(error) }
        ];
    },
    (error)[complete, failed] { failed(error) }
    ];
};

copyPath :: Symbol -> Status := (path) {
    owned := allocateBuffer(bufferSize);
    (allocation, buffer) := owned;
    opened := openReadOnly(path);
    outcome := opened[
        (file) {
            copied := file.copyContents(buffer);
            closed := file.closeFile();
            finishCopy(copied, closed);
        },
        (error)[complete, failed] { failed(error) }
    ];
    allocation.releaseBuffer();
    outcome;
};

main :: Arguments -> Int32 := (argumentCount, arguments)[return] {
    when (argumentCount != 1u64) {
        writeSymbol("usage: mal-recoverable-file FILE\n");
        return(2);
    };

    path := Symbol.read(Ptr.load(arguments), UInt64.load(arguments + Ptr.size));
    result := copyPath(path);
    status :: Int32 := result[
        () { 0 },
        (error) {
            writeError(error);
            1;
        }
    ];
    return(status);
};
