require "./host.c";

// Tree is an external-storage capability; the host retains allocation authority.
Tree :: Address;

extern allocateNode :: ByteSize -> Tree;
extern releaseNode :: Tree -> Unit;

// Node bytes are Int32 value, UInt8 tag, then two Address fields for tag 1.
createLeaf :: Int32 -> Tree := (value) -> {
    node := allocateNode(#i32 + #u8);
    node@i32 <- value;
    (node + #i32)@u8 <- 0u8;
    node;
};

createBranch :: (Int32, Tree, Tree) -> Tree := (value, left, right) -> {
    childBytes := 2usize * #address;
    node := allocateNode(#i32 + #u8 + childBytes);
    node@i32 <- value;
    (node + #i32)@u8 <- 1u8;
    children := (node + #i32 + #u8)@address;
    next := children <- left;
    next <- right;
    node;
};

sumTree :: Tree -> Int32 := (node) -> [return] => {
    (value, _) := <-node@i32;
    (isBranch, _) := <-(node + #i32)@u8;
    when (isBranch == 0u8) {
        return(value);
    };

    children := (node + #i32 + #u8)@address;
    (left, next) := <-children;
    (right, _) := <-next;
    return(value + left.sumTree() + right.sumTree());
};

releaseTree :: Tree -> Unit := (node) -> [return] => {
    (isBranch, _) := <-(node + #i32)@u8;
    when (isBranch == 0u8) {
        return(node.releaseNode());
    };

    children := (node + #i32 + #u8)@address;
    (left, next) := <-children;
    (right, _) := <-next;
    left.releaseTree();
    right.releaseTree();
    return(node.releaseNode());
};

main :: Unit -> Int32 := () -> {
    left := createBranch(2, createLeaf(3), createLeaf(4));
    tree := createBranch(1, left, createLeaf(5));
    total := tree.sumTree();
    tree.releaseTree();
    total - 15;
};
