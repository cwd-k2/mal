// Every lexical category in the v0.5 profile appears in this fixture.
extern Handle;
extern write :: (Handle, Engram) -> Unit;
Pair :: (Int32, UInt8);
Choice :: [Int32, UInt8];

hexadecimal :: UInt32 := 0xff_ffu32;

binary :: UInt8 := 0b1010_0001u8;

fraction :: Float64 := 1_000.25e-2f64;

letter :: UInt8 := '\x41';

closingParen :: UInt8 := ')';

message :: Engram := "mal\n";

engramStorageSize :: UInt64 := @Engram;

inspect :: Engram -> UInt64 := \(value :: Engram) {
    #value + UInt64(value # 1u64);
};

choose :: Bool -> Choice := \(condition :: Bool) {
    if (condition && !false)
        then { Choice[0](42) }
        else { Choice[1](letter) };
};

select :: Choice -> Int32 := \(value :: Choice) {
    case (value)
        [0](integer) { integer }
        [1](byte) { Int32(byte) };
};
