// Every lexical category in the v0.5 profile appears in this fixture.
require "./support.mal";

extern Handle;
extern write :: (Handle, Symbol) -> Unit;
Pair :: (Int32, UInt8);
Choice :: [Int32, UInt8];

hexadecimal :: UInt32 := 0xff_ffu32;

_private :: _Private := value;

binary :: UInt8 := 0b1010_0001u8;

fraction :: Float64 := 1_000.25e-2f64;

letter :: UInt8 := '\x41';

closingParen :: UInt8 := ')';

message :: Symbol := "mal\n";

pointerStorageSize :: UInt64 := Ptr.size;

inspect :: Symbol -> UInt64 := (value) {
    #value + UInt64(value # 1u64);
};

choose :: Bool -> Choice := (condition)[integer, byte] {
    when (condition && !false) { integer(42) };
    byte(letter)
};

select :: Choice -> Int32 := (value) {
    value[
    (integer) { integer },
    (byte) { Int32(byte) }
    ];
};
