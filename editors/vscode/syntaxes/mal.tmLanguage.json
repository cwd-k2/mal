{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mal",
  "scopeName": "source.mal",
  "fileTypes": [
    "mal"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#symbols" },
    { "include": "#bytes" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#languageConstants" },
    { "include": "#types" },
    { "include": "#wildcard" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#values" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mal",
          "match": "//.*$"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "string.quoted.double.mal",
          "begin": "\"",
          "end": "\"|(?=\\r?$)",
          "patterns": [
            {
              "name": "constant.character.escape.mal",
              "match": "\\\\(?:[\\\\\"nrt0]|x[0-9A-Fa-f]{2})"
            }
          ]
        }
      ]
    },
    "bytes": {
      "patterns": [
        {
          "name": "string.quoted.single.mal",
          "contentName": "constant.character.mal",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.mal"
            }
          },
          "end": "'|(?=\\r?$)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.mal"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.mal",
              "match": "\\\\(?:[\\\\'nrt0]|x[0-9A-Fa-f]{2})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.mal",
          "match": "\\b[0-9](?:_?[0-9])*(?:(?:\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[eE][+-]?[0-9](?:_?[0-9])*)?(?:f(?:32|64))|\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[eE][+-]?[0-9](?:_?[0-9])*)\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.mal",
          "match": "\\b0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?:[iu](?:8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.integer.binary.mal",
          "match": "\\b0b[01](?:_?[01])*(?:[iu](?:8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.mal",
          "match": "\\b[0-9](?:_?[0-9])*(?:[iu](?:8|16|32|64))?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mal",
          "match": "\\b(?:if|then|else|case)\\b"
        },
        {
          "name": "keyword.other.extern.mal",
          "match": "\\bextern\\b"
        }
      ]
    },
    "languageConstants": {
      "patterns": [
        {
          "name": "constant.language.boolean.mal",
          "match": "\\b(?:false|true)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.mal",
          "match": "\\b[A-Z][A-Za-z0-9]*\\b"
        }
      ]
    },
    "wildcard": {
      "patterns": [
        {
          "name": "variable.language.wildcard.mal",
          "match": "(?<![A-Za-z0-9])_(?![A-Za-z0-9_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.mal",
          "match": "::|:=|->|<<|>>|<=|>=|==|!=|&&|\\|\\||[+\\-*/%<>&|^!~@#]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.mal",
          "match": "[,;]"
        },
        {
          "name": "punctuation.definition.mal",
          "match": "[(){}\\[\\]\\\\]"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "name": "variable.other.mal",
          "match": "\\b[a-z][A-Za-z0-9]*\\b"
        }
      ]
    }
  }
}
